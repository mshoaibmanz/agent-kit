#!/usr/bin/env python3
"""Execute a provider CLI with its own host/session namespace."""

from __future__ import annotations
import os
import sys


def environment(provider: str, original: dict[str, str]) -> dict[str, str]:
    if provider not in ("anthropic", "openai"):
        raise ValueError("Unknown provider")
    host = "claude" if provider == "anthropic" else "codex"
    env = dict(original)
    for key in list(env):
        if key in (
            "AGENT_SESSION_ID",
            "CLAUDE_CODE_SESSION_ID",
            "CODEX_THREAD_ID",
            "CLAUDECODE",
        ) or (host == "claude" and key.startswith("CODEX_")):
            env.pop(key)
    env.update(AGENT_HOST=host, AI_AGENT=host)
    return env


if __name__ == "__main__":
    provider, command, *args = sys.argv[1:]
    os.execvpe(command, [command, *args], environment(provider, dict(os.environ)))
