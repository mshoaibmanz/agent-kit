#!/usr/bin/env python3
"""PostToolUse(Edit|Write|MultiEdit): nudge when an edit adds code comments.

CLAUDE.md keeps comments to what clarifies something non-obvious. That rule is read once at
session start and drifts; this fires a non-blocking additionalContext nudge at the moment
comments are added. Skips proto/sandbox paths, session scratch files and the ci-watch agent.

Counts line comments (#, //, /* */, --) in full, and docstring lines only beyond
DOCSTRING_FREE_LINES per docstring. That allowance exists because a multi-line docstring
stating a domain rule IS the house idiom in some files (one domain package carries ~110 of
them), so counting every line of one fired on conforming code: 25 nudges in one
session, ~4 obeyed. A guard that is wrong on the surrounding style teaches the model to
ignore it, which is the same failure as not firing at all — the earlier systemMessage form
emitted 849 nudges in 30 days with zero behaviour change, and loudness was not the fix.
A docstring is a string that is the first statement of a module, class or def; any other
triple-quoted string (SQL, an SVG, a template) is data and never counts.
"""
from __future__ import annotations

import ast
import json
import os
import re
import sys

if os.environ.get("CI_WATCH_ACTIVE"):
    sys.exit(0)

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
try:
    from kit_env import kit_env, work_root
except ImportError as e:
    # hooks/lib/hook-io's policy for an advisory hook: tell the user it is off, never fall back.
    msg = (
        f"comment-guard is off: hooks/lib/kit_env.py, or a file it reads, is missing or broken "
        f"({e}). Restore it: git -C <your kit source checkout> checkout -- hooks/lib"
    )
    print(json.dumps({"systemMessage": msg}))
    sys.exit(0)

THRESHOLD = int(os.environ.get("COMMENT_NUDGE_MIN", "6"))
DOCSTRING_FREE_LINES = int(os.environ.get("COMMENT_NUDGE_DOCSTRING_FREE", "5"))

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

ti = data.get("tool_input") or {}
fp = ti.get("file_path") or ""
if not fp or re.search(r"/(sandbox|prototypes)/", fp) or re.search(r"\.proto\.[tj]sx?$", fp):
    sys.exit(0)


def in_prototype_dir(path: str) -> bool:
    """The overlay's PROTOTYPE_DIRS; a bad pattern adds none."""
    extra = kit_env()["PROTOTYPE_DIRS"]
    try:
        return bool(extra) and re.search(rf"/({extra})/", path) is not None
    except re.error:
        return False


if in_prototype_dir(fp):
    sys.exit(0)


def is_scratch(path: str) -> bool:
    """Session scratchpads, $TMPDIR and task folders hold throwaway or helper scripts, not reviewed
    code. A task folder's worktrees/ are real checkouts, so they stay in scope."""
    if re.match(r"(/private)?/tmp/claude-[^/]+/", path):
        return True
    root = os.path.realpath(work_root())
    real = os.path.realpath(path)
    if real.startswith(root + "/") and "/worktrees/" not in real[len(root):]:
        return True
    tmp = os.environ.get("TMPDIR", "").rstrip("/")
    if not tmp:
        return False
    return any(p.startswith(t + "/") for p in (path, os.path.realpath(path)) for t in (tmp, os.path.realpath(tmp)))


if is_scratch(fp):
    sys.exit(0)

# Code only: config, shell and hook files carry comments by convention and fired this on every
# edit to ~/.claude/hooks. `# noqa` / `# type:` / `# pragma` directives are not prose comments.
LINE = {
    ".py": ["#"], ".pyi": ["#"], ".rb": ["#"],
    ".ts": ["//"], ".tsx": ["//"], ".js": ["//"], ".jsx": ["//"], ".mjs": ["//"], ".cjs": ["//"],
    ".go": ["//"], ".rs": ["//"], ".java": ["//"], ".kt": ["//"], ".scala": ["//"], ".c": ["//"], ".cc": ["//"],
    ".cpp": ["//"], ".h": ["//"], ".hpp": ["//"], ".cs": ["//"], ".php": ["//", "#"], ".swift": ["//"],
    ".m": ["//"], ".mm": ["//"], ".sql": ["--"],
}
ext = os.path.splitext(fp)[1].lower()
if ext not in LINE:
    sys.exit(0)
markers = LINE[ext]
c_block = ext not in (".py", ".pyi", ".sh", ".rb", ".yaml", ".yml", ".toml", ".sql")

TRIPLE = re.compile(r'("""|\'\'\')(.*?)\1', re.S)
# The line a docstring follows: a def/class header, or the `):` closing a wrapped signature.
HEADER = re.compile(r"^\s*(((async\s+)?def|class)\b.*|\).*):\s*(#.*)?$")


def count_comments(text: str | None) -> int:
    n = 0
    in_block = False
    for raw in (text or "").splitlines():
        s = raw.strip()
        if not s:
            continue
        if in_block:
            n += 1
            if "*/" in s:
                in_block = False
            continue
        if c_block and s.startswith("/*"):
            n += 1
            if "*/" not in s:
                in_block = True
            continue
        if any(s.startswith(m) for m in markers) and not re.match(r"#\s*(noqa|type:|pragma|!)", s):
            n += 1
    return n


def docstring_line_counts(text: str) -> list[int]:
    """Newlines inside each docstring; an unparseable fragment falls back to the header rule."""
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return fragment_docstring_line_counts(text)
    counts = []
    for node in ast.walk(tree):
        if not isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)) or not node.body:
            continue
        first = node.body[0]
        if isinstance(first, ast.Expr) and isinstance(first.value, ast.Constant) and isinstance(first.value.value, str):
            counts.append(first.end_lineno - first.lineno)
    return counts


def fragment_docstring_line_counts(text: str) -> list[int]:
    """An Edit fragment rarely parses, so count a string that opens its line right after a header."""
    counts = []
    for m in TRIPLE.finditer(text):
        line_start = text.rfind("\n", 0, m.start()) + 1
        if not re.fullmatch(r"\s*[rRuU]?", text[line_start:m.start()]):
            continue
        before = text[:line_start].rstrip().splitlines()
        if before and HEADER.match(before[-1]):
            counts.append(m.group(2).count("\n"))
    return counts


def count_docstring_lines(text: str | None) -> int:
    if ext not in (".py", ".pyi") or not text:
        return 0
    return sum(max(0, n - DOCSTRING_FREE_LINES) for n in docstring_line_counts(text))


def count(text: str | None) -> int:
    return count_comments(text) + count_docstring_lines(text)


if "content" in ti:
    added = count(ti.get("content"))
elif "edits" in ti:
    added = sum(max(0, count(e.get("new_string")) - count(e.get("old_string"))) for e in ti["edits"])
else:
    added = max(0, count(ti.get("new_string")) - count(ti.get("old_string")))

if added >= THRESHOLD:
    # additionalContext reaches the MODEL; {"systemMessage"} is shown to the user only. The old
    # form fired 300+ times in 30 days and the model never saw one.
    msg = (
        f"You added {added} comment lines to {os.path.basename(fp)} (line comments, plus docstring lines "
        f"past the first {DOCSTRING_FREE_LINES + 1} of each docstring; this fires at {THRESHOLD}). CLAUDE.md: "
        f"a comment only where it clarifies something non-obvious; never restate the code, narrate the change, "
        f"or label a section. Delete the rest before continuing."
    )
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": msg}}))
sys.exit(0)
