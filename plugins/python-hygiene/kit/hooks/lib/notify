# macOS banner notifications for hooks and ci-watch. Sourced; defines functions only.

# notify <title> <body> [sound]: show a banner; a no-op without osascript. Never fails.
notify() {
  local sound=''
  command -v osascript >/dev/null 2>&1 || return 0
  [ -n "${3:-}" ] && sound=" sound name \"$3\""
  osascript -e "display notification \"$(_notify_esc "$2")\" with title \"$(_notify_esc "$1")\"$sound" \
    >/dev/null 2>&1
  return 0
}

# _notify_esc <text>: one line, at most 180 characters, escaped for an AppleScript string.
# Truncated BEFORE escaping, or the cut can land mid-escape-sequence. Without a UTF-8 locale
# `cut -c` counts bytes and can split a multibyte character, and osascript then decodes the whole
# string as MacRoman; iconv drops the partial tail.
_notify_esc() {
  printf '%s' "$1" | tr '\n' ' ' | cut -c1-180 | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}
