#!/usr/bin/env python3
"""Run a kit hook on a native host payload, translating decisions once."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from host import EVENTS, cursor_output, detect_host, normalize

_failure_event = ""


def main() -> int:
    global _failure_event
    host, name = sys.argv[1:3]
    payload = json.load(sys.stdin)
    _failure_event = EVENTS.get(payload.get("hook_event_name"), payload.get("hook_event_name", ""))
    target = Path(__file__).resolve().parent / name
    if target.parent != Path(__file__).resolve().parent or not target.is_file():
        raise ValueError("invalid kit hook name")
    if not payload:
        sys.stdout.write("{}\n")
        return 0
    detected = detect_host(payload)
    if detected != "claude" and detected != host:
        raise ValueError("hook payload does not match the registered host")
    event = ""
    outputs = []
    items = normalize(payload, host)
    if name in ("edit-guard", "review-mark-changes", "tests-ran-mark") and all(
        item["tool_input"].get("file_path") for item in items
    ):
        batch = dict(items[0])
        batch["tool_input"] = {
            **items[0]["tool_input"],
            "file_paths": list(dict.fromkeys(item["tool_input"]["file_path"] for item in items)),
        }
        items = [batch]
    for item in items:
        event = item["hook_event_name"]
        env = dict(
            os.environ,
            AGENT_HOST=host,
            AI_AGENT=host,
            CLAUDE_PROJECT_DIR=item["cwd"],
            AGENT_SESSION_ID=item["session_id"],
        )
        env.setdefault('KIT_ENV', str(Path(__file__).resolve().parent.parent / 'local/setup-paths.env'))
        proc = subprocess.run(
            [str(target)],
            input=json.dumps(item),
            text=True,
            capture_output=True,
            env=env,
            timeout=60,
        )
        if proc.returncode:
            raise RuntimeError(f"{name} could not check the event")
        if proc.stdout.strip():
            decoder = json.JSONDecoder()
            rest = proc.stdout.lstrip()
            while rest:
                output, end = decoder.raw_decode(rest)
                outputs.append(output)
                rest = rest[end:].lstrip()
    out = next(
        (
            o
            for o in outputs
            if (o.get("hookSpecificOutput") or {}).get("permissionDecision") in ("deny", "ask")
            or o.get("decision") == "block"
        ),
        outputs[-1] if outputs else {},
    )
    if host == "cursor":
        out = cursor_output(out, event)
        if event == "SessionStart" and os.environ.get("AGENT_GIT_HOOKS") != "off":
            kit = Path(__file__).resolve().parent.parent
            out["env"] = {
                "AGENT_SESSION_ID": items[0]["session_id"],
                "AI_AGENT": host,
                "AGENT_HOST": host,
                "GIT_CONFIG_COUNT": "1",
                "GIT_CONFIG_KEY_0": "core.hooksPath",
                "GIT_CONFIG_VALUE_0": str(kit / "git-hooks"),
            }
    elif (out.get("hookSpecificOutput") or {}).get("permissionDecision") == "ask":
        # Codex currently treats an unsupported ask as a failed hook and continues the tool call.
        out["hookSpecificOutput"]["permissionDecision"] = "deny"
    sys.stdout.write(json.dumps(out) + "\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, TypeError, OSError, RuntimeError, subprocess.TimeoutExpired):
        sys.stderr.write(
            "The kit hook adapter could not check this event. Restore its source and retry.\n"
        )
        sys.exit(1 if _failure_event in set(EVENTS.values()) - {"PreToolUse"} else 2)
