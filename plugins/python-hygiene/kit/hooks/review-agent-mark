#!/bin/bash
# Records a review round as COMPLETE when its agent RETURNS, via lib/review-state rv_complete.
#   PostToolUse(Agent)     a review type's spawn records agent_id -> subagent_type in the session's
#                          review state (SubagentStop payloads have carried agent_type "" since about
#                          2026-09-29). A FOREGROUND review agent's tool result already holds its
#                          report, so the round completes here. Any other agent (a fix worker)
#                          whose report holds a TALLY line settles the tally review-trigger owes.
#   SubagentStop           fires when any subagent returns, foreground or background. The type comes
#                          from the payload, else the agent map above, else the transcript's
#                          .meta.json. The report is the transcript's last SubagentHandback message
#                          when there is one (agents end with that tool call, and last_assistant_message
#                          is then empty or an interim line), else last_assistant_message. An agent
#                          with neither was interrupted and completes nothing. A non-review agent's
#                          report with a TALLY line settles the tally owed, as above.
# Completion, not spawn: a background review has reviewed nothing yet. Each agent completes once
# (done.<agent_id>), since a foreground agent fires both events.
# REVIEW_DEBUG=1 appends every payload to <kit>/state/review-debug.log.
. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0
hook_lib open review-state
hook_input
if [ "${REVIEW_DEBUG:-}" = 1 ]; then
  _dbg="${AGENT_STATE_DIR:-${AGENT_KIT_DIR:-${0%/*}/..}/state}"
  mkdir -p "$_dbg" 2>/dev/null && printf '%s %s\n' "$(date -u +%FT%TZ)" "$HOOK_INPUT" >> "$_dbg/review-debug.log" 2>/dev/null
fi
hook_read event='.hook_event_name // ""' sid='.session_id // ""' cwd='.cwd // ""' \
  at='.agent_type // ""' msg='.last_assistant_message // ""' tool_type='.tool_input.subagent_type // ""' \
  aid='.agent_id // .tool_response.agentId // ""' status='.tool_response.status // ""' \
  tpath='.agent_transcript_path // ""' \
  result='(.tool_response.content // "") | if type == "array" then map(.text? // "") | join("\n") elif type == "string" then . else "" end'
[ -n "$sid" ] || exit 0

case "$event" in
  PostToolUse)
    if ! rv_review_agent "$tool_type"; then
      [ "$status" != completed ] || ! rv_tally_in "$result" || rv_tally_settle "$sid"
      exit 0
    fi
    [ -z "$aid" ] || rv_agent_note "$sid" "$aid" "$tool_type"
    # async_launched: a background agent; its SubagentStop completes the round.
    [ "$status" = completed ] && [ -n "$result" ] || exit 0
    at=$tool_type; msg=$result ;;
  SubagentStop)
    [ -n "$at" ] || [ -z "$aid" ] || at=$(rv_agent_type "$sid" "$aid")
    if [ -z "$at" ] && [ -n "$tpath" ]; then
      at=$(jq -r '.agentType // ""' "${tpath%.jsonl}.meta.json" 2>/dev/null)
    fi
    if [ -n "$tpath" ] && [ -r "$tpath" ]; then
      hb=$(grep '"SubagentHandback"' "$tpath" 2>/dev/null | tail -1 | jq -r '[.message.content[]? | select(.type == "tool_use" and .name == "SubagentHandback") | .input.message // ""] | last // ""' 2>/dev/null)
      [ -z "$hb" ] || msg=$hb
    fi
    if ! rv_review_agent "$at"; then
      ! rv_tally_in "$msg" || rv_tally_settle "$sid"
      exit 0
    fi
    [ -n "$msg" ] || exit 0 ;;
  *) exit 0 ;;
esac
[ -z "$aid" ] || ! rv_agent_done "$sid" "$aid" || exit 0
root=$(git -C "${cwd:-.}" rev-parse --show-toplevel 2>/dev/null) || root=''
rv_complete "$sid" "$root" "$at" "$msg" "$aid"
exit 0
