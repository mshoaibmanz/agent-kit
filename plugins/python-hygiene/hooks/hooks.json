            "command": "env AGENT_KIT_DIR=\"${CLAUDE_PLUGIN_ROOT}/kit\" \"${CLAUDE_PLUGIN_ROOT}/kit/hooks/python-format\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
