#!/usr/bin/env bash
# PreToolUse(Bash) gate for test execution in a repo whose tests run through one wrapper: the
# overlay's TEST_RUNNER, in a repo with TEST_GATE_FILE at its git root (hooks/lib/hook-io kit_env).
# Enforces three things prose rules can't guarantee:
#   1. Tests run in the FOREGROUND (never run_in_background) — the cause of the
#      10–20 min idle stalls.
#   2. Tests go through the runner, not bare `pytest` (missing the wrapper's env exports, DB
#      namespace and timeouts) or a TEST_REFUSED_CMDS form.
#   3. No run without an intervening source edit. Every invocation pays the same fixture floor
#      (~27s where it was measured: 11s lib imports + 16s DDL/seed) whether it runs one test or a
#      hundred, and opt-in app fixtures were built and rejected. So the ONLY lever on test
#      wall-clock is fewer invocations. Transcript audit 2026-09-05, 769 runs over 31 days: 58% of
#      them followed no edit at all — separate invocations per file, re-runs to re-read output,
#      retries after a too-broad run timed out. Batch the paths and the -k names into ONE call.
#      A run's scope is its paths (node ids included) plus its -k expression; only a scope the
#      runs since the last edit already covered is refused.
# Silent no-op without TEST_GATE_FILE and TEST_RUNNER, or in a repo without that file. Run
# detection, scope and the edit/run markers live in lib/test-run, shared with tests-ran-mark,
# which records each run after it finishes.
# `set -e` kills the hook on any failing assignment, which is a silent UI error row AND an
# ungated command: every `$(… grep …)` below that may match nothing needs `|| true`.
. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0
set -euo pipefail
kit_env
[ -n "${TEST_GATE_FILE:-}" ] && [ -n "${TEST_RUNNER:-}" ] || exit 0
hook_lib open cmd-view state test-run
runner_re=${TEST_RUNNER_RE:-$TEST_RUNNER}
# Every runner below is named in the raw payload; anything else exits before jq.
hook_input
named() { case $HOOK_INPUT in *"${1%% *}"*) return 0 ;; esac; return 1; }
case "$HOOK_INPUT" in
  *pytest*) ;;
  *) [[ $HOOK_INPUT =~ $runner_re ]] || tr_refused_each named || exit 0 ;;
esac
hook_read cmd='.tool_input.command // ""' bg='.tool_input.run_in_background // false' \
  cwd='.cwd // ""' sid='.session_id // "nosession"' aid='.agent_id // ""'
[ -n "$cmd" ] || exit 0
[ -n "$cwd" ] || cwd=$PWD

cmd_view "$cmd"
cmd_tokens || true
# A refused prefix counts only with its first word in command position.
invoked() { local re="(^|[;&|[:space:]])${1// /[[:space:]]+}([[:space:]]|\$)"; cmd_invokes "${1%% *}" && [[ $CMD_BARE =~ $re ]]; }
is_test=0
tr_invoked && is_test=1
tr_refused_each invoked && is_test=1
[ "$is_test" = 1 ] || exit 0

top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$top" ] && [ -f "$top/$TEST_GATE_FILE" ] || exit 0

# The repo's testing doc, when there is one (CLAUDE.md: ~/.claude/local/<repo>-testing.md).
doc=''
repo=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
repo=$(basename "$(dirname "${repo:-/.}")")
[ -f "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/local/$repo-testing.md" ] && doc=" See ~/.claude/local/$repo-testing.md."
note=${TEST_NOTE:+ $TEST_NOTE}

# 1. No backgrounded test runs — must be foreground with fast feedback. A run whose stdout is
#    redirected to a log file is the one legitimate background shape (a cold-namespace run can
#    exceed the 600s Bash cap); the log is then read, not the stream.
if [ "$bg" = "true" ] && ! printf '%s' "$CMD_BARE" | grep -Eq '>[[:space:]]*[^[:space:]&|;]+'; then
  deny "Do not run tests with run_in_background. Run them in the FOREGROUND so feedback is immediate (≤1 min). Scope tightly with a path and/or -k plus -x. If the run genuinely needs >600s, redirect stdout to a log in the scratchpad dir named in your system prompt — a redirected run may be backgrounded.$doc"
fi

# 2. Everywhere in this repo: a refused form or bare pytest is wrong — require the runner.
if ! cmd_invokes "$runner_re"; then
  refused=$(tr_refused_md)
  deny "Tests in this repo run via \`$TEST_RUNNER <path> -k <name> -x\`. Bare \`pytest\`${refused:+ and $refused} are refused here: they skip the runner's env exports, DB namespace and timeouts.$note$doc"
fi

# 3. No-op re-run: this agent already ran tests and nothing was edited since (see tr_state). A
#    run over a path or -k the runs since the last edit did not cover is a NEW question: of 91
#    denials in 30 days most named different files or -k than the run before, and a paths-only
#    key sent 58% of denials out through `# rerun`. Only a covered scope is the no-op refused here.
#    `# rerun` is the escape for a previous run with no verdict (timed out, infra error, wrong
#    branch), NOT for seeing output again: redirect to a log file and re-read it, which is free.
#    The scope is recorded by tests-ran-mark AFTER the run: recording it here also counted runs
#    a later hook or the user refused, and the retry was then denied as a re-run.
tr_state "$sid" "$aid" "$top"
if [ "$TR_STATE" = clean ] && ! cmd_flag rerun && tr_covered "$(tr_scope "$cmd")"; then
  deny "You already ran tests over these same paths and -k in this worktree and have not edited a source file since. Every invocation pays the same fixture floor regardless of scope, so a second call buys nothing a batched first call would not have.
 - Testing more files? Put them in ONE invocation: \`$TEST_RUNNER a.py b.py c.py -k \"x or y\"\`. pytest takes many paths.
 - Want to see more of the output? Do not re-run — redirect next time (\`$TEST_RUNNER … > <scratchpad>/t.log 2>&1\`, scratchpad dir is in your system prompt) and read the file.
 - Previous run gave no verdict (timed out / infra error / wrong branch)? Re-issue with a narrower scope AND append \`# rerun\`.$doc"
fi
exit 0
