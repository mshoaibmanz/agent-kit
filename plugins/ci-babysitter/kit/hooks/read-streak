#!/usr/bin/env bash
# Read-streak nudge: after 8 consecutive read-only tool calls with no edit, point the MAIN session
# at the `researcher` agent once per streak.
#
#   PostToolUse (Read|Grep|Glob|LSP|Bash|Edit|Write|MultiEdit|NotebookEdit|Agent)
#       Read, Grep, Glob, LSP and a Bash command that only reads add 1. An edit, a Bash command that
#       may write (or that this hook does not recognise as a read), or an Agent call resets the
#       streak. The 8th read injects one additionalContext; the rest of the streak is silent.
#   UserPromptSubmit
#       a new prompt starts a new streak.
#   Main session only: a payload with agent_id is a subagent's and is skipped.
#
# WHY. Inline exploration in the main session is paid for on every later call (the session re-reads
# its whole context each time); a researcher run on Sonnet returns a 300-word answer instead. The nudge
# goes through additionalContext because a systemMessage never reaches the model (claude-kit-rules).
#
# BASH CLASSIFICATION. A positive list: every command-position word (lib/cmd-view cmd_tokens) must be a
# known reader, the command must carry no write redirect, and git must not name a mutating
# subcommand. Anything else counts as an action and resets the streak, so a mistake here costs a
# missed nudge, never a false one.
#
# COST. Runs on every read/edit/Bash call of every session: builtins and bash regexes on the common
# path; jq and awk only for a Bash command. Never exits non-zero.
[ -n "${CI_WATCH_ACTIVE:-}" ] && exit 0
. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0

LIMIT=8
S="${CLAUDE_STATE_DIR:-$HOME/.claude/state}/read-streak"

hook_input
p=$HOOK_INPUT
re='"agent_id"[[:space:]]*:[[:space:]]*"[^"]'
[[ $p =~ $re ]] && exit 0
# A top-level key is unescaped; the same text inside a string value is \"-escaped and cannot match.
field() {
  local re="\"$2\"[[:space:]]*:[[:space:]]*\"([^\"]*)\""
  printf -v "$1" '%s' ''
  [[ $p =~ $re ]] && printf -v "$1" '%s' "${BASH_REMATCH[1]}"
  return 0
}
field event hook_event_name
field sid session_id
[ -n "$sid" ] || exit 0
case $sid in *[!A-Za-z0-9._-]*) exit 0 ;; esac
f="$S/$sid"

case $event in
  UserPromptSubmit) rm -f "$f.reads" "$f.fired" "$f" 2>/dev/null; exit 0 ;;
  PostToolUse) ;;
  *) exit 0 ;;
esac
field tool tool_name

# bash_reads: the Bash command in HOOK_INPUT only reads.
bash_reads() {
  local cmd t rest
  hook_lib open cmd-view || return 1
  hook_read cmd='.tool_input.command // ""'
  [ -n "$cmd" ] || return 1
  cmd_view "$cmd"
  # Redirects to a file write; fd duplication and /dev/null do not.
  rest=$CMD_BARE
  rest=${rest//2>&1/}; rest=${rest//>&2/}; rest=${rest//&>\/dev\/null/}; rest=${rest//>\/dev\/null/}
  case $rest in *'>'*) return 1 ;; esac
  case $CMD_BARE in
    *'sed -i'*|*'sed --in-place'*|*'-delete'*|*'-exec'*|*'--output'*) return 1 ;;
  esac
  cmd_tokens || return 1
  [ -n "$CMD_TOKENS" ] || return 1
  while IFS= read -r t; do
    case $t in
      ls|cat|head|tail|grep|egrep|fgrep|rg|find|sed|awk|wc|sort|uniq|cut|tr|jq|stat|file|du|df|tree|pwd|echo|printf|which|type|basename|dirname|realpath|readlink|diff|cmp|column|date|nl|rev|xxd|od|strings|md5|shasum|true|false|cd|test|'['|'[['|lsof|ps|uname|whoami|id|hostname|env|printenv|command|ro-mysql|bqro) ;;
      git) [[ $CMD_BARE =~ git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+(add|commit|push|pull|fetch|checkout|switch|merge|rebase|reset|stash|apply|am|cherry-pick|revert|rm|mv|restore|clean|tag|branch|worktree|submodule|config|init|clone|bisect|gc|update-ref) ]] && return 1 ;;
      *) return 1 ;;
    esac
  done <<<"$CMD_TOKENS"
  return 0
}

kind=
case $tool in
  Read|Grep|Glob|LSP) kind=read ;;
  Bash) bash_reads && kind=read || kind=reset ;;
  Edit|Write|MultiEdit|NotebookEdit|Agent) kind=reset ;;
  *) exit 0 ;;
esac

if [ "$kind" = reset ]; then
  [ -e "$f.reads" ] && rm -f "$f.reads" "$f.fired" 2>/dev/null
  exit 0
fi

# A read. Parallel tool calls run this hook concurrently for one session, so there is no
# read-modify-write: each read appends one byte (O_APPEND, so none is lost) and the count is the
# file's length; the nudge goes out from the one call that creates the .fired marker (noclobber
# opens it O_EXCL). The last of 8 parallel reads always sees 8.
if [ ! -d "$S" ]; then
  mkdir -p "$S" 2>/dev/null || exit 0
  find "$S" -maxdepth 1 -type f -mtime +2 -delete 2>/dev/null
fi
printf . >>"$f.reads" 2>/dev/null || exit 0
s=
IFS= read -r s <"$f.reads" 2>/dev/null
n=${#s}
[ "$n" -ge "$LIMIT" ] || exit 0
set -C
{ : >"$f.fired"; } 2>/dev/null || exit 0
hook_lib open || exit 0
add_context PostToolUse "$n read-only calls in a row with no edit. If the next step is more searching, reading across files, browsing or web research, hand it to $(host_noun delegate) with the one question to answer and the paths to start from: it returns at most 300 words with file:line evidence and keeps this context small. Ignore this if you are about to act on what you have."
exit 0
