# Sourceable (bash 3.2): the DB tunnel registry, derived exactly as ro-mysql derives it.
#   db_tunnels [ssh_config]  "alias port kind" per LocalForward under a literal Host db-tunnel-*
#   db_kind <name>           STAGING when a name segment starts with staging/stg, else PROD
#   db_auth_failed           ro-mysql's last rejected login ("<db user> <tunnel> <time>"), if any
# ~/.ssh/config is the only source; `ro-mysql --tunnels` adds users, state and databases.
# The STAGING pattern must stay identical to STAGING_RE in ~/.local/bin/ro-mysql
# (hooks/tests/ro-mysql.test.py compares the two). macOS awk is BWK: keep it plain.

DB_AUTH_FAILED_FILE="$HOME/.claude/state/db-auth-failed"

db_kind() {
  printf '%s\n' "$1" | awk '{ print (tolower($0) ~ /(^|[^a-z])(staging|stg)/) ? "STAGING" : "PROD" }'
}

db_tunnels() {
  local cfg="${1:-$HOME/.ssh/config}"
  [ -r "$cfg" ] || return 0
  awk '
    function flush(  i, j) {
      for (i = 1; i <= na; i++)
        for (j = 1; j <= np; j++)
          print alias[i], port[j], (tolower(alias[i]) ~ /(^|[^a-z])(staging|stg)/) ? "STAGING" : "PROD"
      na = 0; np = 0
    }
    { sub(/^[ \t]+/, "") }
    !/^[A-Za-z]/ { next }
    {
      key = $0; sub(/[ \t=].*/, "", key); key = tolower(key)
      rest = $0; sub(/^[A-Za-z]+[ \t]*=?[ \t]*/, "", rest)
      n = split(rest, arg, /[ \t]+/)
    }
    key == "host" || key == "match" {
      flush()
      if (key == "host")
        for (i = 1; i <= n; i++)
          if (arg[i] ~ /^db-tunnel-/ && arg[i] !~ /[*?!]/) alias[++na] = arg[i]
      next
    }
    key == "localforward" && na > 0 && n > 0 {
      p = arg[1]; sub(/.*:/, "", p)
      if (p ~ /^[0-9]+$/) port[++np] = p
    }
    END { flush() }
  ' "$cfg"
}

db_auth_failed() {
  if [ -s "$DB_AUTH_FAILED_FILE" ]; then head -1 "$DB_AUTH_FAILED_FILE"; fi
}
