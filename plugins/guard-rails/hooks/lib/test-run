# Test-run detection and the markers test-exec-gate (PreToolUse), tests-ran-mark (PostToolUse) and
# pre-push-gate share. Sourced after hook-io (kit_env), cmd-view (CMD_BARE, cmd_invokes) and state
# (path_key). The repo's own runner comes from the overlay: TEST_RUNNER_RE, else TEST_RUNNER.
#
# Markers in TR_DIR, swept by tests-ran-mark after ~48h (BSD `find -mtime +1` truncates the day
# count, so it is two days, not one):
#   <sid>, wt-<key>          a test run finished in this session / worktree (pre-push-gate)
#   edit-<sid>, edit-wt-<key> a source file changed
#   lastrun-<rk>[.scope]     the agent's last run, and the scope the runs since the last edit covered
TR_DIR="$HOME/.claude/tmp/claude-tests"
# Past this window the model has moved on and a fresh verdict is the point; without it a long
# session could never re-run an untouched file.
TR_STALE_MIN=${TEST_RERUN_STALE_MIN:-45}

# tr_invoked: CMD_BARE runs pytest or the overlay's runner in command position (`cat ~/bin/<runner>`
# and `which pytest` are not runs), or pytest behind a launcher, which makes it an argument.
tr_invoked() {
  local launcher='(^|[;&|[:space:]])((uv|poetry|pdm|hatch|pipenv)[[:space:]]+run|python[0-9.]*[[:space:]]+-m)[[:space:]]+([^[:space:]]*/)?pytest([[:space:]]|$)'
  kit_env
  local runner=${TEST_RUNNER_RE:-${TEST_RUNNER:-}}
  cmd_invokes "pytest${runner:+|$runner}" && return 0
  [[ $CMD_BARE =~ $launcher ]]
}

# tr_refused_each <fn>: call <fn> <prefix> for each TEST_REFUSED_CMDS entry ("dev t|dev test"),
# returning 0 at the first call that does. No fork: the gate's pre-filter runs on every Bash call.
tr_refused_each() {
  local rest=${TEST_REFUSED_CMDS:-} c
  while [ -n "$rest" ]; do
    c=${rest%%|*}
    case $rest in *'|'*) rest=${rest#*|} ;; *) rest='' ;; esac
    [ -n "$c" ] && "$1" "$c" && return 0
  done
  return 1
}

# tr_refused_md: the refused prefixes as "`a`, `b`" for a message; empty when none are set.
tr_refused_md() {
  TR_REFUSED_MD=''
  _tr_md() { TR_REFUSED_MD="${TR_REFUSED_MD:+$TR_REFUSED_MD, }\`$1\`"; return 1; }
  tr_refused_each _tr_md || true
  printf '%s' "$TR_REFUSED_MD"
}

# tr_scope <raw cmd>: the run's scope, one "<path>\t<-k expr>" line per path named (node ids
# included), path empty when none is. -k is read from the raw command: CMD_BARE masks a quoted
# expression.
tr_scope() {
  local k paths
  k=$(printf '%s\n' "$1" | sed -nE "s/.*[[:space:]]-k[[:space:]=]*('[^']*'|\"[^\"]*\"|[^[:space:]'\"]+).*/\1/p" | tail -1 | tr -d "'\"" || true)
  paths=$(printf '%s' "$CMD_BARE" | tr ' ' '\n' | grep -E '^[^-][^[:space:]]*(\.py(::[^[:space:]]*)?|/)$|^tests?/' | sort -u || true)
  printf '%s\n' "$paths" | while IFS= read -r p; do printf '%s\t%s\n' "$p" "$k"; done
}

# tr_state <sid> <agent_id> <root>: set TR_LASTRUN and TR_STATE, which is one of
#   none    no run recorded for this agent
#   stale   its last run is older than TR_STALE_MIN
#   edited  a source edit in this session or worktree is newer than that run
#   clean   none of these: a run over a scope already covered tells us nothing new
# Keyed per AGENT: a subagent's payload carries the parent's session_id, so agent_id is added when
# present. A worktree-wide lock refused the first run of every new session on unchanged code and
# let one agent lock out another; an edit from anywhere still unlocks, because a subagent fixing
# the code should free the parent's next run.
tr_state() {
  local rk=$1 e
  [ -n "$2" ] && rk="$1-$2"
  TR_LASTRUN="$TR_DIR/lastrun-$rk"
  TR_STATE=none
  [ -f "$TR_LASTRUN" ] || return 0
  TR_STATE=stale
  [ -z "$(find "$TR_DIR" -name "lastrun-$rk" -mmin "+$TR_STALE_MIN" 2>/dev/null)" ] || return 0
  TR_STATE=edited
  [ -f "$TR_DIR/edit-$1" ] && [ "$TR_DIR/edit-$1" -nt "$TR_LASTRUN" ] && return 0
  if [ -n "$3" ]; then
    e="$TR_DIR/edit-wt-$(path_key "$3")"
    [ -f "$e" ] && [ "$e" -nt "$TR_LASTRUN" ] && return 0
  fi
  TR_STATE=clean
}

# tr_covered <scope>: every line of <scope> is already in TR_LASTRUN's scope, either verbatim or as
# that path run with no -k.
tr_covered() {
  local prev s tab=$'\t'
  prev=$(cat "$TR_LASTRUN.scope" 2>/dev/null || true)
  while IFS= read -r s; do
    printf '%s\n' "$prev" | grep -qxF -- "$s" && continue
    printf '%s\n' "$prev" | grep -qxF -- "${s%%"$tab"*}$tab" && continue
    return 1
  done <<EOF
$1
EOF
  return 0
}

# tr_record <scope>: after a run, reset TR_LASTRUN's scope when TR_STATE is not clean, else add to
# it; then touch TR_LASTRUN. Touched AFTER the run, so a run and the edit that motivated it never tie.
tr_record() {
  if [ "$TR_STATE" = clean ]; then
    { cat "$TR_LASTRUN.scope" 2>/dev/null; printf '%s\n' "$1"; } | sort -u > "$TR_LASTRUN.scope.tmp" \
      && mv "$TR_LASTRUN.scope.tmp" "$TR_LASTRUN.scope"
  else
    printf '%s\n' "$1" > "$TR_LASTRUN.scope"
  fi
  touch "$TR_LASTRUN"
}

# tr_mark <run|edit> <sid> <root>: record a finished run or a source edit for the session and, when
# <root> is set, the worktree.
tr_mark() {
  local p=''
  [ "$1" = edit ] && p=edit-
  mkdir -p "$TR_DIR"
  touch "$TR_DIR/$p$2"
  [ -n "$3" ] && touch "$TR_DIR/${p}wt-$(path_key "$3")"
  return 0
}

# tr_ran <sid> <root>: a run is recorded for this session, or anywhere in this worktree (so a
# delegated agent's run counts).
tr_ran() {
  [ -f "$TR_DIR/$1" ] && return 0
  [ -n "$2" ] && [ -f "$TR_DIR/wt-$(path_key "$2")" ]
}
