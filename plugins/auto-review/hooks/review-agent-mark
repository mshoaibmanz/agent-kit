#!/bin/bash
# Records a review round as COMPLETE when its agent RETURNS, via lib/review-state rv_complete.
#   SubagentStop           agent_type + last_assistant_message: fires when any subagent returns,
#                          foreground or background. An interrupted agent has no final message
#                          and completes nothing.
#   PostToolUse(Agent)     spawning a critic settles the critic review-trigger owes; a background
#                          critic has not returned yet, and waiting for it would re-block the Stop.
# Completion, not spawn: a background review, or a reviewer spawned for unrelated work, has
# reviewed nothing, so only a round the hooks issued completes.
. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0
hook_lib open review-state
hook_read event='.hook_event_name // ""' sid='.session_id // ""' cwd='.cwd // ""' \
  at='.agent_type // ""' msg='.last_assistant_message // ""' tool_type='.tool_input.subagent_type // ""'
[ -n "$sid" ] || exit 0

case "$event" in
  PostToolUse)
    case $tool_type in critic|auto-review:critic) rv_critic_settle "$sid" ;; esac
    exit 0 ;;
  SubagentStop) ;;
  *) exit 0 ;;
esac
[ -n "$msg" ] || exit 0
rv_review_agent "$at" || exit 0
root=$(git -C "${cwd:-.}" rev-parse --show-toplevel 2>/dev/null) || exit 0
rv_complete "$sid" "$root" "$at" "$msg"
exit 0
