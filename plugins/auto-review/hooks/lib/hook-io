# Sourced by every bash hook: read the payload, emit a decision, apply the missing-dependency
# policy. Defines functions only. Hooks source it as "${0%/*}/lib/hook-io", so a hooks copy under
# test uses its own libs.
#
# Missing-dependency policy (hook_lib): a CLOSED hook guards prod data or a push, and refuses the
# call with a model-visible reason; an OPEN hook (advisory or a marker) tells the user and exits 0.
# A silent exit 0 reads as a working guard, which is how a missing lib stayed unnoticed.
HOOK_LIB=${BASH_SOURCE[0]%/*}
HOOK_NAME=${0##*/}
# A plugin install has no git checkout to restore from; the hook runner sets CLAUDE_PLUGIN_ROOT.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  HOOK_RESTORE="Reinstall or update the plugin that ships $HOOK_NAME (/plugin)."
else
  HOOK_RESTORE="Restore it: git -C ~/.claude checkout -- hooks/lib"
fi
# Every Stop hook that blocks touches <sid> here first; stop-chime (same Stop array, no view of the
# decision) reads it to skip a false "done" chime.
STOP_BLOCK_DIR="${TMPDIR:-/tmp}/claude-stop-block"

# hook_lib <open|closed> [lib...]: need jq, then source each lib. jq is checked here because
# without it every field reads empty and each guard fails open; the refusal is hand-built JSON.
# errexit is off while sourcing: under bash 3.2 `set -e`, a missing file or a lib whose last
# command fails kills the hook with rc 1 (a silent UI error row) even inside `&&`. A `set -e`
# hook therefore sources hook-io itself before its `set -e`.
hook_lib() {
  local mode=$1 l errexit=''
  shift
  case $- in *e*) errexit=1; set +e ;; esac
  if ! command -v jq >/dev/null 2>&1; then
    [ "$mode" = closed ] && _hook_refuse "jq is not installed" "Ask the user to run: brew install jq"
    exit 0
  fi
  for l in "$@"; do
    [ -r "$HOOK_LIB/$l" ] && . "$HOOK_LIB/$l" 2>/dev/null && continue
    [ "$mode" = closed ] && _hook_refuse "hooks/lib/$l, or a file it reads, is missing or broken" "$HOOK_RESTORE"
    jq -n --arg m "$HOOK_NAME is off: hooks/lib/$l, or a file it reads, is missing or broken. $HOOK_RESTORE" '{systemMessage:$m}'
    exit 0
  done
  [ -z "$errexit" ] || set -e
}

# _hook_refuse <what is missing> <fix>: a closed hook's refusal, hand-built when jq is the missing
# piece. A permission deny exists only on PreToolUse; any other named event (commit-cohesion also
# answers UserPromptSubmit and PostToolUse) gets a user-visible systemMessage. A payload naming no
# event is read as PreToolUse, the one a closed guard must not let through. Exits 0.
_hook_refuse() {
  local re='"hook_event_name"[[:space:]]*:[[:space:]]*"([A-Za-z]*)"' ev=PreToolUse
  hook_input
  [[ $HOOK_INPUT =~ $re ]] && ev=${BASH_REMATCH[1]}
  if [ "$ev" != PreToolUse ]; then
    printf '{"systemMessage":"%s is off for %s: %s. %s"}\n' "$HOOK_NAME" "$ev" "$1" "$2"
    exit 0
  fi
  set -- "$HOOK_NAME: $1, so this guard cannot check the command and refuses it. $2"
  command -v jq >/dev/null 2>&1 && deny "$1"
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$1"
  exit 0
}

# kit_env: load the per-user overlay once ($KIT_ENV, else <config dir>/local/kit.env; KIT_ENV=/dev/null
# runs with none). Company values live there, never in a hook: an absent key is empty and the check
# it drives is off, so a hook with no overlay stays inert (prod guards need no key). Lines are
# KEY=value, the value literal (no expansion, no trailing comment), optionally in one pair of quotes.
# Parsed, not sourced: nothing in the file runs, and hooks/lib/kit_env.py reads it the same way. A
# key the file sets wins over the environment; shell and hook plumbing names are never set.
# Keys: kit.env.example (this kit's repo root, or ~/.claude).
kit_env() {
  [ -z "${_KIT_ENV_READ:-}" ] || return 0
  _KIT_ENV_READ=1
  local f=${KIT_ENV:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/local/kit.env} l k v
  [ -r "$f" ] || return 0
  while IFS= read -r l || [ -n "$l" ]; do
    k=${l%%=*}; v=${l#*=}
    [ "$k" != "$l" ] || continue
    case $k in ''|[!A-Z]*|*[!A-Z0-9_]*|PATH|HOME|IFS|SHELL|PWD|TMPDIR|KIT_ENV|HOOK_*|BASH*) continue ;; esac
    case $v in \'*\') v=${v#\'}; v=${v%\'} ;; \"*\") v=${v#\"}; v=${v%\"} ;; esac
    printf -v "$k" '%s' "$v"
  done < "$f"
  return 0
}

unset HOOK_INPUT
# hook_input: read the payload on stdin into HOOK_INPUT, once. A hook that fires on every Bash
# call matches the raw JSON against a word its command must contain before paying for jq.
hook_input() { [ -n "${HOOK_INPUT+x}" ] || HOOK_INPUT=$(cat); }

# hook_read VAR='jq expr' ...: set each VAR from HOOK_INPUT (read first if needed) with ONE jq
# process. A field the payload lacks, or a payload jq cannot parse, leaves VAR empty.
hook_read() {
  local _hr_a _hr_p=''
  hook_input
  for _hr_a in "$@"; do
    eval "${_hr_a%%=*}=''"
    _hr_p="$_hr_p\"${_hr_a%%=*}=\" + ((${_hr_a#*=}) | tostring | @sh),"
  done
  eval "$(jq -r "${_hr_p%,}" <<<"$HOOK_INPUT" 2>/dev/null)"
}

# decide <deny|ask> <reason> [context]: PreToolUse permission decision; the reason reaches the model.
decide() {
  jq -n --arg d "$1" --arg r "$2" --arg c "${3:-}" \
    '{hookSpecificOutput:({hookEventName:"PreToolUse",permissionDecision:$d,permissionDecisionReason:$r}
      + (if $c == "" then {} else {additionalContext:$c} end))}'
  exit 0
}
deny() { decide deny "$1"; }
ask()  { decide ask "$1"; }

# add_context <event> <text>: additionalContext for the model with no permissionDecision (an
# explicit allow would bypass the user's own permission rules). Does not exit.
add_context() {
  jq -n --arg e "$1" --arg c "$2" '{hookSpecificOutput:{hookEventName:$e,additionalContext:$c}}'
}

# stop_block <sid> <reason>: Stop decision:block, after marking STOP_BLOCK_DIR. Without jq, exit 2
# carries the reason on stderr.
stop_block() {
  mkdir -p "$STOP_BLOCK_DIR" 2>/dev/null && touch "$STOP_BLOCK_DIR/${1:-unknown}" 2>/dev/null
  jq -n --arg r "$2" '{decision:"block",reason:$r}' 2>/dev/null && exit 0
  printf '%s\n' "$2" >&2
  exit 2
}
