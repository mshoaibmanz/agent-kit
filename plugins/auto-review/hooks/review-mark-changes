#!/usr/bin/env bash
# PostToolUse hook for Edit|Write|MultiEdit: marks that source code changed so review-trigger
# (Stop) and pre-push-gate size a review. lib/review-state rv_mark_edit sets the worktree's edit
# marker and, on this session's first code edit there, its base: round 1 reviews from that HEAD,
# so committed work still gets reviewed in every worktree the session touches. The marker is
# cleared when a review completes, never here.
#
# Only marks for source files: doc/config/markdown edits don't trigger a review.
set -uo pipefail
. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0
hook_lib open
hook_read file='.tool_input.file_path // ""' session_id='.session_id // "unknown"'

# Prototype scope never triggers a review: throwaway design work lives here, plus the overlay's
# PROTOTYPE_DIRS.
case "$file" in
  */sandbox/*|*/prototypes/*|*.proto.ts|*.proto.tsx) exit 0 ;;
esac
kit_env
[ -n "${PROTOTYPE_DIRS:-}" ] && [[ $file =~ /($PROTOTYPE_DIRS)/ ]] && exit 0

# Session-temp helpers (scratchpad, tmp) are not reviewable work product.
case "$file" in
  /tmp/*|/private/tmp/*|/var/folders/*) exit 0 ;;
esac

hook_lib open review-state
rv_is_code "$file" || exit 0
root=$(git -C "${file%/*}" rev-parse --show-toplevel 2>/dev/null) || exit 0
rv_mark_edit "$session_id" "$root"
exit 0
