#!/usr/bin/env awk -f
# Read a shell command on stdin; print it with heredoc bodies removed. Used by the
# context-dumps guard in bash-guards, which forks ~10 processes per line it inspects: every
# heredoc line used to count as a command, so a 30KB `python3 - <<'PY'` took 26s against a
# 10s hook timeout and failed open.
#
# A body fed to a shell (`bash <<EOF`, `ssh host sh <<EOF`) is kept, because it runs.
# Handles <<WORD, <<-WORD (leading tabs stripped before matching the terminator), <<'WORD',
# <<"WORD", <<\WORD and several heredocs on one line. `<<<` here-strings are not heredocs.
#
# macOS awk (BWK, not gawk): no gensub, keep it plain.

BEGIN { n = 0; q = 0 }

{
    if (q < n) {
        line = $0
        if (tabs[q]) sub(/^\t+/, "", line)
        k = keep[q]
        if (line == delim[q]) { q++; if (q >= n) { n = 0; q = 0 } }
        if (k) print
        next
    }
    print
    s = $0
    shell = (s ~ /(^|[ \t;&|(])(bash|sh|zsh|ksh)([ \t]|$)/)
    while (match(s, /<<-?[ \t]*\\?['"]?[A-Za-z_][A-Za-z0-9_.-]*['"]?/)) {
        op = substr(s, RSTART, RLENGTH)
        prev = (RSTART > 1) ? substr(s, RSTART - 1, 1) : ""
        s = substr(s, RSTART + RLENGTH)
        if (prev == "<") continue
        d = substr(op, 3)
        t = 0
        if (d ~ /^-/) { t = 1; d = substr(d, 2) }
        gsub(/[ \t\\'"]/, "", d)
        delim[n] = d; tabs[n] = t; keep[n] = shell; n++
    }
}
