#!/usr/bin/env bash
# Stop hook: the self-check tier and the tally reminder. Agent review rounds are asked for at push
# by the git pre-push hook (lib/push-gate, rv_push_decide on the branch's review record); a Stop
# never spawns them. Sizing and the state behind it live in lib/review-state. This file owns:
#   tally owed         -> a review agent returned findings: settled by a TALLY line in the final
#                         message, else block once with RV_VERIFY
#   end of our chain   -> clear the edit marker unless an agent round is still out
#   new type errors    -> block once with them (lib/verify.py gate; the push refuses them)
#   code edited        -> rv_decide self on the work since the last completed review: a small
#                         delta (floor to ~40 lines) gets a self-check block, a larger one is left
#                         to the push
# Loop-guarded via stop_hook_active and a chain marker,
# so another hook's block never ends (or starts) a review chain. Skipped in the ci-watch agent.
set -uo pipefail

. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0
hook_lib open review-state
hook_read session_id='.session_id // "unknown"' stop_hook_active='.stop_hook_active // false' \
  cwd='.cwd // ""' last='.last_assistant_message // ""' tpath='.transcript_path // ""'
[ -n "$cwd" ] || cwd="$PWD"

[ -n "${CI_WATCH_ACTIVE:-}" ] && exit 0

# This hook necessarily fires after the model has written its completion summary, which the
# review pass then buries. Measured 2026-09-05 over 54 blocking sessions: 94% had written a full
# summary before the block, and a median 15,820 chars and 100 tool calls landed on top of it.
CLOSING="FINISH WITH THE SUMMARY, NOT THE REVIEW: your final message is the completion summary (what changed, how to verify, what is open) with the review folded in; restate it, the earlier copy is off-screen. Size it to the change."

root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)

# Checked first and in both branches: a foreground round returns inside the chain, a background
# one in a later turn. A TALLY line in the final message settles it; else it is settled before
# blocking, so it fires once per return. The final message is the payload's, else the transcript's
# last assistant text.
if rv_tally_owed "$session_id"; then
  if [ -z "$last" ] && [ -r "$tpath" ]; then
    last=$(tail -n 200 "$tpath" 2>/dev/null | jq -rs '[.[] | select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text] | last // ""' 2>/dev/null)
  fi
  owed=$RV_OWED
  rv_tally_settle "$session_id"
  if ! rv_tally_in "$last"; then
    _rv_verify
    stop_block "$session_id" "The ${owed// / and } review returned findings and no TALLY line closed them. $RV_VERIFY $CLOSING"
  fi
fi

if [ "$stop_hook_active" = "true" ]; then
  # The stop that ends a chain THIS hook started. A tier-0 self-check and a foreground agent
  # round are done by now, including their fixes, so the marker goes; an agent round still
  # running in the background keeps it until review-agent-mark sees it return. A chain some
  # other hook started (unfinished-work) is not a review, so it clears nothing.
  if rv_chain_close "$session_id" && [ -n "$root" ]; then
    rv_pending "$session_id" "$root" || rv_clear_edits "$session_id" "$root"
  fi
  exit 0
fi

rv_sweep
{ [ -n "$root" ] && rv_edited "$session_id" "$root"; } || exit 0

# The type gate (lib/verify.py, its own deadline inside this hook's): errors on the lines the branch
# added or changed, shown once per tree state; the push refuses them until they are fixed. It
# joins the self-check block rather than replacing it, so the review still runs in this chain.
types=''
if ! verify_out=$(python3 "${0%/*}/lib/verify.py" gate "$root" stop 2>/dev/null) && [ -n "$verify_out" ]; then
  types="Fix the type errors below, on lines this branch added or changed; the push refuses them (a false positive: say why, then AGENT_PUSH_NOW=\"<reason>\" git push).
$verify_out
"
fi

# The marker stays until a review completes: clearing it here, before sizing, let a Stop that
# ran no review (unchanged tree, under the floor) wave the next push through. An unchanged tree
# costs one snapshot and a silent exit.
RV_KIND=none
rv_snapshot "$root" && rv_decide "$session_id" self
if [ "$RV_KIND" = none ]; then
  [ -z "$types" ] || stop_block "$session_id" "$types$CLOSING"
  exit 0
fi
rv_chain_open "$session_id"
stop_block "$session_id" "$types$RV_TEXT $CLOSING"
