#!/usr/bin/env bash
# codex-review was renamed to agent-run on 2026-10-03 (roles.toml: the cross-model reviewer is the
# role cross-reviewer). Not an alias: sessions started before the rename may still run this path from
# their context, so it says what to run instead and records nothing. Delete after 2026-10-17.
printf 'codex-review: renamed. Run instead, in the background:\n  %s/agent-run cross-reviewer %s\nNothing run or recorded.\n' \
  "${0%/*}" "$(printf '%q ' "$@")" >&2
exit 2
