#!/usr/bin/env bash
# Git hook dispatcher for `core.hooksPath=~/.agents/git-hooks` (global). Every hook name in this
# directory is a link to this file. For hook <name> it runs, in order:
#   1. agent/<name>, only in an agent's shell (AI_AGENT, CLAUDECODE or AGENT_HOST set); a human's
#      git runs only step 2;
#   2. the repo's own hook: <repo-local core.hooksPath>/<name> when the repo sets one (husky), else
#      $(git rev-parse --git-common-dir)/hooks/<name>. A global core.hooksPath replaces that
#      directory, so without this step husky v3/v4 hooks and claude-kit's leak scan would stop.
# The first non-zero exit wins. Hooks that read stdin (pre-push's ref list, post-rewrite, the
# receive hooks) get the same bytes in both steps; the rest never touch stdin, which may be a tty.
# A repo-local core.hooksPath normally overrides this global one; agent shells can force the
# layer with GIT_CONFIG_COUNT/KEY/VALUE (command scope), and step 2 still finds the local value.
# Rollback: git config --global --unset core.hooksPath
name=${0##*/}
here=$(cd -P "${0%/*}" 2>/dev/null && pwd) || here=${0%/*}

tmp=''
case $name in
  pre-push|post-rewrite|pre-receive|post-receive|reference-transaction)
    tmp=$(mktemp "${TMPDIR:-/tmp}/agent-git-hook.XXXXXX") || exit 1
    trap 'rm -f "$tmp"' EXIT
    cat > "$tmp" ;;
esac
feed() { if [ -n "$tmp" ]; then "$@" < "$tmp"; else "$@"; fi; }

if [ -n "${AI_AGENT:-}${CLAUDECODE:-}${AGENT_HOST:-}" ] && [ "${AGENT_GIT_HOOKS:-}" != off ] \
   && [ -x "$here/agent/$name" ]; then
  feed "$here/agent/$name" "$@" || exit $?
fi

# A repo whose local core.hooksPath names this directory (example-api: it held its own
# .git/hooks, which overrides a global value) chains to the default directory.
dir=$(git config --local --get core.hooksPath 2>/dev/null)
if [ -n "$dir" ]; then
  case $dir in "~"/*) dir="$HOME/${dir#\~/}" ;; esac
  case $dir in /*) ;; *) dir="$PWD/$dir" ;; esac
  [ "$(cd -P "$dir" 2>/dev/null && pwd)" != "$here" ] || dir=''
fi
[ -n "$dir" ] || dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/hooks
[ "$(cd -P "$dir" 2>/dev/null && pwd)" != "$here" ] || exit 0
[ -x "$dir/$name" ] || exit 0
feed "$dir/$name" "$@"
