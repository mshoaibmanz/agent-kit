#!/usr/bin/env bash
# PreToolUse(SendMessage): a one-time nudge before resuming a subagent whose context is past
# SUBAGENT_RESUME_MAX (kit.env; default 300000), the rule rules/hosts/claude.md renders from the same
# key ("resume for follow-ups below <N>K; above it, start a fresh one from its notes").
#
# The target's context is input + cache creation + cache read of the latest usage line in its
# transcript, <session transcript minus .jsonl>/subagents/agent-<to>.jsonl. Past the limit the first
# send to that agent in this session is refused with the size; the marker
# <state>/resume-guard/<sid>-<to> lets the second send through. A target with no transcript there (a
# teammate name, another session's agent) or no usage line, and any odd payload, pass silently.
#
# WHY a refusal, not additionalContext: a resume re-writes the whole context in cache, so the nudge
# must land before the call, and a PreToolUse additionalContext without an allow decision is not
# shown to the model reliably (local/claude-kit-rules.md, hook output channels).
[ -n "${CI_WATCH_ACTIVE:-}" ] && exit 0
. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0
hook_lib open
hook_read event='.hook_event_name' tool='.tool_name' sid='.session_id' tp='.transcript_path' \
  to='.tool_input.to // ""'
[ "$event" = PreToolUse ] && [ "$tool" = SendMessage ] || exit 0
case $to in '' | *[!A-Za-z0-9_-]*) exit 0 ;; esac
case $sid in '' | *[!A-Za-z0-9_-]*) exit 0 ;; esac
case $tp in '~/'*) tp="$HOME/${tp#'~/'}" ;; esac
sub="${tp%.jsonl}/subagents/agent-$to.jsonl"
[ -f "$sub" ] && [ -r "$sub" ] || exit 0

kit_env
max=${SUBAGENT_RESUME_MAX:-300000}
case $max in '' | *[!0-9]*) max=300000 ;; esac
[ "$max" -gt 0 ] || exit 0

ctx=$(tail -c 1048576 "$sub" 2>/dev/null | LC_ALL=C awk '
function num(s, k,   i) { i = index(s, k); return i ? substr(s, i + length(k)) + 0 : 0 }
{ i = index($0, "\"usage\":{"); if (!i) next
  u = substr($0, i, 800); j = index(u, "}"); if (j) u = substr(u, 1, j)
  t = num(u, "\"input_tokens\":") + num(u, "\"cache_creation_input_tokens\":") + num(u, "\"cache_read_input_tokens\":")
  if (t > 0) ctx = t }
END { printf "%d\n", ctx }' 2>/dev/null)
case $ctx in '' | *[!0-9]*) exit 0 ;; esac
[ "$ctx" -gt "$max" ] || exit 0

S="${CLAUDE_STATE_DIR:-$HOME/.claude/state}/resume-guard"
m="$S/$sid-$to"
[ -f "$m" ] && exit 0
out=$(deny "Send the same message again to resume anyway (this refusal is once per agent).
Agent $to is at $((ctx / 1000))K context, past SUBAGENT_RESUME_MAX $((max / 1000))K: a resume re-writes all of it, so start a fresh agent from its notes instead.")
[ -n "$out" ] || exit 0
mkdir -p "$S" 2>/dev/null && : > "$m" 2>/dev/null
printf '%s\n' "$out"
exit 0
