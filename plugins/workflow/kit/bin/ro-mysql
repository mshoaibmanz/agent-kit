#!/usr/bin/env python3
"""Read-only MySQL for agents: one SELECT/SHOW/EXPLAIN/DESCRIBE/WITH statement per call,
executed in a server-enforced read-only session (works even with RW credentials).

usage: ro-mysql [--tunnel=NAME] [--login-path=X] [-D db] [--vertical] -e 'SELECT ...'
       ro-mysql --tunnels [--refresh]   every tunnel: kind, DB user, state, databases
       ro-mysql --rotate                store new DB passwords in the Keychain (own terminal)
env:   MYSQL_RO_PORT (target when --tunnel is absent), MYSQL_RO_HOST (must be local),
       MYSQL_RO_LOGIN_PATH (last-resort credentials), MYSQL_RO_MAX_MS (SELECT timeout, default
       15000)

The only targets are the `Host db-tunnel-*` LocalForwards in ~/.ssh/config. A tunnel or login
path named *staging*/*stg* is STAGING, anything else PROD, and every call labels its target on
stderr. Every call runs the Homebrew mysql-client at its fixed path, never one from the
environment or PATH. A tunnel's DB user is the `# ro-mysql: user=<db user>` line inside its Host
block, else the single user of the same-kind login paths on its port; a tunnel with neither is
refused until it is annotated. Passwords are per tunnel (Keychain service ro-mysql, account
<db user>@<tunnel alias>), since one user's password differs between instances; the password
reaches the client only through a 0600 option file removed when it exits. Without one, a same-kind
login path of that user is used. --login-path forces one only if its user is the tunnel's.
`-h`/`-P` are not accepted.

On ERROR 2003 the target's tunnel is re-opened and the same validated command re-run once. On
ERROR 1045 the user and tunnel are recorded in ~/.claude/state/db-auth-failed until that pair next
succeeds.
"""

import collections
import contextlib
import datetime
import functools
import getpass
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable, Iterator
from typing import Any, NamedTuple, NoReturn

ALLOWED_FIRST = {"select", "show", "explain", "describe", "desc", "with"}

SSH_CONFIG = os.path.expanduser("~/.ssh/config")
STATE_DIR = os.path.expanduser("~/.claude/state")
CACHE = os.path.join(STATE_DIR, "db-tunnels.tsv")
AUTH_FAILED = os.path.join(STATE_DIR, "db-auth-failed")
TUNNEL_PREFIX = "db-tunnel-"
KEYCHAIN_SERVICE = "ro-mysql"
# Anchored to a name segment so `postgres` does not read as `stg`. hooks/lib/db-registry
# carries the same pattern.
STAGING_RE = re.compile(r"(?:^|[^a-z])(?:staging|stg)", re.IGNORECASE)
ANNOTATION_RE = re.compile(r"#\s*ro-mysql:\s*(.*)")
DB_USER_RE = re.compile(r"[A-Za-z0-9_.@-]+")
SYSTEM_SCHEMAS = {"information_schema", "mysql", "performance_schema", "sys"}
CACHE_COLUMNS = ("alias", "port", "kind", "checked", "via", "databases")
LOCAL_HOSTS = {"127.0.0.1", "localhost"}
SSH_TIMEOUT_S = 30
SECURITY = "/usr/bin/security"
# The only clients ro-mysql runs. A binary picked from the environment or PATH would receive the
# credential (a Keychain password, or a login path whose user can write) after every check passed.
CLIENT_CANDIDATES = (
    "/opt/homebrew/opt/mysql-client/bin/mysql",
    "/usr/local/opt/mysql-client/bin/mysql",
    "/usr/bin/mysql",  # Linux distribution packages: root-owned, not picked from PATH
)
SECRET_TOOL_PATHS = ("/usr/bin/secret-tool", "/usr/local/bin/secret-tool")


def secret_store() -> str:
    """Where passwords live: the macOS Keychain, libsecret's secret-tool on Linux, else environment
    variables (env_name). A store without the item also falls back to the variable."""
    if os.path.exists(SECURITY):
        return "keychain"
    if any(os.path.exists(path) for path in SECRET_TOOL_PATHS):
        return "secret-tool"
    return "env"


def secret_tool() -> str:
    return next(path for path in SECRET_TOOL_PATHS if os.path.exists(path))


def env_name(account: str) -> str:
    """RO_MYSQL_PASSWORD_ plus the account with letters and digits kept and every other byte as _XX
    (hex): one name per account, so prod-a and prod_a tunnels never share a password."""
    return "RO_MYSQL_PASSWORD_" + "".join(
        chr(byte) if chr(byte).isascii() and chr(byte).isalnum() else f"_{byte:02X}" for byte in account.encode())
LSOF_FAILED = "an unknown process (lsof failed)"

# A leading SELECT/WITH/EXPLAIN does not make a statement a read: MySQL 8 permits
# `WITH ... UPDATE|DELETE`, EXPLAIN ANALYZE executes its target, and `FOR UPDATE` takes
# row locks. These same words are string functions when followed by '(' — REPLACE(),
# INSERT() — so only the statement position is rejected.
WRITE_TOKENS = {"insert", "update", "delete", "replace"}

# Passthru is an allowlist, not a blocklist: mysql's my_getopt treats '-' and '_' as
# interchangeable, so any blocklist has to be spelled twice and one spelling always gets
# missed (--init_command sailing past a --init-command block, and overriding it).
PASSTHRU_FLAGS = {
    "--vertical", "-E",
    "--table", "-t",
    "--batch", "-B",
    "--raw", "-r",
    "--silent", "-s",
    "--skip-column-names", "-N",
    "--column-names",
    "--comments",
}
PASSTHRU_VALUED = {"--database", "--default-character-set"}
PASSTHRU_SHORT_VALUED = {"-D"}


class Tunnel(NamedTuple):
    alias: str
    port: str
    user: str | None

    @property
    def name(self) -> str:
        return self.alias.removeprefix(TUNNEL_PREFIX)

    @property
    def kind(self) -> str:
        return kind_of(self.alias)


class LoginPath(NamedTuple):
    name: str
    user: str | None
    port: str | None


class Creds(NamedTuple):
    user: str | None
    password: str | None
    login_path: str | None

    def describe(self) -> str:
        if self.password is not None:
            return f"as {self.user} (keychain)"
        return f"via login path {self.login_path}"


class Plan(NamedTuple):
    cmd: list[str]
    env: dict[str, str]
    password: str | None
    tunnel: Tunnel
    port_tunnels: list[Tunnel]  # every tunnel forwarding its port, itself included
    user: str | None
    label: str


Logins = Callable[[], dict[str, LoginPath]]
Listeners = Callable[[], dict[str, tuple[str, str]] | None]


def die(msg: str) -> NoReturn:
    print(f"ro-mysql: {msg}", file=sys.stderr)
    sys.exit(2)


def norm(opt: str) -> str:
    """my_getopt folds '_' to '-' in long option names; compare the way the client does."""
    return opt.replace("_", "-") if opt.startswith("--") else opt


def tokenize(sql: str) -> list[str]:
    """Emit word/symbol tokens outside strings and comments; string literals become '<str>'.

    Mirrors mysql lexing where it matters: '--' is a comment only when followed by
    whitespace (so '1--2;DELETE' can't hide a second statement), and '/*!...*/'
    versioned comments are rejected outright because the server EXECUTES their contents.
    """
    tokens: list[str] = []
    i, n = 0, len(sql)
    while i < n:
        c = sql[i]
        if c in "'\"`":
            q = c
            i += 1
            while i < n:
                if q != "`" and sql[i] == "\\":
                    i += 2
                    continue
                if sql[i] == q:
                    if i + 1 < n and sql[i + 1] == q:
                        i += 2
                        continue
                    i += 1
                    break
                i += 1
            tokens.append("<str>")
            continue
        if c == "#":
            while i < n and sql[i] != "\n":
                i += 1
            continue
        if sql.startswith("--", i) and (i + 2 >= n or sql[i + 2] in " \t\r\n"):
            while i < n and sql[i] != "\n":
                i += 1
            continue
        if sql.startswith("/*!", i):
            die("versioned comments (/*!) not allowed")
        if sql.startswith("/*", i):
            end = sql.find("*/", i + 2)
            i = n if end == -1 else end + 2
            continue
        if c.isspace():
            i += 1
            continue
        if c == ";":
            tokens.append(";")
            i += 1
            continue
        j = i
        while j < n and (sql[j].isalnum() or sql[j] in "_$"):
            j += 1
        if j > i:
            tokens.append(sql[i:j].lower())
            i = j
        else:
            tokens.append(c)
            i += 1
    return tokens


def validate(sql: str) -> None:
    tokens = tokenize(sql)
    while tokens and tokens[-1] == ";":
        tokens.pop()
    if not tokens:
        die("empty statement")
    if ";" in tokens:
        die("one statement per call (multi-statement rejected)")
    if "\\" in tokens:
        die("client backslash-commands (\\! \\. etc) not allowed")
    if tokens[0] not in ALLOWED_FIRST:
        die(f"read-only statements only: {', '.join(sorted(ALLOWED_FIRST))}")
    for a, b in zip(tokens, tokens[1:]):
        if a == "into" and b in ("outfile", "dumpfile"):
            die("INTO OUTFILE/DUMPFILE not allowed")
    for idx, tok in enumerate(tokens):
        if tok in WRITE_TOKENS and (idx + 1 >= len(tokens) or tokens[idx + 1] != "("):
            die(
                f"'{tok.upper()}' in statement position — a leading SELECT/WITH/EXPLAIN does "
                "not make this a read (WITH ... UPDATE, EXPLAIN ANALYZE and SELECT ... FOR "
                "UPDATE all write or lock)"
            )


def parse_args(argv: list[str]) -> tuple[str | None, str | None, str | None, list[str]]:
    """Split argv into (sql, login path, tunnel name, client passthru)."""
    passthru: list[str] = []
    sql: str | None = None
    login_path: str | None = None
    tunnel: str | None = None
    i = 0
    while i < len(argv):
        a = argv[i]
        head = norm(a.split("=", 1)[0])
        if a in ("-e", "--execute"):
            i += 1
            if i >= len(argv):
                die("missing SQL after -e")
            sql = argv[i]
        elif head == "--execute":
            sql = a.split("=", 1)[1]
        elif head in ("--login-path", "--tunnel"):
            if "=" in a:
                value = a.split("=", 1)[1]
            else:
                i += 1
                if i >= len(argv):
                    die(f"missing value after {head}")
                value = argv[i]
            if head == "--tunnel":
                tunnel = value
            else:
                login_path = value
        elif not a.startswith("-"):
            passthru.append(a)  # bare positional = database name
        elif a[:2] in PASSTHRU_SHORT_VALUED:
            if len(a) > 2:
                passthru.append(a)
            else:
                i += 1
                if i >= len(argv):
                    die(f"missing value after {a}")
                passthru += [a, argv[i]]
        elif head in PASSTHRU_FLAGS and "=" not in a:
            passthru.append(a)
        elif head in PASSTHRU_VALUED:
            if "=" in a:
                passthru.append(a)
            else:
                i += 1
                if i >= len(argv):
                    die(f"missing value after {a}")
                passthru += [a, argv[i]]
        elif a.startswith("--password") or (a.startswith("-p") and not a.startswith("--")):
            die("inline passwords not allowed; ro-mysql reads them from the Keychain")
        elif head in ("-h", "--host", "-P", "--port"):
            die(f"{a}: pick the target with --tunnel=<name> or MYSQL_RO_PORT; MYSQL_RO_HOST stays local (ro-mysql --tunnels)")
        else:
            allowed = ", ".join(sorted(PASSTHRU_FLAGS | PASSTHRU_VALUED | PASSTHRU_SHORT_VALUED))
            die(f"arg not allowed: {a}  (permitted: -e, --tunnel, --login-path, {allowed})")
        i += 1
    return sql, login_path, tunnel, passthru


def kind_of(name: str) -> str:
    return "STAGING" if STAGING_RE.search(name) else "PROD"


def parse_tunnels(text: str) -> list[Tunnel]:
    """Each LocalForward port under a literal `Host db-tunnel-*`, with its block's DB user."""
    tunnels: list[Tunnel] = []
    aliases: list[str] = []
    ports: list[str] = []
    user: str | None = None

    def flush() -> None:
        tunnels.extend(Tunnel(a, p, user) for a in aliases for p in ports)

    for raw in text.splitlines():
        line = raw.strip()
        note = ANNOTATION_RE.fullmatch(line)
        if note:
            fields = dict(f.split("=", 1) for f in note.group(1).split() if "=" in f)
            if DB_USER_RE.fullmatch(fields.get("user", "")):
                user = fields["user"]
            continue
        m = re.match(r"(\w+)\s*(?:=\s*|\s+)(.*)", line)
        if m is None:
            continue
        key, args = m.group(1).lower(), m.group(2).split()
        if key in ("host", "match"):
            flush()
            aliases, ports, user = [], [], None
            if key == "host":
                aliases = [a for a in args if a.startswith(TUNNEL_PREFIX) and not set(a) & set("*?!")]
        elif key == "localforward" and args:
            port = args[0].rsplit(":", 1)[-1]
            if port.isdigit():
                ports.append(port)
    flush()
    # Two binds of one local port (127.0.0.1 and [::1]) are one forward.
    return list(dict.fromkeys(tunnels))


def load_tunnels(path: str = SSH_CONFIG) -> list[Tunnel]:
    try:
        with open(path) as f:
            return parse_tunnels(f.read())
    except OSError:
        return []


def parse_login_paths(text: str) -> dict[str, LoginPath]:
    """`mysql_config_editor print --all` output, keyed by login path."""
    found: dict[str, dict[str, str]] = {}
    fields: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("[") and line.endswith("]"):
            fields = found.setdefault(line[1:-1], {})
        elif "=" in line:
            key, value = line.split("=", 1)
            fields[key.strip()] = value.strip().strip('"')
    return {n: LoginPath(n, f.get("user"), f.get("port")) for n, f in found.items()}


@functools.cache
def login_paths() -> dict[str, LoginPath]:
    """The user's login paths; only consulted where a tunnel has no annotation or password."""
    editors = [os.path.join(os.path.dirname(p), "mysql_config_editor") for p in CLIENT_CANDIDATES]
    editor = next((e for e in editors if os.access(e, os.X_OK)), None)
    if editor is None:
        return {}
    try:
        out = subprocess.run(
            [editor, "print", "--all"], capture_output=True, text=True, timeout=10
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return parse_login_paths(out)


def port_users(t: Tunnel, logins: dict[str, LoginPath]) -> set[str]:
    """The users of the same-kind login paths on t's port."""
    return {
        lp.user for lp in logins.values()
        if lp.port == t.port and lp.user and kind_of(lp.name) == t.kind
    }


def tunnel_user(t: Tunnel, logins: dict[str, LoginPath]) -> str | None:
    """The annotated DB user, else the single user of same-kind login paths on its port."""
    if t.user:
        return t.user
    users = port_users(t, logins)
    return users.pop() if len(users) == 1 else None


def no_user_reason(t: Tunnel, logins: dict[str, LoginPath]) -> str:
    """Why t has no DB user, and the annotation that gives it one. Counts users, never names them."""
    n = len(port_users(t, logins))
    shared = f" ({n} login-path users share port {t.port})" if n > 1 else ""
    return (
        f"{t.alias} has no DB user{shared}: add `# ro-mysql: user=<db user>` under "
        f"`Host {t.alias}` in ~/.ssh/config"
    )


def fallback_login_paths(t: Tunnel, user: str, logins: dict[str, LoginPath]) -> list[str]:
    """Same-kind login paths for the tunnel's user, most specific first."""
    stem = t.name.split("-")[0]
    fits = [lp for lp in logins.values() if kind_of(lp.name) == t.kind and lp.user == user]
    fits.sort(key=lambda lp: (lp.port != t.port, not lp.name.startswith(stem), lp.name))
    return [lp.name for lp in fits]


def keychain_account(t: Tunnel, user: str) -> str:
    """One entry per tunnel: the same DB user has a different password on each instance."""
    return f"{user}@{t.alias}"


def multi_port_aliases(tunnels: list[Tunnel]) -> set[str]:
    """Aliases forwarding several local ports: they would share one Keychain account, so none is stored."""
    counts = collections.Counter(alias for alias, _ in {(t.alias, t.port) for t in tunnels})
    return {alias for alias, n in counts.items() if n > 1}


def keychain_get(account: str) -> str | None:
    """The account's password from the store, else from its environment variable."""
    return store_get(account) or os.environ.get(env_name(account)) or None


def store_get(account: str) -> str | None:
    store = secret_store()
    if store == "env":
        return None
    if store == "secret-tool":
        command = [secret_tool(), "lookup", "service", KEYCHAIN_SERVICE, "account", account]
        try:
            r = subprocess.run(command, capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            return None
        return (r.stdout.rstrip("\n") or None) if r.returncode == 0 else None
    try:
        r = subprocess.run(
            [SECURITY, "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account, "-w"],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return r.stdout[:-1] if r.stdout.endswith("\n") else r.stdout


def keychain_set(account: str, password: str) -> bool:
    """Store via `security -i` on stdin, hex-encoded, so the password never enters argv."""
    if not DB_USER_RE.fullmatch(account):
        return False
    store = secret_store()
    if store == "env":
        print(f"  no Keychain or secret-tool here: export {env_name(account)} in your shell profile instead", file=sys.stderr)
        return False
    if store == "secret-tool":
        try:
            r = subprocess.run([secret_tool(), "store", f"--label=ro-mysql {account}", "service", KEYCHAIN_SERVICE,
                                "account", account], input=password, capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            return False
        return r.returncode == 0 and keychain_get(account) == password
    line = f"add-generic-password -U -s {KEYCHAIN_SERVICE} -a {account} -X {password.encode().hex()}\n"
    try:
        r = subprocess.run(
            [SECURITY, "-i"], input=line, capture_output=True, text=True, timeout=10
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and keychain_get(account) == password


def note_auth_failure(user: str, alias: str, path: str = AUTH_FAILED) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    stamp = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    with open(path, "w") as f:
        f.write(f"{user} {alias} {stamp}\n")


def clear_auth_failure(user: str | None, alias: str, path: str = AUTH_FAILED) -> None:
    """Drop the failure record once the same user authenticates again on the same tunnel."""
    try:
        with open(path) as f:
            recorded = f.read().split()
    except OSError:
        return
    if user and recorded[:2] == [user, alias]:
        os.remove(path)


def listeners() -> dict[str, tuple[str, str]] | None:
    """Local TCP port -> (pid, command line) of the process listening on it; None if lsof failed."""
    try:
        r = subprocess.run(
            ["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpn"],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    # lsof exits 1 both for "no listener" and for an error; only empty output makes it the former.
    if r.returncode != 0 and (r.returncode != 1 or r.stdout.strip()):
        return None
    out = r.stdout
    by_port: dict[str, str] = {}
    pid = ""
    for line in out.splitlines():
        if line.startswith("p"):
            pid = line[1:]
        elif line.startswith("n"):
            by_port.setdefault(line.rsplit(":", 1)[-1], pid)
    if not by_port:
        return {}
    try:
        ps = subprocess.run(
            ["ps", "-o", "pid=,command=", "-p", ",".join(sorted(set(by_port.values())))],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        ps = ""
    commands = {}
    for line in ps.splitlines():
        pid_s, _, command = line.strip().partition(" ")
        commands[pid_s] = command.strip()
    return {port: (p, commands.get(p, "")) for port, p in by_port.items()}


def holder(port: str, tunnels: list[Tunnel], held: dict[str, tuple[str, str]] | None) -> str | None:
    """The db-tunnel alias (or other command) listening on a local port; None when free."""
    if held is None:
        return LSOF_FAILED
    if port not in held:
        return None
    words = held[port][1].split()
    fallback = os.path.basename(words[0]) if words else "an unknown process"
    return next((t.alias for t in tunnels if t.alias in words), fallback)


def pick_tunnel(
    tunnels: list[Tunnel], name: str | None, port: str | None, held_by: Callable[[str], str | None]
) -> Tunnel:
    """Resolve --tunnel (or else the port) to exactly one tunnel, never guessing on a shared port."""
    if name:
        matches = [t for t in tunnels if name in (t.alias, t.name)]
        if len(matches) > 1:
            matches = [t for t in matches if t.port == port]
        if len(matches) != 1:
            known = ", ".join(sorted({t.name for t in tunnels})) or "none"
            die(f"unknown tunnel {name!r} (known: {known}); ro-mysql --tunnels lists them")
        t = matches[0]
        if shares_port(t, tunnels):
            h = held_by(t.port)
            refuse_unknown_holder(t.port, h)
            if h not in (None, t.alias):
                die(f"port {t.port} is held by {h}, not {t.alias}; close it first (ro-mysql --tunnels)")
        return t
    if not port:
        die("no target: pass --tunnel=<name> (ro-mysql --tunnels lists them)")
    matches = [t for t in tunnels if t.port == port]
    if not matches:
        die(f"port {port} is not a db-tunnel-* LocalForward in ~/.ssh/config; use --tunnel=<name> (ro-mysql --tunnels)")
    if len(matches) == 1:
        return matches[0]
    h = held_by(port)
    refuse_unknown_holder(port, h)
    for t in matches:
        if t.alias == h:
            return t
    names = ", ".join(t.name for t in matches)
    die(f"port {port} is shared by {names} and none of them holds it; pass --tunnel=<name>")


def shares_port(t: Tunnel, tunnels: list[Tunnel]) -> bool:
    return sum(x.port == t.port for x in tunnels) > 1


def refuse_unknown_holder(port: str, h: str | None) -> None:
    """On a shared port an unknown holder may be a sibling tunnel, so the query would read it."""
    if h == LSOF_FAILED:
        die(f"port {port} is shared by several tunnels and lsof could not say which one holds it; retry")


def cred_chain(t: Tunnel, login_path: str | None, logins: Logins) -> list[Creds]:
    """Credentials for t, best first: a forced login path, the Keychain, same-kind login paths."""
    if login_path:
        forced = logins().get(login_path)
        user = forced.user if forced else None
        # Another same-kind login path may hold a user with write grants, which --login-path would
        # otherwise hand the client, so it must be the tunnel's reader. An unannotated tunnel whose
        # port's login paths name no single user has none to check against, and is refused too.
        reader = tunnel_user(t, {} if t.user else logins())
        if reader is None:
            die(f"--login-path needs {t.alias}'s DB user to check it against. {no_user_reason(t, logins())}")
        if user != reader:
            die(
                f"--login-path={login_path} connects as {user or 'an unknown user'}, not "
                f"{t.alias}'s DB user {reader}. Drop --login-path: ro-mysql uses {reader}'s "
                "credentials itself."
            )
        return [Creds(user, None, login_path)]
    user = tunnel_user(t, {} if t.user else logins())
    # The same rule as --login-path: with no user to check against, the first same-port login path
    # by sort order may be one whose user can write, so there is nothing safe to pick.
    if user is None:
        return []
    password = keychain_get(keychain_account(t, user))
    if password is not None:
        return [Creds(user, password, None)]
    return login_fallbacks(t, user, logins)


def login_fallbacks(t: Tunnel, user: str, logins: Logins) -> list[Creds]:
    """The login paths t's user falls back to without a Keychain password; MYSQL_RO_LOGIN_PATH
    counts only when no login path is readable."""
    known = logins()
    candidates = fallback_login_paths(t, user, known)
    env_lp = os.environ.get("MYSQL_RO_LOGIN_PATH")
    if not known and env_lp and kind_of(env_lp) == t.kind:
        candidates = [env_lp]
    return [Creds(known[c].user if c in known else None, None, c) for c in candidates]


def no_creds_reason(t: Tunnel, logins: Logins) -> str:
    user = tunnel_user(t, {} if t.user else logins())
    if user is None:
        return no_user_reason(t, logins())
    return (f"Credential access unavailable for {keychain_account(t, user)}: the item may be missing or Keychain access denied. "
            "Retry from a trusted terminal or approved wrapper before changing credentials; "
            "use `ro-mysql --rotate` only after confirming the item is missing or expired.")


def pick_creds(t: Tunnel, login_path: str | None, logins: Logins) -> Creds:
    chain = cred_chain(t, login_path, logins)
    if not chain:
        die(no_creds_reason(t, logins))
    return chain[0]


def fixed_client() -> str:
    for path in CLIENT_CANDIDATES:
        if os.access(path, os.X_OK):
            return path
    hint_script = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks/lib/install-hint")
    try:
        hint = subprocess.run(["sh", hint_script, "mysql"], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        hint = ""
    hint = hint or "install the mysql client with your package manager"
    die(f"no mysql client at {' or '.join(CLIENT_CANDIDATES)}: {hint}")


def client_cmd(port: str, creds: Creds, extra: list[str], sql: str) -> tuple[list[str], dict[str, str]]:
    """The client argv and environment; neither ever carries a password (run_client adds it)."""
    max_ms = int(os.environ.get("MYSQL_RO_MAX_MS", "15000"))
    init = f"SET SESSION transaction_read_only = ON, SESSION max_execution_time = {max_ms}"
    env = dict(os.environ)
    env.pop("MYSQL_PWD", None)
    auth = f"--login-path={creds.login_path}" if creds.password is None else f"--user={creds.user}"
    cmd = [fixed_client(), auth]
    # TCP pins the checked port: `localhost` would otherwise take the local unix socket.
    cmd += ["--connect-timeout=10", "--protocol=TCP", "-h", "127.0.0.1", "-P", port]
    # --init-command goes LAST: mysql takes the final occurrence of a repeated option, so
    # anything that slipped into passthru cannot override the read-only session.
    cmd += [*extra, f"--init-command={init}", "-e", sql]
    return cmd, env


def cnf_quote(value: str) -> str:
    """A double-quoted option-file value that my_getopt reads back byte for byte."""
    escapes = {"\\": "\\\\", '"': '\\"', "\n": "\\n", "\r": "\\r", "\t": "\\t"}
    return '"' + "".join(escapes.get(c, c) for c in value) + '"'


def _exit_on_signal(signum: int, _frame: object) -> NoReturn:
    raise SystemExit(128 + signum)


@contextlib.contextmanager
def password_file(password: str) -> Iterator[str]:
    """A 0600 [client] option file holding the password, removed when the block exits."""
    fd, path = tempfile.mkstemp(prefix="ro-mysql-", suffix=".cnf")
    # SIGTERM/SIGHUP would otherwise skip the finally and leave the password on disk.
    previous = {s: signal.signal(s, _exit_on_signal) for s in (signal.SIGTERM, signal.SIGHUP)}
    try:
        with os.fdopen(fd, "w") as f:
            f.write(f"[client]\npassword={cnf_quote(password)}\n")
        yield path
    finally:
        with contextlib.suppress(OSError):
            os.remove(path)
        for s, handler in previous.items():
            signal.signal(s, handler)


def run_client(
    cmd: list[str], env: dict[str, str], password: str | None, **kwargs: Any
) -> subprocess.CompletedProcess[str]:
    """Run the client; a password reaches it only through an option file deleted when it exits."""
    if password is None:
        return subprocess.run(cmd, env=env, **kwargs)
    with password_file(password) as path:
        # The client honours --defaults-extra-file only as its first argument.
        return subprocess.run([cmd[0], f"--defaults-extra-file={path}", *cmd[1:]], env=env, **kwargs)


def plan(
    argv: list[str],
    ssh_config: str = SSH_CONFIG,
    logins: Logins = login_paths,
    held: Listeners = listeners,
) -> Plan:
    """Validate a query call and resolve its tunnel, credentials and client command."""
    sql, login_path, tunnel_name, passthru = parse_args(argv)
    if sql is None:
        die("usage: ro-mysql [--tunnel=NAME] [-D db] -e 'SELECT ...'  (interactive mode disabled)")
    validate(sql)
    host = os.environ.get("MYSQL_RO_HOST") or "127.0.0.1"
    if host not in LOCAL_HOSTS:
        die(f"MYSQL_RO_HOST={host}: only the local db-tunnel forwards are reachable (ro-mysql --tunnels)")
    tunnels = load_tunnels(ssh_config)
    # A bare word is a database name to mysql, so `ro-mysql crossborder-staging -e …` used to reach
    # the default tunnel (a PROD one) and ask it for a database called crossborder-staging.
    names = {t.name for t in tunnels} | {t.alias for t in tunnels}
    prev = ""
    for word in passthru:
        if not word.startswith("-") and prev not in PASSTHRU_SHORT_VALUED | PASSTHRU_VALUED and word in names:
            die(f"'{word}' is a tunnel, not a database: pass --tunnel={word} (ro-mysql --tunnels)")
        prev = word
    port = os.environ.get("MYSQL_RO_PORT") or None
    if not tunnel_name and not port and login_path and login_path in logins():
        port = logins()[login_path].port
    t = pick_tunnel(tunnels, tunnel_name, port, lambda p: holder(p, tunnels, held()))
    if login_path and kind_of(login_path) != t.kind:
        die(
            f"--login-path={login_path} is {kind_of(login_path)} but {t.alias} (port {t.port}) is "
            f"{t.kind}: that reads one environment and labels it the other. Drop --login-path and "
            "pass --tunnel=<name> (ro-mysql --tunnels)."
        )
    creds = pick_creds(t, login_path, logins)
    cmd, env = client_cmd(t.port, creds, passthru, sql)
    label = f"{t.kind} {t.name} @{t.port} {creds.describe()}"
    port_tunnels = [x for x in tunnels if x.port == t.port]
    return Plan(cmd, env, creds.password, t, port_tunnels, creds.user, label)


def open_tunnel(alias: str) -> str:
    """Start the ssh forward; returns its last stderr line ('' on success)."""
    try:
        # BatchMode fails fast instead of hanging on a prompt; -f backgrounds after the forward binds.
        r = subprocess.run(
            ["ssh", "-f", "-N", "-o", "BatchMode=yes", alias],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            text=True, timeout=SSH_TIMEOUT_S, check=False,
        )
    except subprocess.TimeoutExpired:
        return f"ssh {alias} timed out after {SSH_TIMEOUT_S}s"
    lines = r.stderr.strip().splitlines()
    return "" if r.returncode == 0 else (lines[-1] if lines else f"ssh exited {r.returncode}")


def close_tunnel(t: Tunnel, tunnels: list[Tunnel]) -> None:
    held = listeners()
    if held is None or holder(t.port, tunnels, held) != t.alias:
        return
    os.kill(int(held[t.port][0]), signal.SIGTERM)
    for _ in range(15):
        if t.port not in (listeners() or {}):
            return
        time.sleep(0.2)


@contextlib.contextmanager
def tunnel_up(t: Tunnel, tunnels: list[Tunnel]) -> Iterator[str | None]:
    """Yield None while t's forward listens (opened here and closed after if it was down), else why not."""
    h = holder(t.port, tunnels, listeners())
    if h == t.alias:
        yield None
        return
    if h is not None:
        yield f"port {t.port} is held by {h}"
        return
    err = open_tunnel(t.alias)
    if holder(t.port, tunnels, listeners()) != t.alias:
        yield f"tunnel did not open: {err or 'no listener'}"
        return
    try:
        yield None
    finally:
        close_tunnel(t, tunnels)


def attempt(t: Tunnel, creds: Creds, sql: str) -> subprocess.CompletedProcess[str]:
    cmd, env = client_cmd(t.port, creds, ["-N", "-B"], sql)
    try:
        return run_client(
            cmd, env, creds.password, capture_output=True, text=True, errors="replace", timeout=60
        )
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 1, "", f"{sql} timed out after 60s")


def last_line(text: str) -> str:
    lines = text.strip().splitlines()
    return lines[-1] if lines else "no output"


def show_databases(
    t: Tunnel, tunnels: list[Tunnel], logins: Logins | None = None
) -> tuple[str, str]:
    """(how it authenticated, comma-joined databases) for one tunnel, or a '? reason'."""
    # Looked up per call, not bound as the default: a default is fixed when the def runs.
    logins = logins or login_paths
    tries = cred_chain(t, None, logins)
    if not tries:
        return "-", f"? {no_creds_reason(t, logins)}"
    with tunnel_up(t, tunnels) as problem:
        if problem:
            return "-", f"? {problem}"
        reason = ""
        for creds in tries:
            r = attempt(t, creds, "SHOW DATABASES")
            if r.returncode == 0:
                dbs = [d for d in r.stdout.splitlines() if d and d not in SYSTEM_SCHEMAS]
                return creds.describe(), ",".join(dbs) or "(none)"
            reason = last_line(r.stderr)
            if "ERROR 1045" not in r.stderr:
                break
    return "-", f"? {reason}"


def read_cache(path: str = CACHE) -> dict[tuple[str, str], dict[str, str]]:
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return {}
    rows = (dict(zip(CACHE_COLUMNS, line.split("\t"))) for line in lines[1:] if line)
    return {(r["alias"], r["port"]): r for r in rows if "port" in r}


def refresh(tunnels: list[Tunnel], path: str = CACHE) -> None:
    today = datetime.date.today().isoformat()
    rows = []
    for t in tunnels:
        print(f"ro-mysql: checking {t.alias} @{t.port}", file=sys.stderr)
        via, dbs = show_databases(t, tunnels)
        rows.append((t.alias, t.port, t.kind, today, via, dbs))
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("\t".join(CACHE_COLUMNS) + "\n")
        f.writelines("\t".join(row) + "\n" for row in rows)


def keychain_has(account: str) -> bool:
    if secret_store() != "keychain":
        return keychain_get(account) is not None
    try:
        r = subprocess.run(
            [SECURITY, "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account],
            capture_output=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0


def show_tunnels(tunnels: list[Tunnel], do_refresh: bool) -> None:
    if not tunnels:
        die(f"no `Host db-tunnel-*` block with a LocalForward in {SSH_CONFIG}")
    if do_refresh:
        refresh(tunnels)
    cache = read_cache()
    held = listeners()
    logins = {} if all(t.user for t in tunnels) else login_paths()
    rows = [("TUNNEL", "PORT", "KIND", "DB USER", "STATE", "DATABASES")]
    for t in tunnels:
        h = holder(t.port, tunnels, held)
        state = "up" if h == t.alias else "down" if h is None else f"down ({h} holds the port)"
        if h == LSOF_FAILED:
            state = "? (lsof failed)"
        dbs = cache.get((t.alias, t.port), {}).get("databases", "? not checked")
        rows.append((t.name, t.port, t.kind, tunnel_user(t, logins) or "?", state, dbs))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]) - 1)]
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)) + "  " + r[-1])
    print()
    ports: dict[str, list[str]] = {}
    for t in tunnels:
        ports.setdefault(t.port, []).append(t.name)
    for port, names in ports.items():
        if len(names) > 1:
            print(f"shared port {port}: {', '.join(names)}; only one can be open, so give each its own port")
    shared = multi_port_aliases(tunnels)
    for alias in sorted(shared):
        print(f"{alias} has several LocalForwards, so it gets no Keychain password: give each forward its own alias")
    missing = [
        (t, u) for t in tunnels
        if t.alias not in shared and (u := tunnel_user(t, logins)) and not keychain_has(keychain_account(t, u))
    ]
    via_login = [t.name for t, u in missing if login_fallbacks(t, u, login_paths)]
    no_creds = [t.name for t, _ in missing if t.name not in via_login]
    if via_login:
        print(f"no Keychain password for {', '.join(via_login)} (login path used): run `ro-mysql --rotate` in a terminal")
    if no_creds:
        print(f"no Keychain password or login path for {', '.join(no_creds)}: run `ro-mysql --rotate` in a terminal")
    with contextlib.suppress(OSError), open(AUTH_FAILED) as f:
        print(f"auth failed: {f.read().strip()}; run `ro-mysql --rotate` in a terminal")
    checked = sorted({r.get("checked", "?") for r in cache.values()})
    print(f"databases checked {', '.join(checked) or 'never'}; `ro-mysql --tunnels --refresh` re-checks")
    print("query: ro-mysql --tunnel=<name> -D <db> -e 'SELECT ...'")


def db_users(tunnels: list[Tunnel], logins: dict[str, LoginPath]) -> tuple[dict[str, list[Tunnel]], list[Tunnel]]:
    """Tunnels grouped by DB user, and the tunnels whose user is unknown."""
    users: dict[str, list[Tunnel]] = {}
    unknown: list[Tunnel] = []
    for t in tunnels:
        user = tunnel_user(t, logins)
        if user is None:
            unknown.append(t)
        else:
            users.setdefault(user, []).append(t)
    return users, unknown


def rotate(
    tunnels: list[Tunnel], ask: Callable[[str], str] = getpass.getpass, auth_path: str = AUTH_FAILED
) -> None:
    """Prompt once per tunnel, test the password on that tunnel, store it for that tunnel if accepted."""
    users, unknown = db_users(tunnels, {} if all(t.user for t in tunnels) else login_paths())
    shared = multi_port_aliases(tunnels)
    for alias in sorted(shared):
        print(f"skip {alias}: it has several LocalForwards; give each forward its own alias")
    for t in unknown:
        if t.alias not in shared:
            print(f"skip {t.alias}: add `# ro-mysql: user=<db user>` to its Host block")
    for user, ts in sorted(users.items()):
        for t in ts:
            if t.alias in shared:
                continue
            password = ask(f"{t.name} ({user}) password, blank skips: ")
            if not password:
                continue
            with tunnel_up(t, tunnels) as problem:
                if problem is None:
                    r = attempt(t, Creds(user, password, None), "SELECT 1")
                    problem = None if r.returncode == 0 else last_line(r.stderr)
            account = keychain_account(t, user)
            if problem:
                print(f"  not stored: {problem}")
            elif keychain_set(account, password):
                clear_auth_failure(user, t.alias, auth_path)
                print(f"  ok, stored in the Keychain (service {KEYCHAIN_SERVICE}, account {account})")
            else:
                print(f"  ok, but the Keychain write failed for {account}")


def reopen_tunnel(alias: str) -> None:
    print(f"ro-mysql: 2003 on {alias}; running `ssh -f -N {alias}`, then retrying once", file=sys.stderr)
    err = open_tunnel(alias)
    if err:
        print(f"ro-mysql: {err}", file=sys.stderr)


def run(p: Plan) -> subprocess.CompletedProcess[str]:
    # stdout streams straight through; only stderr is held to spot 2003/1045.
    return run_client(p.cmd, p.env, p.password, stderr=subprocess.PIPE, text=True, errors="replace")


def execute(
    p: Plan, held: Listeners = listeners, reopen: Callable[[str], None] = reopen_tunnel
) -> subprocess.CompletedProcess[str]:
    """Run the plan; on ERROR 2003 re-open its tunnel and re-run once, if that tunnel then holds the port."""
    result = run(p)
    if result.returncode == 0 or "ERROR 2003" not in result.stderr:
        return result
    reopen(p.tunnel.alias)
    # A sibling on a shared port may have taken it meanwhile; the re-run would then read its DB.
    if len(p.port_tunnels) > 1:
        h = holder(p.tunnel.port, p.port_tunnels, held())
        if h != p.tunnel.alias:
            sys.stderr.write(result.stderr)
            die(f"port {p.tunnel.port} is held by {h or 'nothing'}, not {p.tunnel.alias}, after the re-open; not re-running")
    return run(p)


def main() -> None:
    argv = sys.argv[1:]
    if argv[:1] == ["--tunnels"]:
        if argv[1:] not in ([], ["--refresh"]):
            die("usage: ro-mysql --tunnels [--refresh]")
        show_tunnels(load_tunnels(), do_refresh=argv[1:] == ["--refresh"])
        return
    if argv[:1] == ["--rotate"]:
        if argv[1:] or not sys.stdin.isatty():
            die("--rotate prompts for passwords: the user runs it in their own terminal")
        rotate(load_tunnels())
        return
    p = plan(argv)
    print(f"ro-mysql: {p.label}", file=sys.stderr)
    result = execute(p)
    sys.stderr.write(result.stderr)
    if result.returncode == 0:
        clear_auth_failure(p.user, p.tunnel.alias)
    elif "ERROR 1045" in result.stderr and p.user:
        note_auth_failure(p.user, p.tunnel.alias)
        print(f"ro-mysql: {p.user} rejected on {p.tunnel.alias}; the user runs `ro-mysql --rotate` in a terminal", file=sys.stderr)
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
