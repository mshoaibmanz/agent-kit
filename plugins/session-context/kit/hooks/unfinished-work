#!/usr/bin/env bash
# Stop hook: refuse to end the turn while this branch's CI is known-red.
#
# ci-watch already auto-repairs failing runs and notifies on give-up, but a notification is
# easy to miss and (per CLAUDE.md) a working watcher looks identical to an absent one. This
# surfaces a terminal-RED status at the one moment it matters: when the session tries to stop.
#
# Costs no network call. Reads ci-watch's own artifacts:
#   the branch -> PR pointer (lib/state pr_number) -> the open PR for this branch
#   ~/.claude/tmp/ci-watch-<pr>.status             -> that PR's last known CI state
#
# Blocks at most once per (session, PR, HEAD sha, pending|red), and never on a pending status
# while a waiter on the status file is running. The key must not be the status TEXT: ci-watch
# rewrites it with an elapsed counter every 20s, so every Stop saw a "new" status and was
# forced into another turn (123 of them, busy-waiting the model on CI).
#
# Deliberately does not check unresolved PR review threads: that needs a `gh` call on every
# stop, and the address-review skill already covers them on request.
#
# Env: UNFINISHED_WORK_MAX_AGE_MIN (default 720) — ignore a status older than this.
#      UNFINISHED_WORK_OFF=1       — disable entirely.
set -uo pipefail

[ -n "${UNFINISHED_WORK_OFF:-}" ] && exit 0
# The headless repair agent IS the fix attempt — never block its unattended stop.
[ -n "${CI_WATCH_ACTIVE:-}" ] && exit 0

. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0
hook_lib open state
hook_read session_id='.session_id // "unknown"' stop_hook_active='.stop_hook_active // false' \
  cwd='.cwd // ""'
[ -n "$cwd" ] || cwd="$PWD"

# Second Stop in the same chain — let it through, exactly one block per turn.
[ "$stop_hook_active" = "true" ] && exit 0

branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
[ -n "$branch" ] && [ "$branch" != "HEAD" ] || exit 0

prnum=$(pr_number "$branch") || exit 0

statusfile="$HOME/.claude/tmp/ci-watch-${prnum}.status"
[ -f "$statusfile" ] || exit 0

# A stale status describes a run that has long since been superseded or abandoned.
max_age="${UNFINISHED_WORK_MAX_AGE_MIN:-720}"
[ -n "$(find "$statusfile" -mmin "+${max_age}" 2>/dev/null)" ] && exit 0

status=$(tr -d '\n' < "$statusfile" 2>/dev/null)
kind=""
# Terminal non-red states (green, "idle — …", "no '<workflow>' run …") fall through to exit 0.
case "$status" in
  RED*|*"gave up"*|*"needs a human"*) kind=red ;;
  watching*|waiting*|running*|repairing*|"run "*) kind=pending ;;
  *) exit 0 ;;
esac

# The waiter this hook prescribes names the status file on its command line.
[ "$kind" = pending ] && pgrep -f "ci-watch-${prnum}\.status" >/dev/null 2>&1 && exit 0

# One block per (PR, HEAD sha, kind) per session.
sha=$(git -C "$cwd" rev-parse HEAD 2>/dev/null)
seen="${TMPDIR:-/tmp}/claude-unfinished/$session_id"
mkdir -p "$(dirname "$seen")" 2>/dev/null || true
digest=$(printf '%s|%s|%s' "$prnum" "$sha" "$kind" | shasum 2>/dev/null | cut -d' ' -f1)
if [ -n "${digest:-}" ] && [ -f "$seen" ] && grep -qxF "$digest" "$seen" 2>/dev/null; then
  exit 0
fi
[ -n "${digest:-}" ] && printf '%s\n' "$digest" >> "$seen" 2>/dev/null || true

agentlog="${TMPDIR:-/tmp}/ci-watch-${prnum}.agent.log"

if [ "$kind" = pending ]; then
  # Done means GREEN. The session used to stop at "pushed" and the user found out later.
  # The regex must match every terminal status ci-watch writes, or the waiter never returns.
  # `head -1`, not `cat`: context-guard denies re-dumping a file already dumped this session.
  reason="CI on PR #${prnum} (branch ${branch}) is still running: \"${status}\". The task is not done until it is green, so do not stop yet. Run ONE background wait — \`until grep -qE '^(green|RED|idle|no )|gave up' ${statusfile}; do sleep 30; done; head -1 ${statusfile}\` with run_in_background: true — then STOP; the completion notification wakes you. When it fires: green → report the PR URL and the CI result in your final message; RED → fix it (read \`tail -80 ${agentlog}\` for what the repair agent tried), batch fixes into ONE push, and wait again; idle or no run → CI did not run, say why in your final message. Do not poll the file yourself."
else
  reason="CI is RED on PR #${prnum} (branch ${branch}) and ci-watch stopped trying: \"${status}\". Red CI is part of the task you are finishing, not a new one, so do not stop here. (1) Read ${agentlog} (bounded: tail -80) for what the repair agent already tried, so you do not repeat it. (2) Separate YOUR regression from a pre-existing flake by diffing this red run against the BASE commit's run; a failure present on both is pre-existing or infra, and shared test infra is not yours to hack for it. Rerun to tell flaky from deterministic. (3) Fix the cause, run the representative local subset (pick it by who consumes the OUTCOME, not who calls the function), then commit and push. Batch fixes into ONE push. If it is genuinely not yours to fix or you are blocked, say so loudly and explicitly in your final message and name the blocker; then stopping is fine. Do not re-trigger this check in the same turn."
fi

stop_block "$session_id" "$reason"
