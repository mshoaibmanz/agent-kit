#!/usr/bin/env bash
# Stop the same bytes entering context twice.
#
# WHY THIS EXISTS. Measured over 183 sessions / 29 days (11.0B billed input tokens, 97.7% cache
# hit rate, and — the load-bearing fact — ZERO compactions ever). Nothing is evicted, so a token
# that enters at API call i is re-read on every remaining call of the session. Median session is
# 172 calls; the longest are ~1,000. Lifetime cost = tokens x (1 + calls remaining).
#   - `sed -n` alone: 2,577 calls -> 965M lifetime tokens (8.8% of ALL billed input).
#   - Re-dumping a path ALREADY dumped in the same session: 1,156 calls -> 368M (3.35%).
#   - One source file was re-fetched 56x in a single session under four
#     different path spellings; 96M tokens on that one file.
# The `Read` tool's dedupe does not save you here: only 69 of 418 repeat Reads (17%) came back
# shrunk. And auto mode sets bashFirst internally — no settings.json knob, confirmed against the
# binary — which measurably triples the dump:Read ratio (3.54 vs 1.15 in manual sessions). A
# prose rule cannot beat a harness instruction, so the enforcement lives here.
#
# ONE BEHAVIOUR: deny a whole-file dump (cat/bat, unbounded head/tail/sed -n) of a path this
# session already dumped and has not changed since. The bytes are above. PostToolUse records
# what was dumped; PreToolUse checks it. Bounded reads always pass, and so does `# re-dump`.
# Unbounded grep / git diff are not flagged: the harness caps tool output and bash-guards' byte
# cap covers the real dumps, and advisories for them (sent as systemMessage, which only the user
# sees) changed nothing over 1,809 emissions in 30 days.
set -uo pipefail

[ -n "${CI_WATCH_ACTIVE:-}" ] && exit 0

. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0
hook_lib open
# Every dump form below names one of these, first in the raw payload (before jq), then in the
# command itself (a PostToolUse payload also carries the command's output).
hook_input
case "$HOOK_INPUT" in *cat*|*bat*|*head*|*tail*|*sed*) ;; *) exit 0 ;; esac
hook_read event='.hook_event_name // ""' cmd='.tool_input.command // ""' \
  sid='.session_id // "nosession"' cwd='.cwd // ""'
[ -n "$cmd" ] || exit 0
[ -n "$cwd" ] || cwd="$PWD"
case "$cmd" in *cat*|*bat*|*head*|*tail*|*sed*) ;; *) exit 0 ;; esac
hook_lib open cmd-view state

dir="$HOME/.claude/tmp/claude-context/$sid"
mkdir -p "$dir" 2>/dev/null || exit 0
# Sweep stale session dirs at most every 30 min, not on every Bash call (this hook runs twice per call).
if [ -z "$(find "$HOME/.claude/tmp/claude-context/.sweep" -mmin -30 2>/dev/null)" ]; then
  find "$HOME/.claude/tmp/claude-context" -maxdepth 1 -type d -mtime +1 -exec rm -rf {} + 2>/dev/null || true
  touch "$HOME/.claude/tmp/claude-context/.sweep" 2>/dev/null || true
fi

# The bare view: `sed -n 1,40p "$F"` still parses (the placeholder keeps the argument), while a
# path merely NAMED inside a message or a comment is not scanned.
cmd_view "$cmd"

# Operands of the dump verbs only, taken per pipeline segment. Scanning every path-looking
# token in the whole command recorded `b.md` from `cat a.md; wc -l b.md` and FILE from
# `cat > FILE <<EOF` (a write), then denied their first real read — 130 false re-dump denials in
# 30 days. A segment with a `>` redirect is a write, never a dump.
dump_toks=''
while IFS= read -r seg; do
  case "$seg" in *'>'*) continue ;; esac
  set -f; set -- $seg; set +f
  while [ $# -gt 0 ]; do case "$1" in *=*) shift ;; *) break ;; esac; done
  case "${1:-}" in cat|bat|head|tail|sed) shift; dump_toks="$dump_toks $*" ;; esac
done <<EOF
$(printf '%s' "$CMD_BARE" | sed -e 's/&&/\n/g' -e 's/||/\n/g' -e 's/[;|]/\n/g')
EOF

# A WHOLE-FILE dump. `sed -n` and head/tail only count when they are unbounded — an explicit
# address range IS the bounded form this hook's own deny message tells you to use, so denying
# it would leave the model no legal way to read a part it does not have.
# Bounded-ness is STRUCTURE, so it is tested against the raw command — the bare view has masked
# every quoted span, which eats exactly the `'2,40p'` / `'/^## A/,/^## B/p'` argument that makes
# a read bounded.
is_dump=0
printf '%s' "$CMD_BARE" | grep -Eq '(^|[;&|[:space:]])(cat|bat)([[:space:]]|$)' && is_dump=1
# head/tail are bounded by -N, -n N or -c N; bare `head file` is a dump.
if printf '%s' "$CMD_BARE" | grep -Eq '(^|[;&|[:space:]])(head|tail)([[:space:]]|$)'; then
  printf '%s' "$cmd" | grep -Eq '(head|tail)[[:space:]]+-([0-9]+|[nc][[:space:]]*[0-9]+)' || is_dump=1
fi
# sed -n is bounded by an address (a line number or a /pattern/).
if printf '%s' "$CMD_BARE" | grep -Eq '(^|[;&|[:space:]])sed[[:space:]]+-n'; then
  printf '%s' "$cmd" | grep -Eq "sed[[:space:]]+-n[[:space:]]*[\"']?[0-9\$/]" || is_dump=1
fi
# A bound downstream means the output is already small; leave it alone.
printf '%s' "$CMD_BARE" | grep -Eq '\|[[:space:]]*(wc|grep|head|tail|md5|shasum|awk|cut|jq)' && is_dump=0

# Canonicalise every path-looking token so the four spellings of one file collapse to one key.
# This is the whole point: `src/x.py`, `$WT/src/x.py`, `W/src/x.py` and the worktree-absolute
# form were four distinct cache keys for the same bytes.
canon() {
  local p="$1"
  case "$p" in
    /*) ;;
    ~*) p="$HOME${p#\~}" ;;
    *)  p="$cwd/$p" ;;
  esac
  # Resolve the file's real path when it exists; otherwise normalise textually.
  if [ -e "$p" ]; then
    (cd "$(dirname "$p")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "$p")") || printf '%s\n' "$p"
  else
    printf '%s\n' "$p"
  fi
}

cmd_flag re-dump && is_dump=0

# `set -f` around both loops: `$dump_toks` is an unquoted expansion, so bash would GLOB a pattern
# token against the hook's own cwd and record every match as dumped, and the next genuine read of
# one was then denied as a re-dump. Accepted cost: a glob is skipped, so `cat src/*.py` records
# none of its matches. That fails toward a missed dedupe, never toward a false deny; recording
# them correctly needs the glob expanded only as an argument to the dump verb, i.e. a parser.
if [ "$is_dump" = 1 ] && [ "$event" != "PostToolUse" ]; then
  set -f
  for tok in $dump_toks; do
    case "$tok" in
      -*|*'*'*|*'?'*) continue ;;
      */*|*.*) ;;
      *) continue ;;
    esac
    # Only real, non-scratch files. A path that does not exist cannot have been dumped.
    [ -f "$tok" ] || [ -f "$cwd/$tok" ] || continue
    case "$tok" in */private/tmp/*|*/var/folders/*|*scratchpad*) continue ;; esac
    key=$(path_key "$(canon "$tok")")
    if [ -f "$dir/$key" ]; then
      # A file EDITED since the dump has different bytes — re-reading it is not a re-read.
      # Without this the model cannot see its own edits, which is a hard block, not a nudge.
      [ "$tok" -nt "$dir/$key" ] && continue
      [ -f "$cwd/$tok" ] && [ "$cwd/$tok" -nt "$dir/$key" ] && continue
      prev=$(head -1 "$dir/$key" 2>/dev/null)
      deny "Denied: \`$tok\` was already dumped this session$( [ -n "$prev" ] && printf ' (as %s)' "$prev") and is still in context — scroll back. Need a part you lack? \`sed -n '<a>,<b>p'\` or \`grep -n\`. Changed on disk? Use the Read tool, or append \`# re-dump\`."
    fi
  done
  set +f
fi

# --- PostToolUse: record what was dumped ---
if [ "$event" = "PostToolUse" ] && [ "$is_dump" = 1 ]; then
  set -f
  for tok in $dump_toks; do
    case "$tok" in -*|*'*'*|*'?'*) continue ;; */*|*.*) ;; *) continue ;; esac
    [ -f "$tok" ] || [ -f "$cwd/$tok" ] || continue
    case "$tok" in */private/tmp/*|*/var/folders/*|*scratchpad*) continue ;; esac
    printf '%s\n' "$tok" > "$dir/$(path_key "$(canon "$tok")")" 2>/dev/null || true
  done
  set +f
fi
exit 0
