# Per-user overlay: copy to the selected kit root's local/kit.env and fill in.
# ~/.claude/local/kit.env remains a legacy Claude compatibility location. Every key is
# optional; an absent or empty key turns off the check it drives. KEY=value, one per line, the
# value literal (no $VAR expansion, no trailing comment), optionally in one pair of quotes. Only
# these keys are read, and only from the file: an environment variable of the same name is ignored.
# KIT_ENV=<file> points the hooks at another overlay; KIT_ENV=/dev/null runs them with none.

# Commit author the docs tell the agent to use; git config's identity when unset.
GIT_AUTHOR='Your Name <you@example.com>'
# Extra local base branches for the two-dot diff guard (ERE alternation; each alternative must end on a non-dot). origin/*, main and master are always bases.
RELEASE_BRANCH_RE='release-[0-9]+|develop'
# The branch reviews diff against first (review-state), before origin/HEAD, main and master.
REVIEW_BASE=
# A repo with this file at its git root runs tests only through TEST_RUNNER (test-exec-gate, SessionStart TESTS line).
TEST_GATE_FILE=.test-gate
# The one test wrapper allowed in such a repo, shown in messages and allowlisted for the ci-watch repair agent.
TEST_RUNNER=run-tests
# Runner names that count as a test run in command position (ERE; defaults to TEST_RUNNER).
TEST_RUNNER_RE='run-tests(-ci)?'
# Other ways to run tests there, refused ('|'-separated literal command prefixes).
TEST_REFUSED_CMDS='make test'
# One sentence appended to the gate's refusal and the TESTS line, e.g. what each run costs.
TEST_NOTE='Every run pays a fixed setup cost whatever its scope.'
# Extra directory names treated like sandbox/ and prototypes/: no review marker, no comment nudge (ERE alternation).
PROTOTYPE_DIRS=playground
# Space-separated dirs whose children are git repos, for claude-gc's worktree sweeps (a leading ~/ is expanded).
CODE_DIRS=~/src
# Prefer a structured array when a root contains spaces.
CODE_DIRS_JSON=["~/src", "~/work projects"]
# bqro's jobs project (billed for the query) when the call passes no --project_id.
BQRO_PROJECT=my-gcp-project
# The work root: projects/, legacy tasks/ and the retro/ inbox (a leading ~/ is expanded).
AGENT_WORK_ROOT=~/agent-work
# 1 lets Codex's workspace-write sandbox write gcloud's config dir (bq rewrites it on every call).
# It holds credentials, so it is off unless set. Under agent-setup, --codex-gcloud on|off (default
# off) decides it and overrides this line.
CODEX_SANDBOX_GCLOUD=
# Context tokens (input + cache read + cache creation) at which context-watch asks for a handoff
# before auto-compaction; the status line turns red there. Empty means 600000; 0 turns the nudge
# off (the idle-resume cost notice stays).
CONTEXT_HANDOFF_AT=600000
# code-search skill: a Zoekt web server behind browser SSO (unset turns the zoekt backend off).
CODE_SEARCH_ZOEKT_URL=https://code.example.com
# Name of the SSO session cookie that server accepts, read from the local Chrome profile.
CODE_SEARCH_SSO_COOKIE=session
# Default GitHub org/user for gh searches and for short repo names.
CODE_SEARCH_GH_OWNER=my-org
# Chrome profile dir that holds the SSO cookie (chrome://version, Profile Path, last folder).
CODE_SEARCH_CHROME_PROFILE=Default
