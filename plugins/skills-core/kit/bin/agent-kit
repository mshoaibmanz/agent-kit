#!/usr/bin/env python3
"""agent-kit: render host config from the kit in ~/.agents, and report drift.

  render --host claude [--dry-run] [--force-mcp] [--take KEY... | --all]
      settings.json = live file with every kit-owned key merged from
      hosts/claude/settings.base.json + hooks/registry.json, and mcp.json = mcp/servers.json with
      its {"$keychain": {service, account}} references resolved. --take writes the source over the
      named leaves (dotted paths), --all over every drifted leaf.
  adopt <key.path> [--delete]   copy a live settings value into settings.base.json
  doctor               drift per key, MCP drift, broken links, `claude-account check`

Settings merge, per kit-owned leaf (dicts recurse; lists and scalars are leaves):
  live == last rendered  -> write the source value (the kit changed it, or nothing did)
  live == source         -> nothing to do
  absent live, last rendered == source, under hooks or permissions
                         -> restore the source value: the safety guards come back
  otherwise              -> the UI changed it: keep live, report drift until `adopt` or `--take`
Drift under hooks or permissions makes render exit 1. Keys listed in hosts/claude/host.json
"uiOwned" are never read or written. Without a record of the last render every leaf counts as
last rendered == source, so a first render only writes where live already equals the source and
reports the rest as drift. A missing, empty or {} settings.json gets the source as is.

The last render lives in state/rendered/ (gitignored), one file per target path: the kit-owned
settings, and only the sha256 of mcp.json, which holds resolved secrets. Writes are atomic (temp
file in the target's directory, then rename), go through a link to its target, and are skipped
when nothing changed.

Roles (roles.toml, the one source for model and effort per role; see its header):
  roles [--host H] [--format sh|table]   print the roles as a host sees them
  render --host claude also writes
    - ~/.claude/agents/<role>.md from agents/<role>.md, with model: and effort: from the role, for
      every role whose provider is the host's. The directory replaces a link to agents/ in one
      atomic swap (macOS renamex_np RENAME_SWAP), then later renders replace files one by one, so
      no agent is ever missing;
    - settings.json model, effortLevel and modelSettings from [roles.main] (settings.base.json may
      not set them);
    - state/rendered/roles-claude.sh, the review rounds and role table lib/review-state sources.
  Without a roles.toml none of this happens (a synthetic kit, an old checkout).
  agent-body <role> [--host H]   print agents/<role>.md's body filled for H (agent-run's prompt)

Placeholders: agent bodies, host rules (rules/hosts/<host>.md) and installed skill text may hold
{{NAME}}, filled per host by bin/lib/hosts.py fill:
  AGENT_KIT_DIR, KIT_DIR  the kit           SKILLS_DIR  <kit>/skills     OVERLAY_DIR  <kit>/local
  RULES_FILE              the host's instructions file (CLAUDE.md, AGENTS.md, rules/agent-kit.mdc)
  SUBAGENT_RESUME_MAX_K   kit.env SUBAGENT_RESUME_MAX (default 300000) in thousands
An unknown one refuses the render. Claude's CLAUDE.md imports rules/AGENTS.md as is (so it may hold
none) and state/rendered/claude-host-rules.md, the filled rules/hosts/claude.md.
"""

from __future__ import annotations

import argparse
import copy
import ctypes
import difflib
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import tomllib
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

KIT = Path(os.environ.get("AGENT_KIT_DIR", str(Path(__file__).resolve().parent.parent)))
HOST_DIR = KIT / "hosts/claude"
BASE = HOST_DIR / "settings.base.json"
REGISTRY = KIT / "hooks/registry.json"
SERVERS = KIT / "mcp/servers.json"
STATE = KIT / "state/rendered"
ROLES = Path(os.environ.get("AGENT_KIT_ROLES", str(KIT / "roles.toml")))
AGENT_SRC = KIT / "agents"
MISSING = object()
# A leaf here that goes missing live is restored, and drift here fails the render.
GUARDED = ("hooks", "permissions")
# Each provider's own effort scale: Claude Code's --effort and Codex's model_reasoning_effort.
EFFORTS = {
    "anthropic": ("low", "medium", "high", "xhigh", "max"),
    "openai": ("minimal", "low", "medium", "high", "xhigh"),
}
REVIEW_LISTS = ("round1", "later", "once", "sensitive_adds")
# Settings keys [roles.main] renders; settings.base.json may not set them.
ROLE_SETTINGS = ("model", "effortLevel", "modelSettings")
ROLE_NAME = re.compile(r"[a-z][a-z0-9-]*")
# Claude imports rules/AGENTS.md as is, and this filled copy of rules/hosts/claude.md.
CLAUDE_HOST_RULES = STATE / "claude-host-rules.md"


def expand(path: str) -> Path:
    return Path(os.path.expanduser(path))


def load_host() -> dict[str, Any]:
    host = json.loads((HOST_DIR / "host.json").read_text())
    host["settings_path"] = expand(os.environ.get("AGENT_KIT_SETTINGS", host["settings"]))
    host["mcp_path"] = expand(os.environ.get("AGENT_KIT_MCP", host["mcp"]))
    host["agents_path"] = expand(os.environ.get("AGENT_KIT_AGENTS", host.get("agents", "~/.claude/agents")))
    host["settings_state"] = state_name("claude-settings", host["settings_path"])
    host["mcp_state"] = state_name("claude-mcp", host["mcp_path"])
    for kind, legacy in (("settings", "claude-settings.json"), ("mcp", "claude-mcp.sha256")):
        default = expand(host[kind])
        if os.path.realpath(host[f"{kind}_path"]) == os.path.realpath(default):
            migrate_state(legacy, host[f"{kind}_state"])
    return host


def migrate_state(legacy: str, name: str) -> None:
    """State from before it was keyed by target belongs to the host's default target."""
    old, new = STATE / legacy, STATE / name
    if old.exists() and not new.exists():
        os.replace(old, new)


def state_name(kind: str, target: Path, follow: bool = True) -> str:
    """One state file per target, so rendering a second file never rewrites the first's record.
    follow=False keys a target by its own path (its directory resolved), not what it links to: the
    agents directory starts as a link to agents/ and the first render replaces it, so a key through
    the link filed the first manifest where no later render looked, and a role moved off the host
    right after left its old agent file active."""
    real = os.path.realpath(target) if follow else os.path.join(os.path.realpath(target.parent), target.name)
    if sys.platform == "darwin":
        real = real.casefold()
    return f"{kind}.{hashlib.sha256(real.encode()).hexdigest()[:12]}.json"


def dump(obj: Any) -> str:
    return json.dumps(obj, indent=2, ensure_ascii=False) + "\n"


def read_or_empty(path: Path) -> str:
    try:
        return path.read_text()
    except FileNotFoundError:
        return ""


def atomic_write(path: Path, text: str, mode: int | None = None) -> None:
    """Replace path's target in one rename, so readers see the old or the new file, never neither."""
    target = Path(os.path.realpath(path))
    if mode is None:
        mode = target.stat().st_mode & 0o777 if target.exists() else 0o644
    fd, tmp = tempfile.mkstemp(prefix=f".{target.name}.", suffix=".tmp", dir=target.parent)
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, target)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


@dataclass
class Role:
    name: str
    provider: str
    model: str
    effort: str
    prefix: str = ""
    fallback: str = ""
    timeout: int = 900


@dataclass
class Roles:
    roles: dict[str, Role]
    review: dict[str, list[str]]
    hosts: dict[str, dict[str, Any]]

    def provider(self, host: str) -> str:
        spec = self.hosts.get(host)
        if not spec:
            raise SystemExit(f"agent-kit: {ROLES} has no [hosts.{host}]")
        return spec["provider"]

    def host_for(self, provider: str) -> str:
        """The first [hosts.X] in roles.toml whose provider is provider: the host whose CLI runs it."""
        found = next((host for host, spec in self.hosts.items() if spec.get("provider") == provider), None)
        if found is None:
            raise SystemExit(f"agent-kit: {ROLES} has no [hosts.*] with provider {provider}")
        return found

    def invoke(self, role: Role, host: str) -> str:
        """agent: the host spawns it natively; run: bin/agent-run calls the other provider's CLI."""
        if self.hosts.get(host, {}).get("native_agents") is False:
            return "run"
        return "agent" if role.provider == self.provider(host) else "run"


def _role(name: str, spec: Any, bad: list[str]) -> Role | None:
    where = f"[roles.{name}]"
    if not ROLE_NAME.fullmatch(name):
        bad.append(f"{where}: a role name is lowercase letters, digits and dashes")
        return None
    if not isinstance(spec, dict):
        bad.append(f"{where} is not a table")
        return None
    unknown = sorted(set(spec) - {"model", "effort", "prefix", "fallback", "timeout"})
    if unknown:
        bad.append(f"{where}: unknown keys {unknown}")
    model = spec.get("model")
    provider, sep, mid = model.partition(":") if isinstance(model, str) else ("", "", "")
    if not sep or not mid or provider not in EFFORTS or " " in mid:
        bad.append(f'{where}: model must be "<provider>:<model>", provider one of {", ".join(EFFORTS)} (got {model!r})')
        return None
    effort = spec.get("effort")
    if effort not in EFFORTS[provider]:
        bad.append(f"{where}: effort {effort!r} is not on the {provider} scale: {' '.join(EFFORTS[provider])}")
    prefix = spec.get("prefix", "")
    if prefix and not (isinstance(prefix, str) and re.fullmatch(r"[A-Z]{1,3}", prefix)):
        bad.append(f"{where}: prefix is 1-3 capital letters (got {prefix!r})")
    timeout = spec.get("timeout", 900)
    if not isinstance(timeout, int) or isinstance(timeout, bool) or timeout <= 0:
        bad.append(f"{where}: timeout is a positive number of seconds (got {timeout!r})")
    return Role(name, provider, mid, str(effort), prefix or "", spec.get("fallback", "") or "", timeout)


def load_roles(path: Path | None = None) -> Roles | None:
    """roles.toml, validated; None when the kit has none."""
    path = path or ROLES
    if not path.exists():
        return None
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as exc:
        raise SystemExit(f"agent-kit: {path}: {exc}") from None
    bad: list[str] = []
    # A typo'd key used to be read as absent: `round_1` left round 1 empty, and a round of
    # quality-reviewer alone never completed.
    unknown = sorted(set(data) - {"roles", "review", "hosts"})
    if unknown:
        bad.append(f"unknown top-level keys {unknown}: only [roles.*], [review] and [hosts.*]")
    tables = {}
    for key in ("roles", "review", "hosts"):
        tables[key] = data.get(key, {})
        if not isinstance(tables[key], dict):
            bad.append(f"{key} must be a table ([{key}] or [{key}.<name>])")
            tables[key] = {}
    roles = {}
    for name, spec in tables["roles"].items():
        role = _role(name, spec, bad)
        if role:
            roles[name] = role
    if "main" not in roles:
        bad.append("[roles.main] is required: the session's own model and effort")
    main_provider = roles["main"].provider if "main" in roles else ""
    unknown = sorted(set(tables["review"]) - set(REVIEW_LISTS))
    if unknown:
        bad.append(f"[review]: unknown keys {unknown}; the lists are {', '.join(REVIEW_LISTS)}")
    review: dict[str, list[str]] = {}
    for key in REVIEW_LISTS:
        names = tables["review"].get(key, [])
        if not isinstance(names, list) or not all(isinstance(n, str) for n in names):
            bad.append(f"[review] {key} is a list of role names")
            continue
        for n in names:
            if n not in roles:
                bad.append(f"[review] {key} names {n!r}, which has no [roles.{n}]")
            elif not roles[n].prefix:
                bad.append(f"[review] {key}: [roles.{n}] needs a prefix for its finding ids")
        review[key] = names
    # Only a correctness reviewer's return completes a round; a once-per-PR role's never does.
    for key in ("round1", "later"):
        if key in review and not set(review[key]) - set(review.get("once", [])):
            bad.append(f"[review] {key} names no correctness reviewer (a role not in once): its round could never complete")
    seen: dict[str, str] = {}
    for role in roles.values():
        if role.prefix and seen.setdefault(role.prefix, role.name) != role.name:
            bad.append(f"prefix {role.prefix} is used by both {seen[role.prefix]} and {role.name}")
        if role.model == "inherit" and role.name != "main" and role.provider != main_provider:
            bad.append(f"[roles.{role.name}]: {role.provider}:inherit would take main's {main_provider} model")
        if not role.fallback:
            continue
        if role.fallback not in roles:
            bad.append(f"[roles.{role.name}] fallback {role.fallback!r} has no [roles.{role.fallback}]")
        elif role.fallback == role.name or not roles[role.fallback].prefix:
            bad.append(f"[roles.{role.name}] fallback {role.fallback!r} must be another review role (one with a prefix)")
    hosts = tables["hosts"]
    for host, spec in hosts.items():
        if not isinstance(spec, dict) or spec.get("provider") not in EFFORTS:
            bad.append(f"[hosts.{host}] needs provider = one of {', '.join(EFFORTS)}")
    if bad:
        raise SystemExit(f"agent-kit: invalid {path}:\n  " + "\n  ".join(bad))
    return Roles(roles, review, hosts)


def roles_sh(roles: Roles, host: str) -> str:
    """The shell form lib/review-state sources: review lists and one table row per role."""
    rows = [
        " ".join(
            (r.name, r.provider, r.model, r.effort, roles.invoke(r, host), r.prefix or "-",
             r.fallback or "-", str(r.timeout))
        )
        for r in roles.roles.values()
    ]
    lines = [
        f"# Rendered by agent-kit from {ROLES} for host {host}. Edit roles.toml, then render.",
        f"RV_ROLES_HOST={host}",
        f"RV_ROLES_PROVIDER={roles.provider(host)}",
        *(f"RV_{key.upper()}={shlex.quote(' '.join(roles.review.get(key, [])))}" for key in REVIEW_LISTS),
        "# role provider model effort invoke prefix fallback timeout",
        f"RV_ROLE_TABLE={shlex.quote(chr(10).join(rows))}",
    ]
    return "\n".join(lines) + "\n"


def role_settings(roles: Roles, host: str) -> dict[str, Any]:
    """settings.json keys from [roles.main]: Claude Code's model, effort and per-model effort."""
    main = roles.roles["main"]
    out: dict[str, Any] = {}
    if main.model != "inherit":
        out["model"] = main.model
    out["effortLevel"] = main.effort
    models = roles.hosts.get(host, {}).get("effort_models", [])
    out["modelSettings"] = {m: {"effortLevel": main.effort} for m in models}
    return out


def fill_for_host(text: str, kit: str | None = None, host: str = "claude", host_root: str | None = None,
                  what: str = "text", resume: int | None = None) -> str:
    """hosts.fill with this kit as the default kit: an unknown placeholder refuses the render."""
    if "{{" not in text:
        return text  # no lib needed: a synthetic kit without bin/lib renders placeholder-free text
    sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
    from hosts import fill

    return fill(text, kit or str(KIT), host, host_root, what, resume)


def rules_root(host: str) -> str | None:
    """The root whose rules file agent text names: for Claude, that of the CLAUDE.md being rendered
    (AGENT_KIT_RULES, which claude_install_targets fills from an install's record); else
    hosts.host_root_for. None leaves fill on default_host_root."""
    if host == "claude" and os.environ.get("AGENT_KIT_RULES"):
        return str(expand(os.environ["AGENT_KIT_RULES"]).parent)
    lib = Path(__file__).resolve().parent / "lib"
    if not (lib / "hosts.py").is_file():
        return None  # a synthetic kit without bin/lib, as in fill_for_host
    sys.path.insert(0, str(lib))
    from hosts import host_root_for

    root = host_root_for(KIT, host)
    return str(root) if root else None


def render_agent_text(src: str, role: Role, name: str, host: str = "claude", **where: Any) -> str:
    """The source with its placeholders filled for host and the role's model and effort in its
    frontmatter, after `tools:`. where: fill's kit, host_root and resume."""
    if not src.startswith("---\n") or "\n---\n" not in src[3:]:
        raise SystemExit(f"agent-kit: agents/{name}.md has no frontmatter")
    src = fill_for_host(src, host=host, what=f"agents/{name}.md", **where)
    end = src.index("\n---\n", 3)
    fm = [ln for ln in src[4:end].split("\n") if not re.match(r"(model|effort):", ln)]
    pins = ([f"model: {role.model}"] if role.model != "inherit" else []) + [f"effort: {role.effort}"]
    at = next((i + 1 for i, ln in enumerate(fm) if ln.startswith("tools:")), len(fm))
    fm[at:at] = pins
    return "---\n" + "\n".join(fm) + src[end:]


def expected_agents(roles: Roles, host: str, **where: Any) -> dict[str, str]:
    """The host's rendered agent files. Every source needs a role, and every role but main a source
    with frontmatter, on either provider: the body is the role's prompt for an Agent spawn and for
    agent-run alike, and a role left without one was published in the rounds but could not spawn.
    Every source's placeholders must fill for host (where: fill's kit, host_root, resume), rendered
    here or not."""
    out, bad = {}, []
    for src in sorted(AGENT_SRC.glob("*.md")):
        if src.stem not in roles.roles:
            bad.append(f"agents/{src.name} has no [roles.{src.stem}] in {ROLES}")
    for name, role in roles.roles.items():
        src = AGENT_SRC / f"{name}.md"
        if name == "main":
            continue
        if not src.is_file():
            bad.append(f"[roles.{name}] has no agents/{name}.md, its prompt")
            continue
        text = src.read_text()
        if not text.startswith("---\n") or "\n---\n" not in text[3:]:
            bad.append(f"agents/{name}.md has no frontmatter")
        elif roles.invoke(role, host) == "agent":
            out[src.name] = render_agent_text(text, role, name, host, **where)
        else:
            fill_for_host(text, host=host, what=f"agents/{name}.md", **where)
    if bad:
        raise SystemExit("agent-kit: " + "\n  ".join(bad))
    return out


def swap_paths(a: Path, b: Path) -> None:
    """Exchange two paths in one rename: a directory takes a link's place with no gap."""
    libc = ctypes.CDLL(None, use_errno=True)
    if sys.platform == "darwin":
        rc = libc.renamex_np(os.fsencode(a), os.fsencode(b), 0x2)  # RENAME_SWAP
    else:
        rc = libc.renameat2(-100, os.fsencode(a), -100, os.fsencode(b), 0x2)  # AT_FDCWD, RENAME_EXCHANGE
    if rc != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err), str(b))


def render_agents(roles: Roles, host: dict[str, Any], dry_run: bool) -> int:
    target: Path = host["agents_path"]
    want = expected_agents(roles, "claude", host_root=rules_root("claude"))
    state = state_name("claude-agents", target, follow=False)
    if target.is_symlink() or not target.exists():
        what = f"replace the link {target} -> {os.readlink(target)}" if target.is_symlink() else f"create {target}"
        if dry_run:
            print(f"agents: would {what} with {len(want)} rendered file(s): {', '.join(sorted(want))}")
            return 0
        tmp = Path(tempfile.mkdtemp(prefix=f".{target.name}.render-", dir=target.parent))
        try:
            for name, text in want.items():
                (tmp / name).write_text(text)
            os.chmod(tmp, 0o755)
            if target.is_symlink():
                swap_paths(tmp, target)
                os.unlink(tmp)  # the old link, now at the temp name
            else:
                os.rename(tmp, target)
        except BaseException:
            if tmp.is_dir() and not tmp.is_symlink():
                shutil.rmtree(tmp, ignore_errors=True)
            raise
        write_state(state, sorted(want))
        print(f"agents: {what}: {len(want)} rendered file(s)")
        return 0
    before = read_state(state) or []
    changed = [n for n, t in want.items() if read_or_empty(target / n) != t]
    stale = [n for n in before if n not in want and (target / n).exists()]
    if dry_run:
        for n in changed:
            show_diff(read_or_empty(target / n), want[n], n)
        for n in stale:
            print(f"agents: would remove {target / n} (no longer rendered)")
        return 0
    for n in changed:
        atomic_write(target / n, want[n], 0o644)
    for n in stale:
        os.unlink(target / n)
    write_state(state, sorted(want))
    print(f"agents: {target}: {len(changed)} written, {len(stale)} removed, {len(want) - len(changed)} unchanged")
    return 0


def render_roles_sh(roles: Roles, dry_run: bool) -> int:
    path = STATE / "roles-claude.sh"
    text = roles_sh(roles, "claude")
    if read_or_empty(path) == text:
        print(f"roles: {path} unchanged")
    elif dry_run:
        show_diff(read_or_empty(path), text, path.name)
    else:
        STATE.mkdir(parents=True, exist_ok=True)
        atomic_write(path, text, 0o644)
        print(f"roles: wrote {path}")
    return 0


def validate_registry(entries: Any) -> list[dict[str, Any]]:
    """Fail on an entry that would render nowhere or wrongly; a missing hosts list used to drop the
    hook silently."""
    if not isinstance(entries, list):
        raise SystemExit(f"agent-kit: {REGISTRY} must be a JSON list of hook entries")
    bad = []
    for i, entry in enumerate(entries):
        if not isinstance(entry, dict):
            bad.append(f"entry {i}: not an object")
            continue
        label = f"entry {i} ({entry.get('command', '?')})"
        hosts = entry.get("hosts")
        if not isinstance(hosts, list) or not hosts or not all(isinstance(h, str) and h for h in hosts):
            bad.append(f"{label}: needs a non-empty hosts list, e.g. \"hosts\": [\"claude\"]")
        if not isinstance(entry.get("event"), str) or not entry["event"]:
            bad.append(f"{label}: needs an event")
    if bad:
        raise SystemExit(f"agent-kit: invalid {REGISTRY}:\n  " + "\n  ".join(bad))
    return entries


def render_hooks(entries: list[dict[str, Any]], host: str) -> dict[str, Any]:
    """Registry entries grouped by event, then matcher, each in order of first appearance."""
    hooks: dict[str, list[dict[str, Any]]] = {}
    groups: dict[tuple[str, Any], dict[str, Any]] = {}
    for entry in entries:
        if host not in entry["hosts"]:
            continue
        event, matcher = entry["event"], entry.get("matcher")
        group = groups.get((event, matcher))
        if group is None:
            group = {"matcher": matcher, "hooks": []} if matcher is not None else {"hooks": []}
            groups[(event, matcher)] = group
            hooks.setdefault(event, []).append(group)
        hook = {"type": "command"}
        hook.update({k: v for k, v in entry.items() if k not in ("event", "matcher", "hosts")})
        group["hooks"].append(hook)
    return hooks


def source_settings(host: dict[str, Any], components: set[str] | None = None) -> dict[str, Any]:
    selected = components or {"hooks", "roles"}
    base = json.loads(BASE.read_text()) if "hooks" in selected else {}
    clash = sorted(set(base) & set(host["uiOwned"]))
    if clash:
        raise SystemExit(
            f"agent-kit: {BASE} sets UI-owned keys {clash}; remove them or drop them from uiOwned"
        )
    if "hooks" in base:
        raise SystemExit(f"agent-kit: {BASE} has a hooks key; hooks come from {REGISTRY}")
    roles = load_roles() if "roles" in selected else None
    if roles is not None:
        clash = sorted(set(base) & set(ROLE_SETTINGS))
        if clash:
            raise SystemExit(f"agent-kit: {BASE} sets {clash}; they come from {ROLES} [roles.main]")
        for key, value in role_settings(roles, "claude").items():
            if key not in host["uiOwned"]:
                base[key] = value
    if "hooks" in selected:
        base["hooks"] = render_hooks(validate_registry(json.loads(REGISTRY.read_text())), "claude")
    return base


def guarded(key: str) -> bool:
    return key.split(".", 1)[0] in GUARDED


@dataclass
class Drift:
    key: str
    absent: bool


@dataclass
class Plan:
    old_text: str
    new_text: str
    src: dict[str, Any]
    drift: list[Drift] = field(default_factory=list)
    restored: list[str] = field(default_factory=list)
    extra: list[str] = field(default_factory=list)
    first: bool = False


def merge(
    live: dict, last: dict, src: dict, path: str, drift: list[Drift], restored: list[str]
) -> None:
    """Three-way merge of src into live (in place), keeping live's key order."""
    for key in list(dict.fromkeys(list(src) + list(last))):
        s, b, cur = src.get(key, MISSING), last.get(key, MISSING), live.get(key, MISSING)
        where = f"{path}{key}"
        if isinstance(s, dict) and isinstance(cur, dict) and (isinstance(b, dict) or b is MISSING):
            merge(cur, b if isinstance(b, dict) else s, s, where + ".", drift, restored)
            continue
        if cur == s:
            continue
        if cur == b:
            if s is MISSING:
                del live[key]
            else:
                live[key] = copy.deepcopy(s)
            continue
        if cur is MISSING and b == s and guarded(where):
            live[key] = copy.deepcopy(s)
            restored.append(where)
            continue
        drift.append(Drift(where, cur is MISSING))


def lookup(obj: Any, key: str) -> Any:
    for part in key.split("."):
        obj = obj.get(part, MISSING) if isinstance(obj, dict) else MISSING
    return obj


def take(live: dict, src: dict, key: str) -> None:
    """Write the source's value for a dotted key over live's, or delete it where the source has none."""
    value = lookup(src, key)
    parts = key.split(".")
    node = live
    for part in parts[:-1]:
        child = node.get(part)
        if not isinstance(child, dict):
            if value is MISSING:
                return
            child = node[part] = {}
        node = child
    if value is MISSING:
        node.pop(parts[-1], None)
    else:
        node[parts[-1]] = copy.deepcopy(value)


def live_only(live: dict, src: dict, path: str, out: list[str]) -> None:
    for key, cur in live.items():
        s = src.get(key, MISSING)
        if s is MISSING:
            out.append(f"{path}{key}")
        elif isinstance(cur, dict) and isinstance(s, dict):
            live_only(cur, s, f"{path}{key}.", out)


def keychain(service: str, account: str) -> str:
    proc = subprocess.run(
        ["security", "find-generic-password", "-s", service, "-a", account, "-w"],
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        raise SystemExit(f"agent-kit: no Keychain item service={service} account={account}")
    return proc.stdout[:-1] if proc.stdout.endswith("\n") else proc.stdout


def resolve(obj: Any) -> Any:
    if isinstance(obj, dict):
        ref = obj.get("$keychain")
        if ref is not None and len(obj) == 1:
            return keychain(ref["service"], ref["account"])
        return {k: resolve(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [resolve(v) for v in obj]
    return obj


def sha(text: str) -> str:
    return hashlib.sha256(text.encode()).hexdigest()


def read_state(name: str) -> Any:
    path = STATE / name
    return json.loads(path.read_text()) if path.exists() else None


def write_state(name: str, obj: Any) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    atomic_write(STATE / name, dump(obj), 0o600)


def read_live(path: Path) -> tuple[str, dict[str, Any]]:
    text = read_or_empty(path)
    live = json.loads(text) if text.strip() else {}
    if not isinstance(live, dict):
        raise SystemExit(f"agent-kit: {path} is not a JSON object")
    return text, live


def check_take_keys(host: dict[str, Any], keys: list[str], src: dict, live: dict) -> None:
    for key in keys:
        if key.split(".", 1)[0] in host["uiOwned"]:
            raise SystemExit(f"agent-kit: {key} is UI-owned; render never touches it")
        if lookup(src, key) is MISSING and lookup(live, key) is MISSING:
            raise SystemExit(f"agent-kit: {key} is neither in the source nor live")


def plan_settings(
    host: dict[str, Any], take_keys: list[str], take_all: bool, components: set[str] | None = None
) -> Plan:
    old_text, live = read_live(host["settings_path"])
    src = source_settings(host, components)
    plan = Plan(old_text, "", src, first=not live)
    if plan.first:
        plan.new_text = dump(src)
        return plan
    last = read_state(host["settings_state"])
    if last is not None and components is not None:
        last = {
            key: value
            for key, value in last.items()
            if ("roles" if key in ROLE_SETTINGS else "hooks") in components
        }
    owned_live = {k: v for k, v in live.items() if k not in host["uiOwned"]}
    check_take_keys(host, take_keys, src, owned_live)
    for key in take_keys:
        take(owned_live, src, key)
    merge(owned_live, last if last is not None else src, src, "", plan.drift, plan.restored)
    if take_all and plan.drift:
        for d in plan.drift:
            take(owned_live, src, d.key)
        plan.drift = []
        merge(owned_live, last if last is not None else src, src, "", plan.drift, plan.restored)
    new = {}
    for key, value in live.items():
        if key in host["uiOwned"]:
            new[key] = value
        elif key in owned_live:
            new[key] = owned_live[key]
    for key, value in owned_live.items():
        new.setdefault(key, value)
    live_only({k: v for k, v in new.items() if k not in host["uiOwned"]}, src, "", plan.extra)
    plan.new_text = dump(new)
    return plan


def show_diff(old: str, new: str, name: str) -> None:
    sys.stdout.writelines(
        difflib.unified_diff(
            old.splitlines(True), new.splitlines(True), f"live/{name}", f"rendered/{name}"
        )
    )


def report_drift(drift: list[Drift]) -> int:
    for d in drift:
        restore = f"`agent-kit render --host claude --take {d.key}` restores the source"
        if d.key.split(".", 1)[0] == "hooks":
            keep = "hooks change in hooks/registry.json"
        elif d.absent:
            keep = f"`agent-kit adopt {d.key} --delete` drops it from the source"
        else:
            keep = f"`agent-kit adopt {d.key}` keeps live for good"
        label = "settings drift, absent live" if d.absent else "settings drift"
        print(f"{label} (live kept; {restore}, {keep}): {d.key}")
    unsafe = sorted({d.key for d in drift if guarded(d.key)})
    if unsafe:
        print(
            f"agent-kit: hooks/permissions differ from the kit: {', '.join(unsafe)}\n"
            "Restore with `agent-kit render --host claude --take <key>` (or --all).",
            file=sys.stderr,
        )
        return 1
    return 0


def render_settings(
    host: dict[str, Any],
    dry_run: bool,
    take_keys: list[str],
    take_all: bool,
    components: set[str] | None = None,
) -> int:
    path = host["settings_path"]
    for _attempt in range(3):
        plan = plan_settings(host, take_keys, take_all, components)
        json.loads(plan.new_text)
        if plan.new_text == plan.old_text:
            print(f"settings: {path} unchanged")
        elif dry_run:
            show_diff(plan.old_text, plan.new_text, path.name)
        else:
            # Another session may have written between the read and now: plan again from its file.
            if read_or_empty(path) != plan.old_text:
                continue
            atomic_write(path, plan.new_text)
            print(f"settings: wrote {os.path.realpath(path)}")
        if plan.first:
            print(
                f"settings: {path} was missing or empty; {'would write' if dry_run else 'wrote'} the source"
            )
        for key in plan.restored:
            print(f"settings: restored {key} from the source (it was absent live)")
        for key in plan.extra:
            print(f"settings: live-only key, not in the source (kept): {key}")
        if not dry_run:
            previous = read_state(host["settings_state"]) or {}
            kept = {
                key: value
                for key, value in previous.items()
                if components is not None
                and ("roles" if key in ROLE_SETTINGS else "hooks") not in components
            }
            write_state(host["settings_state"], {**kept, **plan.src})
        return report_drift(plan.drift)
    print(f"agent-kit: {path} kept changing under the render; nothing written", file=sys.stderr)
    return 1


def render_mcp(host: dict[str, Any], dry_run: bool, force: bool) -> int:
    path = host["mcp_path"]
    rendered = resolve(json.loads(SERVERS.read_text()))
    new_text = dump(rendered)
    old_text = read_or_empty(path)
    if new_text == old_text:
        print(f"mcp: {path} unchanged ({', '.join(sorted(rendered.get('mcpServers', {})))})")
        if not dry_run:
            write_state(host["mcp_state"], sha(new_text))
        return 0
    new_servers = rendered.get("mcpServers", {})
    old_servers = json.loads(old_text).get("mcpServers", {}) if old_text else {}
    differ = sorted(
        n for n in set(new_servers) | set(old_servers) if new_servers.get(n) != old_servers.get(n)
    )
    print(
        f"mcp: servers that differ from {path}: {', '.join(differ) or 'formatting only'} (values not shown)"
    )
    last = read_state(host["mcp_state"])
    changed_outside = bool(old_text) and (last is None or sha(old_text) != last)
    if changed_outside and not force:
        print(
            f"mcp drift: {path} was changed outside the kit; not overwritten. Move the change into "
            f"{SERVERS}, then `agent-kit render --host claude --force-mcp`",
            file=sys.stderr,
        )
        return 1
    if dry_run:
        return 0
    atomic_write(path, new_text, 0o600)
    write_state(host["mcp_state"], sha(new_text))
    print(f"mcp: wrote {os.path.realpath(path)} (mode 600)")
    return 0


TARGET_ENV = ("AGENT_KIT_SETTINGS", "AGENT_KIT_MCP", "AGENT_KIT_AGENTS")


def installed_kit(kit: Path) -> bool:
    """kit is an installed one: an agent-setup root (it keeps .install-state), or a live source kit
    at ~/.agents, the layout before agent-setup."""
    return (kit / ".install-state/current.json").is_file() or os.path.realpath(kit) == os.path.realpath(Path.home() / ".agents")


def refuse_foreign_kit(dry_run: bool) -> None:
    """KIT defaults to this executable's own kit, so a worktree's bin/agent-kit rendered its unmerged
    sources into live ~/.claude and kept the record in the worktree, which the next live render read
    as drift. A kit that is not installed renders only to targets the environment names, or with
    AGENT_KIT_DIR set, which says the kit was chosen on purpose."""
    if dry_run:
        return
    if (KIT / "rules/hosts/claude.md").exists() and not installed_kit(KIT) and "AGENT_KIT_RULES" not in os.environ:
        raise SystemExit("agent-kit: foreign Claude source requires explicit AGENT_KIT_RULES; nothing written")
    if (KIT / ".install-state/current.json").is_file() and not dry_run:
        claude_install_targets()
    if "AGENT_KIT_DIR" in os.environ:
        return
    if installed_kit(KIT):
        return
    live = [v for v in TARGET_ENV if v not in os.environ]
    if live:
        raise SystemExit(
            f"agent-kit: refused: {KIT} is not the installed kit (an agent-setup root), and {', '.join(live)} unset would render it live.\n"
            f"  Set those to temp targets, or AGENT_KIT_DIR={KIT} to render this kit live on purpose."
        )


def claude_install_targets() -> None:
    """An agent-setup install renders Claude into the root it recorded (CLAUDE_CONFIG_DIR or
    --host-root at setup), not ~/.claude: the targets the environment leaves unset default there."""
    sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
    from hosts import host_root_for

    root = host_root_for(KIT, "claude")
    if root is None:
        if any(name not in os.environ for name in (*TARGET_ENV, "AGENT_KIT_RULES")):
            raise SystemExit("agent-kit: this kit's install has no claude target; rerun agent-setup with "
                             "--hosts claude, or name the targets (AGENT_KIT_SETTINGS and the rest)")
        return
    for name, relative in (("AGENT_KIT_SETTINGS", "settings.json"), ("AGENT_KIT_MCP", "mcp.json"),
                           ("AGENT_KIT_AGENTS", "agents"), ("AGENT_KIT_RULES", "CLAUDE.md")):
        os.environ.setdefault(name, str(root / relative))


def cmd_render(args: argparse.Namespace) -> int:
    if args.host != "claude":
        sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
        from hosts import render

        return render(sys.modules[__name__], args)
    refuse_foreign_kit(args.dry_run)
    components = set(args.components or ("hooks", "rules", "roles", "mcp"))
    rules_plan = (
        plan_claude_rules()
        if "rules" in components and (KIT / "rules/hosts/claude.md").exists()
        else None
    )
    host = load_host()
    roles = load_roles() if "roles" in components else None
    if roles is not None:
        expected_agents(roles, "claude")
    rc = 0
    if components & {"hooks", "roles"}:
        rc = render_settings(host, args.dry_run, args.take or [], args.all, components)
    if "mcp" in components:
        rc = render_mcp(host, args.dry_run, args.force_mcp) or rc
    if roles is not None:
        rc = render_agents(roles, host, args.dry_run) or rc
        rc = render_roles_sh(roles, args.dry_run) or rc
    if rules_plan is not None:
        rc = render_claude_rules(args.dry_run, rules_plan) or rc
    return rc


def claude_host_rules(path: Path | None = None, resume: int | None = None) -> str:
    """rules/hosts/claude.md with its placeholders filled: the file CLAUDE.md imports in its place.
    rules/AGENTS.md is imported as is, so a placeholder there would reach the model literally."""
    if "{{" in read_or_empty(KIT / "rules/AGENTS.md"):
        raise SystemExit(
            "agent-kit: rules/AGENTS.md: Claude imports it unrendered, so it may hold no {{...}} "
            "placeholder; put host-specific text in rules/hosts/<host>.md"
        )
    host_root = str(path.parent) if path else None
    return fill_for_host((KIT / "rules/hosts/claude.md").read_text(), host="claude", host_root=host_root,
                         what="rules/hosts/claude.md", resume=resume)


def plan_claude_rules() -> tuple[Path, str, str, str]:
    """(CLAUDE.md, its new text, its state key, the rendered host rules it imports)."""
    path = expand(os.environ.get("AGENT_KIT_RULES", "~/.claude/CLAUDE.md"))
    host_rules = claude_host_rules(path)
    imports = f"@{KIT}/rules/AGENTS.md\n@{CLAUDE_HOST_RULES}\n"
    return (*plan_claude_imports(path, imports), host_rules)


def plan_claude_imports(path: Path, imports: str) -> tuple[Path, str, str]:
    old = read_or_empty(path)
    state = state_name("claude-rules", path, follow=False)
    last = read_state(state)
    pending_key = state_name("claude-rules-pending", path, follow=False)
    pending = read_state(pending_key) or []
    if isinstance(last, dict):
        last = last.get("imports", "")
    if path.is_symlink():
        if Path(os.path.realpath(path)) not in ((KIT / "rules/AGENTS.md").resolve(), (Path.home() / ".agents/rules/AGENTS.md").resolve()):
            raise SystemExit(f"agent-kit: {path} links to another source; nothing written")
        return path, "<!-- BEGIN agent-kit imports -->\n" + imports + "<!-- END agent-kit imports -->\n", state
    begin, end = "<!-- BEGIN agent-kit imports -->", "<!-- END agent-kit imports -->"
    marked = begin + "\n" + imports + end + "\n"
    if old.count(begin) != old.count(end) or old.count(begin) > 1:
        raise SystemExit(f"agent-kit: {path} has malformed import markers; nothing written")
    if begin in old:
        left, right = old.index(begin), old.index(end) + len(end)
        owned = old[left:right]
        known = [last or "", *pending]
        if not any(begin in previous and owned == previous[previous.index(begin):previous.index(end) + len(end)] for previous in known):
            raise SystemExit(f"agent-kit: {path} has edited managed imports; nothing written")
        return path, old[:left] + begin + "\n" + imports + end + old[right:], state
    if old in ("", imports, last):
        return path, marked, state
    if last and begin not in last:
        old = old.replace(last, "")
    return path, old + ("" if old.endswith("\n") else "\n") + begin + "\n" + imports + end + "\n", state


def render_claude_rules(dry_run: bool, plan: tuple[Path, str, str, str]) -> int:
    path, text, state, host_rules = plan
    # Before CLAUDE.md, so its import never names a file that is not there yet.
    if read_or_empty(CLAUDE_HOST_RULES) != host_rules:
        if dry_run:
            print(f"rules: would write {CLAUDE_HOST_RULES}")
        else:
            CLAUDE_HOST_RULES.parent.mkdir(parents=True, exist_ok=True)
            atomic_write(CLAUDE_HOST_RULES, host_rules, 0o644)
            print(f"rules: wrote {CLAUDE_HOST_RULES}")
    begin, end = "<!-- BEGIN agent-kit imports -->", "<!-- END agent-kit imports -->"
    owned = text[text.index(begin):text.index(end) + len(end)] if begin in text else text
    pending_key = state_name("claude-rules-pending", path, follow=False)
    if not dry_run:
        pending = read_state(pending_key) or []
        if owned not in pending:
            pending.append(owned)
        write_state(pending_key, pending)
    if read_or_empty(path) != text or path.is_symlink():
        if dry_run:
            print(f"rules: would write imports to {path}")
            return 0
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".CLAUDE.", dir=path.parent)
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    if not dry_run:
        begin, end = "<!-- BEGIN agent-kit imports -->", "<!-- END agent-kit imports -->"
        owned = text[text.index(begin):text.index(end) + len(end)] if begin in text else text
        write_state(state, {"imports": owned})
        (STATE / pending_key).unlink(missing_ok=True)
    return 0


def agent_body(name: str, host: str) -> str:
    """agents/<name>.md without its frontmatter, placeholders filled for host: the prompt agent-run
    gives a role's provider CLI."""
    text = (AGENT_SRC / f"{name}.md").read_text()
    if not text.startswith("---\n") or "\n---\n" not in text[3:]:
        raise SystemExit(f"agent-kit: agents/{name}.md has no frontmatter")
    return fill_for_host(text[text.index("\n---\n", 3) + 5 :], host=host, host_root=rules_root(host),
                         what=f"agents/{name}.md")


def cmd_agent_body(args: argparse.Namespace) -> int:
    if not ROLE_NAME.fullmatch(args.role) or not (AGENT_SRC / f"{args.role}.md").is_file():
        raise SystemExit(f"agent-kit: no agents/{args.role}.md")
    host = load_roles().host_for(args.provider) if args.provider else args.host
    sys.stdout.write(agent_body(args.role, host))
    return 0


def cmd_roles(args: argparse.Namespace) -> int:
    roles = load_roles()
    if roles is None:
        raise SystemExit(f"agent-kit: no {ROLES}")
    if args.format == "sh":
        sys.stdout.write(roles_sh(roles, args.host))
        return 0
    for r in roles.roles.values():
        print(f"{r.name:16} {r.provider}:{r.model:18} effort {r.effort:7} {roles.invoke(r, args.host):5}"
              f"{'  prefix ' + r.prefix if r.prefix else ''}{'  fallback ' + r.fallback if r.fallback else ''}")
    for key in REVIEW_LISTS:
        print(f"review.{key}: {' '.join(roles.review.get(key, [])) or '-'}")
    return 0


def cmd_adopt(args: argparse.Namespace) -> int:
    host = load_host()
    parts = args.key.split(".")
    if parts[0] in host["uiOwned"]:
        raise SystemExit(
            f"agent-kit: {parts[0]} is UI-owned; render never touches it, nothing to adopt"
        )
    if parts[0] == "hooks":
        raise SystemExit(
            f"agent-kit: hooks come from {REGISTRY}; edit it there, or restore live with "
            f"`agent-kit render --host claude --take {args.key}`"
        )
    if parts[0] in ROLE_SETTINGS and load_roles() is not None:
        raise SystemExit(f"agent-kit: {parts[0]} comes from {ROLES} [roles.main]; edit it there, then render")
    live = lookup(read_live(host["settings_path"])[1], args.key)
    if live is MISSING and not args.delete:
        raise SystemExit(
            f"agent-kit: {args.key} is absent live. `agent-kit render --host claude --take "
            f"{args.key}` restores it; `agent-kit adopt {args.key} --delete` removes it from {BASE}"
        )
    base = json.loads(BASE.read_text())
    node = base
    for part in parts[:-1]:
        if live is MISSING and not isinstance(node.get(part), dict):
            print(f"adopt: {args.key} is in neither live nor {BASE}; nothing to do")
            return 0
        node = node.setdefault(part, {})
        if not isinstance(node, dict):
            raise SystemExit(f"agent-kit: {args.key}: {part} is not an object in {BASE}")
    if live is MISSING:
        node.pop(parts[-1], None)
        print(f"adopt: {args.key} is absent live; removed from {BASE}")
    else:
        node[parts[-1]] = live
        print(f"adopt: {args.key} copied from live into {BASE}")
    atomic_write(BASE, dump(base))
    return 0


def source_diff(src: Any, live: Any, path: str, out: list[Drift]) -> None:
    """Leaves where live differs from the source; keys only live has are not drift."""
    if isinstance(src, dict) and isinstance(live, dict):
        for key, value in src.items():
            source_diff(value, live.get(key, MISSING), f"{path}{key}.", out)
    elif src != live:
        out.append(Drift(path[:-1], live is MISSING))


def account_dirs() -> list[Path]:
    proc = subprocess.run(
        [str(Path.home() / ".claude/bin/claude-account"), "dirs"],
        capture_output=True,
        text=True,
        check=False,
    )
    dirs = [Path(line) for line in proc.stdout.splitlines() if line.strip()]
    return dirs or [Path.home() / ".claude"]


def broken_links(root: Path) -> list[str]:
    found = []
    for top in [root, root / "skills"]:
        if not top.is_dir():
            continue
        for entry in sorted(top.iterdir()):
            if entry.is_symlink() and not entry.exists():
                found.append(f"{entry} -> {os.readlink(entry)}")
    return found


def cmd_doctor_claude(_args: argparse.Namespace) -> int:
    host = load_host()
    problems = 0
    _text, live = read_live(host["settings_path"])
    if not live:
        print(f"settings: {host['settings_path']} is missing or empty; run `agent-kit render --host claude`")
    src = source_settings(host)
    owned_live = {k: v for k, v in live.items() if k not in host["uiOwned"]}
    diffs: list[Drift] = []
    source_diff(src, owned_live, "", diffs)
    for d in diffs:
        print(f"settings drift: {d.key} ({'absent live' if d.absent else 'source != live'})")
    print(f"settings: {len(diffs)} kit-owned key(s) differ from the source")
    problems += bool(diffs)
    extra: list[str] = []
    live_only(owned_live, src, "", extra)
    for key in extra:
        print(f"settings: live-only key, not in the source (render keeps it): {key}")
    mcp_live = json.loads(host["mcp_path"].read_text()) if host["mcp_path"].exists() else {}
    mcp_src = resolve(json.loads(SERVERS.read_text()))
    mdiff = sorted(
        n
        for n in set(mcp_src.get("mcpServers", {})) | set(mcp_live.get("mcpServers", {}))
        if mcp_src.get("mcpServers", {}).get(n) != mcp_live.get("mcpServers", {}).get(n)
    )
    print(
        f"mcp: {'servers differ from the catalog: ' + ', '.join(mdiff) if mdiff else 'in sync with the catalog'}"
    )
    problems += bool(mdiff)
    roles = load_roles()
    if roles is not None:
        target = host["agents_path"]
        want = expected_agents(roles, "claude", host_root=rules_root("claude"))
        if target.is_symlink():
            print(f"agents: {target} is still a link; run `agent-kit render --host claude`")
            problems += 1
        else:
            off = sorted(n for n, t in want.items() if read_or_empty(target / n) != t)
            for n in off:
                print(f"agents drift: {target / n} differs from agents/{n} + {ROLES.name}")
            problems += bool(off)
        if read_or_empty(STATE / "roles-claude.sh") != roles_sh(roles, "claude"):
            print(f"roles: {STATE / 'roles-claude.sh'} is stale; run `agent-kit render --host claude`")
            problems += 1
    rules_path = expand(os.environ.get("AGENT_KIT_RULES", "~/.claude/CLAUDE.md"))
    if (KIT / "rules/hosts/claude.md").exists() and str(CLAUDE_HOST_RULES) in read_or_empty(rules_path) \
            and read_or_empty(CLAUDE_HOST_RULES) != claude_host_rules(rules_path):
        print(f"rules: {CLAUDE_HOST_RULES} is stale; run `agent-kit render --host claude`")
        problems += 1
    if "AGENT_KIT_DIR" in os.environ:
        print("accounts: not checked (AGENT_KIT_DIR is set, so this is not the installed kit)")
        return 1 if problems else 0
    for root in account_dirs():
        links = broken_links(root)
        for link in links:
            print(f"broken link: {link}")
        problems += bool(links)
    check = subprocess.run(
        [str(Path.home() / ".claude/bin/claude-account"), "check"],
        capture_output=True,
        text=True,
        check=False,
    )
    print(f"claude-account check: rc {check.returncode}")
    if check.returncode != 0:
        sys.stdout.write(check.stdout + check.stderr)
    problems += check.returncode != 0
    return 1 if problems else 0


def cmd_doctor(args: argparse.Namespace) -> int:
    if args.host is None and args.components is None:
        return cmd_doctor_claude(args)
    sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
    from hosts import HOSTS, inventory

    if args.host not in (None, "all", *HOSTS):
        raise SystemExit(f"agent-kit: --host must be one of {', '.join(HOSTS)} or all")
    names = HOSTS if args.host == "all" else (args.host or "claude",)
    results = [
        inventory(
            sys.modules[__name__],
            host,
            Path(args.repo) if args.repo else None,
            set(args.components) if args.components else None,
        )
        for host in names
    ]
    sys.stdout.write(dump(results))
    return int(any(r["errors"] or r["duplicate_hooks"] for r in results))


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="agent-kit", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("render", help="render settings.json and mcp.json for a host")
    r.add_argument("--host", required=True)
    r.add_argument(
        "--components",
        nargs="+",
        choices=("hooks", "rules", "roles", "mcp"),
        help="render only selected components",
    )
    r.add_argument(
        "--dry-run", action="store_true", help="print the settings diff and drift; write nothing"
    )
    r.add_argument(
        "--force-mcp", action="store_true", help="overwrite an mcp.json changed outside the kit"
    )
    take = r.add_mutually_exclusive_group()
    take.add_argument(
        "--take", nargs="+", metavar="KEY", help="write the source over these dotted settings keys"
    )
    take.add_argument(
        "--all", action="store_true", help="write the source over every drifted settings key"
    )
    r.set_defaults(func=cmd_render)
    a = sub.add_parser("adopt", help="copy a live settings value (dotted path) into the source")
    a.add_argument("key")
    a.add_argument(
        "--delete",
        action="store_true",
        help="when the key is absent live, remove it from the source",
    )
    a.set_defaults(func=cmd_adopt)
    d = sub.add_parser("doctor", help="report drift, broken links and claude-account check")
    d.add_argument("--host", help="a host bin/lib/hosts.py HOSTS names, or all")
    d.add_argument("--repo", help="report configured instruction sources for this repository")
    d.add_argument(
        "--components",
        nargs="+",
        choices=("hooks", "rules", "roles", "mcp"),
        help="inspect only selected components",
    )
    d.set_defaults(func=cmd_doctor)
    b = sub.add_parser("agent-body", help="print a role's agent body with its placeholders filled")
    b.add_argument("role")
    b.add_argument("--host", default="claude")
    b.add_argument("--provider", help="fill for the host roles.toml gives this provider (overrides --host)")
    b.set_defaults(func=cmd_agent_body)
    ro = sub.add_parser("roles", help="print roles.toml as a host sees it")
    ro.add_argument("--host", default="claude")
    ro.add_argument("--format", choices=("table", "sh"), default="table")
    ro.set_defaults(func=cmd_roles)
    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
