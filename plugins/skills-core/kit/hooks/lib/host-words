# Host nouns for model-facing hook text, keyed by AGENT_HOST (unset is claude: Claude Code runs the
# hooks without the adapter). hook-io sources this; lib/review-state sources it when hook-io has not
# (bin/agent-run). Defines functions only.

# host_noun <edit|read|search|rules|bg|fixer>: the host's name for a tool, file or habit.
host_noun() {
  case "${AGENT_HOST:-claude}:$1" in
    claude:edit) printf 'Edit/Write' ;;
    codex:edit) printf 'apply_patch' ;;
    *:edit) printf "the editor's file-edit tool" ;;
    claude:read) printf 'Read(file_path=…, offset=…, limit=…)' ;;
    *:read) printf "sed -n '<a>,<b>p' <file>" ;;
    claude:search) printf 'Grep(pattern=…, path=…, -n, -C 2)' ;;
    *:search) printf 'grep -n -C 2 <pattern> <file>' ;;
    claude:rules) printf 'CLAUDE.md' ;;
    codex:rules) printf 'AGENTS.md' ;;
    cursor:rules) printf 'the Cursor rules' ;;
    *:rules) printf 'the agent rules' ;;
    claude:bg) printf 'through Bash with run_in_background: true' ;;
    *:bg) printf 'as a shell command (it runs for minutes; let it finish rather than backgrounding it)' ;;
    claude:fixer) printf 'one subagent_type "engineer"' ;;
    *:fixer) printf 'one engineer agent where your host can delegate' ;;
  esac
}

# host_trailer: the Co-authored-by line naming this host's agent.
host_trailer() {
  case ${AGENT_HOST:-claude} in
    codex) printf 'Co-authored-by: Codex <noreply@openai.com>' ;;
    cursor) printf 'Co-authored-by: Cursor <cursoragent@cursor.com>' ;;
    *) printf 'Co-authored-by: Claude <noreply@anthropic.com>' ;;
  esac
}

# host_can_ask: the host pauses on a PreToolUse `ask`. The adapter turns `ask` into `deny` on Codex
# and Cursor, so text there must not offer a confirmation the user never sees.
host_can_ask() { [ "${AGENT_HOST:-claude}" = claude ]; }
