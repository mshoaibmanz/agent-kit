#!/bin/bash
# Credentials enter only the server's environment, never rendered config or argv.
set +x
set -eu
# The macOS Keychain, else libsecret's secret-tool (Linux), else SENTRY_ACCESS_TOKEN already in the
# environment (an env-var reference in your shell profile).
if [ -x /usr/bin/security ]; then
  SENTRY_ACCESS_TOKEN=$(/usr/bin/security find-generic-password -s agent-kit/mcp/sentry -a sentry -w 2>/dev/null) || {
    echo 'Sentry MCP off: could not access the Keychain item agent-kit/mcp/sentry (missing or denied). Fix: security add-generic-password -s agent-kit/mcp/sentry -a sentry -w (in your own terminal)' >&2
    exit 1
  }
elif command -v secret-tool >/dev/null 2>&1; then
  SENTRY_ACCESS_TOKEN=$(secret-tool lookup service agent-kit/mcp/sentry account sentry 2>/dev/null) || {
    echo 'Sentry MCP off: no secret-tool item service=agent-kit/mcp/sentry account=sentry. Fix: secret-tool store --label=sentry service agent-kit/mcp/sentry account sentry' >&2
    exit 1
  }
elif [ -z "${SENTRY_ACCESS_TOKEN:-}" ]; then
  echo 'Sentry MCP off: no Keychain or secret-tool here, and SENTRY_ACCESS_TOKEN is unset. Fix: export it in your shell profile' >&2
  exit 1
fi
[ -n "$SENTRY_ACCESS_TOKEN" ] || exit 1
command -v npx >/dev/null 2>&1 || {
  echo "Sentry MCP off: npx is missing. Fix: $(sh "${0%/*}/../hooks/lib/install-hint" npx 2>/dev/null || echo 'install Node.js')" >&2
  exit 1
}
export SENTRY_ACCESS_TOKEN
exec npx -y @sentry/mcp-server@0.37.0 "$@"
