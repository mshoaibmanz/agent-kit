#!/usr/bin/env python3
"""Binds a session to a project and keeps project indexes current.

  UserPromptSubmit           unbound, and the prompt or the branch names a ticket: resolve it and
                             bind (exact or one strong match), list the candidates (ambiguous), or
                             create a project of one (no match). Q&A prompts with no ticket never bind.
                             A binding /clear inherited is re-resolved on the first prompt naming a
                             ticket; others are sticky. On a ticket branch, a ticket the prompt only
                             mentions wins on an exact project hit alone; one it asks for ("start on
                             DEMO-300", agent_task.REQUEST_VERB) wins outright.
  PreToolUse(Write)          unbound, and the first durable file lands under the work root: bind to
                             the project or legacy task folder the path is in (silent; no decision).
  PostToolUse(Write|Edit)    a write under projects/<p>/ re-runs `agent-task index <p>`; a bind made
                             by the PreToolUse step injects the slice here.
Never blocks: every path exits 0.
"""

import json
import os
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
try:
    import agent_task as at
except ImportError as e:
    print(json.dumps({"systemMessage": f"project-bind is off: hooks/lib/agent_task.py failed to import ({e}). Restore it: git -C <your kit source checkout> checkout -- hooks/lib"}))
    sys.exit(0)


def git(cwd: str, *args: str) -> str:
    try:
        return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def context(event: str, text: str) -> None:
    print(json.dumps({"hookSpecificOutput": {"hookEventName": event, "additionalContext": text}}))


def on_prompt(p: dict) -> None:
    """Bind an unbound session. A binding inherited across /clear is re-resolved once, on the first
    prompt that names a ticket; any other binding is sticky."""
    sid, cwd = p.get("session_id", ""), p.get("cwd") or os.getcwd()
    if not sid:
        return
    cur = at.bound(sid)
    inherited = bool(cur) and at.bound_inherited(sid)
    if cur and not inherited:
        return
    prompt = p.get("prompt", "") or ""
    branch = git(cwd, "rev-parse", "--abbrev-ref", "HEAD")
    keys = at.tickets_in(prompt, known=True)
    if cur:
        if not keys:
            return
        at.keep_binding(sid)
        if keys == [cur.item]:
            return
    elif not keys and not at.branch_ticket(branch):
        return
    top = git(cwd, "rev-parse", "--show-toplevel")
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    repo = os.path.basename(os.path.dirname(common)) if common else ""
    paths = at.changed_paths(top, "HEAD") if top and at.branch_ticket(branch) else []
    r = at.resolve(prompt, branch=branch, paths=paths, repo=repo)
    was = f" (was {at.where_label(cur)}, kept from before /clear)" if cur else ""
    if r.outcome == "ambiguous":
        names = ", ".join(f"{pr.name}{' (legacy)' if pr.legacy else ''}" for pr, _ in r.candidates)
        item = f"/{r.ticket}" if r.ticket else ""
        still = f" Still bound to {at.where_label(cur)} until then." if cur else ""
        context("UserPromptSubmit", f"PROJECT: this session could belong to {names}. Ask the user once which, then bind: {at.AGENT_TASK} bind <project>{item} --session {sid}.{still}")
        return
    if r.outcome in ("exact", "strong"):
        proj = r.candidates[0][0]
        target = proj.name if proj.legacy else f"{proj.name}/{r.ticket}" if r.ticket else proj.name
        how = f"Bound to {proj.name} ({r.outcome} match{' on ' + r.ticket if r.outcome == 'exact' else ''}){was}; rebind with /bind <project>[/<item>] if wrong."
    else:
        target = r.ticket
        how = f"Bound to a new project of one, {r.ticket}{was}; /bind <project>/{r.ticket} moves it to an existing project."
    if cur and same_place(cur, r, target):
        return
    b = at.bind(sid, target, branch=branch, repo=repo)
    context("UserPromptSubmit", at.slice_text(b, how))


def same_place(cur: "at.Binding", r: "at.Resolution", target: str) -> bool:
    """The re-resolved target is the inherited binding: nothing to say."""
    if r.outcome in ("exact", "strong"):
        proj = r.candidates[0][0]
        if proj.legacy:
            return cur.project.legacy and cur.project.name == proj.name
        return not cur.project.legacy and cur.project.name == proj.name and (not r.ticket or r.ticket == cur.item)
    return bool(r.ticket) and r.ticket == cur.item


def durable_target(path: str) -> str:
    root = os.path.realpath(at.work_root())
    real = os.path.realpath(path)
    if not real.startswith(root + os.sep):
        return ""
    parts = real[len(root) + 1 :].split(os.sep)
    if len(parts) >= 3 and parts[0] == "projects":
        if len(parts) >= 5 and parts[2] == "items":
            return f"{parts[1]}/{parts[3]}"
        return parts[1]
    if len(parts) >= 3 and parts[0] == "tasks":
        return parts[1]
    return ""


def on_pre_write(p: dict) -> None:
    sid = p.get("session_id", "")
    path = (p.get("tool_input") or {}).get("file_path", "")
    if not sid or not path or at.bound(sid):
        return
    target = durable_target(path)
    if not target:
        return
    at.bind(sid, target)
    (at.bind_dir() / f"{sid[:8]}.fresh").touch()


def on_post_write(p: dict) -> None:
    sid = p.get("session_id", "")
    path = (p.get("tool_input") or {}).get("file_path", "")
    root = os.path.realpath(at.work_root())
    real = os.path.realpath(path) if path else ""
    parts = real[len(root) + 1 :].split(os.sep) if real.startswith(root + os.sep) else []
    if len(parts) >= 3 and parts[0] == "projects" and parts[-1] != "INDEX.md":
        at.index(parts[1])
    fresh = at.bind_dir() / f"{sid[:8]}.fresh" if sid else None
    if fresh and fresh.exists():
        fresh.unlink()
        b = at.bound(sid)
        if b:
            context("PostToolUse", at.slice_text(b, f"Bound to {at.where_label(b)} by this write."))


def main() -> None:
    if os.environ.get("CI_WATCH_ACTIVE"):
        return
    try:
        p = json.load(sys.stdin)
    except ValueError:
        return
    ev = p.get("hook_event_name", "")
    if ev == "UserPromptSubmit":
        on_prompt(p)
    elif ev == "PreToolUse" and p.get("tool_name") == "Write":
        on_pre_write(p)
    elif ev == "PostToolUse" and p.get("tool_name") in ("Write", "Edit", "MultiEdit"):
        on_post_write(p)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # an advisory hook never fails the tool call
        print(json.dumps({"systemMessage": f"project-bind error: {type(e).__name__}: {e}"}))
    sys.exit(0)
