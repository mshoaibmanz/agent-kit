#!/bin/bash
# git pre-push hook: the history steps of scripts/scan.sh (the CI leak scan) over what this push adds
# to the remote: its commits and annotated tags. The tree is CI's (scan.sh with no range).
# Enable once per clone through the scripts/pre-push link, which covers every worktree (README, "Develop").
# Denylist sources and format: scripts/leak-check.sh. No list refuses the push;
# AGENT_KIT_LEAK_TERMS=none pushes without that check. History exceptions (.scan-history-allow) never
# apply here. Exit 0 to push, 1 on a finding, 2 when the scan cannot run.
set -uo pipefail
KIT=$(git rev-parse --show-toplevel) || exit 2
remote=${1-} url=${2-}
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per ref; an all-zero sha is a deletion
# (local) or a new ref (remote). The range is the pushed tips minus what the destination has: the remote
# sha of each updated ref and, when a ref is new there, the refs tracked for this remote, but only if
# they were fetched from the URL this push goes to and the destination still advertises their sha
# (a ref fetched before `git remote set-url` can hold another repo's commits). A separate pushurl, a
# push to a bare URL, or an ls-remote that fails gets the whole ancestry of the pushed tips. Never
# --remotes: another remote (a private fork) is not this one.
tips='' known='' new=0
while read -r _ lsha _ rsha; do
  case $lsha in *[!0]*) ;; *) continue ;; esac
  tips="$tips $lsha"
  case $rsha in
    *[!0]*) if git cat-file -e "$rsha^{commit}" 2>/dev/null; then known="$known $rsha"; else new=1; fi ;;
    *) new=1 ;;
  esac
done
[ -n "$tips" ] || exit 0
if [ "$new" = 1 ] && [ "$(git remote get-url "$remote" 2>/dev/null)" = "$url" ] \
  && [ "$(git remote get-url --push "$remote" 2>/dev/null)" = "$url" ]; then
  if advertised=$(GIT_TERMINAL_PROMPT=0 git ls-remote "$url" < /dev/null 2>/dev/null | cut -f1); then
    for sha in $(git for-each-ref --format='%(objectname)' "refs/remotes/$remote/"); do
      if printf '%s\n' "$advertised" | grep -qxF "$sha" && git cat-file -e "$sha^{commit}" 2>/dev/null; then
        known="$known $sha"
      fi
    done
  fi
fi
if [ "${AGENT_KIT_LEAK_TERMS:-}" = none ]; then REQUIRE_LEAK_TERMS=0; else REQUIRE_LEAK_TERMS=1; fi
export REQUIRE_LEAK_TERMS
# shellcheck disable=SC2086 # tips and known are lists of object ids
"$BASH" "$KIT/scripts/scan.sh" -- $tips --not $known
rc=$?
case $rc in
  0) ;;
  1) echo "pre-push: the leak scan found something in what this push adds (above). Fix the unpushed" \
       "commits and push again; --no-verify only moves the failure to CI, after the push is public." >&2 ;;
  *) echo "pre-push: the scan could not run (exit $rc, above)." >&2 ;;
esac
exit "$rc"
