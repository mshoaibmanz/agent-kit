#!/usr/bin/env bash
# Context budget: the handoff nudge before auto-compaction, and the idle-resume cost notice.
# Main session only (a payload with agent_id is a subagent's and is skipped).
#
#   PostToolUse (all tools), Stop
#       context = input + cache creation + cache read of the latest assistant usage in the
#       transcript tail. At CONTEXT_HANDOFF_AT (kit.env; 0 turns it off; unset: hook-io's
#       context_points, from the host's autoCompactWindow) or more,
#       once per session and 100K band: PostToolUse injects additionalContext; Stop blocks once
#       with the same text (deferred while stop_hook_active). The marker
#       <state>/context-watch/<sid> holds the band; its mtime is the nudge time pre-compact reads.
#       It is written only once the nudge or block output exists, so a failed emit (no jq) does
#       not use up the band. Falling back under the threshold (a compaction) re-arms it; a tail
#       with no usage line (ctx 0) is no reading and leaves the marker alone.
#   UserPromptSubmit
#       the last assistant message is over 60 minutes old and the context is over 200K: a
#       systemMessage (the user's eyes only) with what the resume re-writes in cache. Runs even
#       when CONTEXT_HANDOFF_AT=0, which turns off only the nudge.
#
# WHY. Measured over 2026-09-26..10-03: the 8 compactions were all manual at 512-870K, and a
# simulated cut at 600K with a handoff saves about 16% of main-session spend. The host compacts
# COMPACT_RESERVE under autoCompactWindow; the default nudge leaves HANDOFF_ROOM before that for the
# handoff (both in hooks/lib/handoff.py).
#
# COST. This runs on every tool call of every live session, so the common path is builtins plus
# one `cat`, one `tail -c` and one awk (no jq, no Python): a few ms. jq and agent-task run only when
# the nudge fires. An odd payload or an unreadable transcript is a silent 0; the only non-zero exit
# is stop_block's 2 (the reason on stderr) when jq is missing.
[ -n "${CI_WATCH_ACTIVE:-}" ] && exit 0
. "${0%/*}/lib/hook-io" 2>/dev/null || exit 0

# Bounded tail read. At PostToolUse the newest line is usually the assistant's tool_use with its
# usage; parallel tool results can push it back, hence one wider retry (32K costs ~6 ms less
# than 256K on every call; the 1M retry ~30 ms on the rare call that needs it).
TAIL_BYTES=${CONTEXT_WATCH_TAIL:-32768}
TAIL_RETRY=1048576
IDLE_MIN=60
IDLE_CTX=200000
BAND=100000

hook_input
p=$HOOK_INPUT
# A top-level key is unescaped; the same key inside a string value (a Write of JSON) is \"-escaped
# and cannot match, so the first match is the payload's own field.
# field <var> <key>: no subshell, this is the hot path.
field() {
  local re="\"$2\"[[:space:]]*:[[:space:]]*\"([^\"]*)\""
  printf -v "$1" '%s' ''
  [[ $p =~ $re ]] && printf -v "$1" '%s' "${BASH_REMATCH[1]}"
  return 0
}
re='"agent_id"[[:space:]]*:[[:space:]]*"[^"]'
[[ $p =~ $re ]] && exit 0
field event hook_event_name
case $event in PostToolUse|Stop|UserPromptSubmit) ;; *) exit 0 ;; esac
field sid session_id
field tp transcript_path
case $tp in '~/'*) tp="$HOME/${tp#'~/'}" ;; esac
[ -n "$sid" ] && [ -f "$tp" ] && [ -r "$tp" ] || exit 0

context_points
at=$HANDOFF_AT
[ "$at" -gt 0 ] || [ "$event" = UserPromptSubmit ] || exit 0

# ctx ts model of the last main-chain assistant line with a non-zero usage.
AWK='
function num(s, k,   i) { i = index(s, k); return i ? substr(s, i + length(k)) + 0 : 0 }
function str(s, k,   i, r) { i = index(s, k); if (!i) return ""; r = substr(s, i + length(k)); i = index(r, "\""); return i ? substr(r, 1, i - 1) : "" }
index($0, "\"isSidechain\":true") { next }
{ i = index($0, "\"usage\":{"); if (!i) next
  u = substr($0, i, 800); j = index(u, "}"); if (j) u = substr(u, 1, j)
  t = num(u, "\"input_tokens\":") + num(u, "\"cache_creation_input_tokens\":") + num(u, "\"cache_read_input_tokens\":")
  if (t > 0) { ctx = t; ts = str($0, "\"timestamp\":\""); m = str($0, "\"model\":\"") } }
END { printf "%d %s %s\n", ctx, (ts == "" ? "-" : ts), (m == "" ? "-" : m) }'
last=$(tail -c "$TAIL_BYTES" "$tp" 2>/dev/null | LC_ALL=C awk "$AWK" 2>/dev/null)
if [ "${last%% *}" = 0 ] || [ -z "$last" ]; then
  last=$(tail -c "$TAIL_RETRY" "$tp" 2>/dev/null | LC_ALL=C awk "$AWK" 2>/dev/null)
fi
set -f; set -- $last; set +f
ctx=${1:-0} ts=${2:--} model=${3:--}
case $ctx in '' | *[!0-9]*) exit 0 ;; esac
# No usage line in either tail: nothing was read, so this is not "under the threshold" either.
[ "$ctx" -gt 0 ] || exit 0

idle() {
  [ "$ctx" -gt "$IDLE_CTX" ] && [ "$ts" != - ] || exit 0
  local then now age price cents
  then=$(date -j -u -f '%Y-%m-%dT%H:%M:%S' "${ts%%.*}" +%s 2>/dev/null || date -u -d "$ts" +%s 2>/dev/null)
  now=${CONTEXT_WATCH_NOW:-$(date +%s)}
  case $then in '' | *[!0-9]*) exit 0 ;; esac
  age=$(( (now - then) / 60 ))
  [ "$age" -gt "$IDLE_MIN" ] || exit 0
  # The 1h cache-write price per MTok (data/verified-facts.md, 2026-10-03); Opus 5.5 by default.
  case $model in *fable*) price=20 ;; *sonnet*) price=4 ;; *haiku*) price=2 ;; *) price=8 ;; esac
  cents=$(( ctx * price / 10000 ))
  jq -n --arg m "Idle ${age} min at $((ctx / 1000))K context: this resume re-writes about \$$((cents / 100)).$(printf '%02d' $((cents % 100))) of expired cache ($((ctx / 1000))K x \$${price}/MTok). After a long break, /compact or a fresh session from the handoff costs less." \
    '{systemMessage:$m}' 2>/dev/null
  exit 0
}
[ "$event" = UserPromptSubmit ] && idle
[ "$at" -gt 0 ] || exit 0

S="${CLAUDE_STATE_DIR:-$HOME/.claude/state}/context-watch"
m="$S/$sid"
if [ "$ctx" -lt "$at" ]; then
  [ -f "$m" ] && rm -f "$m" 2>/dev/null
  exit 0
fi
band=$(( (ctx - at) / BAND ))
fired=-1
[ -f "$m" ] && read -r fired _ < "$m" 2>/dev/null
case $fired in '' | *[!0-9-]*) fired=-1 ;; esac
[ "$band" -gt "$fired" ] || exit 0
re='"stop_hook_active"[[:space:]]*:[[:space:]]*true'
[ "$event" = Stop ] && [[ $p =~ $re ]] && exit 0

field cwd cwd
text=$("${0%/*}/../bin/agent-task" nudge --session "$sid" --ctx "$ctx" --at "$at" --cwd "${cwd:-$PWD}" 2>/dev/null)
near=.
[ "$COMPACT_AT" -gt 0 ] && near="; auto-compaction follows near $((COMPACT_AT / 1000))K."
[ -n "$text" ] || text="CONTEXT $((ctx / 1000))K: past the $((at / 1000))K handoff point${near} At the next natural break, update your HANDOFF.md (state, next steps, decisions) and INDEX.md, record up to 3 learnings with \`agent-task retro\`, then carry on."
# Output first, then the band marker: a nudge that could not be emitted fires on the next call.
# stop_block exits 0 with JSON, or 2 with the reason on stderr when jq is missing.
rc=0
if [ "$event" = Stop ]; then
  out=$(stop_block "$sid" "$text" 2>&1) || rc=$?
else
  out=$(add_context PostToolUse "$text" 2>/dev/null)
fi
[ -n "$out" ] || exit 0
mkdir -p "$S" 2>/dev/null && printf '%s %s\n' "$band" "$ctx" > "$m" 2>/dev/null
if [ "$rc" = 2 ]; then
  printf '%s\n' "$out" >&2
  exit 2
fi
printf '%s\n' "$out"
exit 0
