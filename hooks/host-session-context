#!/usr/bin/env python3
"""Point native hosts to personal repo policy without claiming project files are suppressed."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
from kit_env import kit_root  # noqa: E402


def main() -> int:
    data = json.load(sys.stdin)
    roots = data.get("workspace_roots") or []
    cwd = data.get("cwd") or (roots[0] if roots else ".")
    proc = subprocess.run(
        ["git", "-C", cwd, "rev-parse", "--git-common-dir"],
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode:
        return 0
    common = Path(cwd) / proc.stdout.strip()
    name = common.resolve().parent.name
    local = kit_root(__file__) / "local"
    docs = [
        str(local / f"{name}-{kind}.md")
        for kind in ("invariants", "rules", "testing")
        if (local / f"{name}-{kind}.md").is_file()
    ]
    context = "Personal repository guidance: " + ", ".join(docs)
    context += ". Read invariants before edits, rules for conventions, testing before tests. Report conflicts with project instructions."
    # The session's project item, the same slice Claude's session-context injects (agent-task
    # binds by worktree or branch here; the prompt-time rules run in project-bind).
    sid = data.get("session_id") or data.get("conversation_id") or os.environ.get("AGENT_SESSION_ID", "")
    if sid:
        kit = kit_root(__file__)
        source = data.get("source") or "startup"
        # A slow or missing agent-task drops only its slice; the repo guidance above still goes out.
        try:
            task = subprocess.run(
                [str(kit / "bin" / "agent-task"), "session-start", "--session", sid, "--source", source if source in ("startup", "resume", "clear", "compact") else "startup", "--cwd", cwd],
                capture_output=True,
                text=True,
                check=False,
                timeout=20,
            )
        except (subprocess.TimeoutExpired, OSError):
            task = None
        if task and task.returncode == 0 and task.stdout.strip():
            context += "\n" + task.stdout.strip()
    sys.stdout.write(
        json.dumps(
            {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}
        )
        + "\n"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
