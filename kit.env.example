# Per-user overlay: copy to ~/.claude/local/kit.env (never committed) and fill in. Every key is
# optional; an absent or empty key turns off the check it drives. KEY=value, one per line, the
# value literal (no $VAR expansion, no trailing comment), optionally in one pair of quotes.
# KIT_ENV=<file> points the hooks at another overlay; KIT_ENV=/dev/null runs them with none.

# Commit author the docs tell the agent to use; git config's identity when unset.
GIT_AUTHOR='Your Name <you@example.com>'
# Extra local base branches for the two-dot diff guard (ERE alternation; each alternative must end on a non-dot). origin/*, main and master are always bases.
RELEASE_BRANCH_RE='release-[0-9]+|develop'
# A repo with this file at its git root runs tests only through TEST_RUNNER (test-exec-gate, SessionStart TESTS line).
TEST_GATE_FILE=.test-gate
# The one test wrapper allowed in such a repo, shown in messages and allowlisted for the ci-watch repair agent.
TEST_RUNNER=run-tests
# Runner names that count as a test run in command position (ERE; defaults to TEST_RUNNER).
TEST_RUNNER_RE='run-tests(-ci)?'
# Other ways to run tests there, refused ('|'-separated literal command prefixes).
TEST_REFUSED_CMDS='make test'
# One sentence appended to the gate's refusal and the TESTS line, e.g. what each run costs.
TEST_NOTE='Every run pays a fixed setup cost whatever its scope.'
# Extra directory names treated like sandbox/ and prototypes/: no review marker, no comment nudge (ERE alternation).
PROTOTYPE_DIRS=playground
# Space-separated dirs whose children are git repos, for claude-gc's worktree sweeps (a leading ~/ is expanded).
CODE_DIRS=~/src
# BigQuery project bqro bills its query jobs to (prod-data plugin). The environment's BQRO_PROJECT, or a
# --project_id flag, overrides it; with none of the three bqro refuses to run.
BQRO_PROJECT=my-billing-project
