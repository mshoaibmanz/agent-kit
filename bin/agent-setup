#!/usr/bin/env python3
"""Preview, install, inspect and roll back selected agent-kit components."""

from __future__ import annotations

import sys

if sys.version_info < (3, 11):
    import os.path
    import subprocess

    try:
        _FIX = subprocess.run(['sh', os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'hooks',
                                                  'lib', 'install-hint'), 'python3'],
                              capture_output=True, universal_newlines=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        _FIX = ''
    sys.exit(f'agent-setup: needs Python 3.11 or newer (this is {sys.version.split()[0]}). '
             f'Fix: {_FIX or "install Python 3.11 or newer"}, then rerun with it.')

