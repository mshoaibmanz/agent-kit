#!/usr/bin/env python3
"""agent-task: projects and work items under the work root (kit.env AGENT_WORK_ROOT, ~/agent-work).

Layout: projects/<p>/{PROJECT.md, INDEX.md, knowledge/, scripts/, data/, items/<TICKET or slug>/
{HANDOFF.md, task.json, briefs/, out/}}. No worktrees under the work root: they live in
<repo>/.claude/worktrees/. A legacy tasks/<name>/ folder is a project of one until migrated.

An item is thin: task.json (ticket, branches, repo, worktrees, PR, status, bound sessions) plus
HANDOFF.md, briefs/, out/ (evidence for its PR) and tmp/ (fixtures, clones, test homes; never
indexed). Reusable scripts and knowledge live at the project level. <work root>/.index.json is a
cache derived from every task.json, rebuilt on each agent-task write; never edit it.

Binding rules (binding.decide), certain ones first: explicit bind; the session's own binding;
a worktree the index maps; a ticket branch mapping to one item; a new <TICKET>-* worktree (creates
the item); a pasted work-root path of one item; a prompt ticket mapping to one existing item; a
ticket only one project lists (the project alone). Otherwise the session stays unbound and is
offered this repo's three most recently touched open items.

  agent-task bind <project>[/<item>] | <TICKET> | <legacy folder> [desc words] [--session id] [--cwd d]
                                (bind <project> picks its sole open item, else lists them)
  agent-task resolve "<prompt>" [--cwd d] [--branch b] [--repo r]   the rule that would bind (JSON)
  agent-task where --path [--session id]        exit 1 when the session is unbound
  agent-task ls [--paths]                       projects, with each item's status and last-touched date
  agent-task index [<project>]                  INDEX.md of a project; with none, rebuild .index.json
  agent-task brief <project>/<item> [--name task]
  agent-task harvest <project>/<item>
  agent-task close <project>/<item> [--pr url] [--promote <tmp file> ...] [--no-promote]
                                offers each script in the item's tmp/ that the project's scripts/
                                lacks for promotion (prompt, or the flags), prints the harvest prompts
                                plus proposed knowledge lines, then status closed
  agent-task retro "<note>" | --stdin [--source model|user|auto] [--tag t] [--session id]
  agent-task retro --pending                    one `<id> <line>` per unprocessed line
  agent-task retro --mark <id> ...              mark those lines (ids from --pending) processed
  agent-task migrate --plan | --bindings [--apply]
  agent-task slice [--session id]               the injected context of a bound session (at most 2KB)
  agent-task session-start --session id --source startup|resume|clear|compact [--repo r] [--branch b] [--cap n]
                                (the OUT DIR's repo: --repo, else CLAUDE_PROJECT_DIR's, else the cwd's)
  agent-task nudge --session id --ctx n --at n [--cwd d]   the context-watch handoff text
  agent-task context-points                     "<handoff default> <compaction point, 0 = unknown>" (hook-io)

--session defaults to AGENT_SESSION_ID; native Codex prefers CODEX_THREAD_ID over an inherited Claude session.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from collections import Counter
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks", "lib"))
import agent_task as at  # noqa: E402
import binding as bd  # noqa: E402
import handoff  # noqa: E402
import retro  # noqa: E402
from kit_env import kit_root  # noqa: E402

os.environ["AGENT_KIT_DIR"] = str(kit_root(__file__))


def die(msg: str) -> None:
    sys.stderr.write(f"agent-task: {msg}\n")
    sys.exit(2)


from session import resolve as session_id  # noqa: E402


def need_sid(sid: str) -> str:
    sid = session_id(sid)
    if not sid:
        die("no session: pass --session <id> or set AGENT_SESSION_ID, CLAUDE_CODE_SESSION_ID or CODEX_THREAD_ID")
    return sid


def place_of(a: argparse.Namespace, cwd: str) -> bd.Place:
    """The checkout at cwd (none for ''), with --branch and --repo overriding what git says."""
    pl = bd.place(cwd) if cwd else bd.Place()
    if a.branch:
        pl.branch = a.branch
    if a.repo:
        pl.repo = a.repo
    return pl


def cmd_bind(a: argparse.Namespace) -> int:
    sid = need_sid(a.session)
    if not a.args:
        die("usage: agent-task bind <project>[/<item>] | <TICKET> [desc words]")
    target, desc = a.args[0], at.slug(" ".join(a.args[1:]))
    m = re.match(r"^([A-Za-z][A-Za-z0-9]*-[0-9]+)-(.+)$", target)
    if m and "/" not in target and not at.find_legacy(target):
        target, desc = m.group(1).upper(), at.slug(f"{m.group(2)} {desc}")
    was = at.bound(sid)
    try:
        b = bd.bind(sid, target, desc=desc, here=place_of(a, a.cwd or os.getcwd()), rule="explicit", pick_item=True)
    except bd.AmbiguousTicket as e:
        die(f"not bound: {e}")
    print(f"Bound session {sid[:8]} to {at.where_label(b)} ({b.folder}). Tab: {b.label}.")
    live = [] if b.item or b.project.legacy else b.project.open_items()
    if live:
        print(f"Bound to the project only: it has {len(live)} open items. Bind one with /bind {b.project.name}/<item>: {', '.join(live[:12])}.")
    print(at.slice_text(b, bd.announce(b, "explicit", was)))
    return 0


def cmd_resolve(a: argparse.Namespace) -> int:
    d = bd.decide(" ".join(a.args), place_of(a, a.cwd))
    print(json.dumps({"rule": d.rule, "target": d.target, "why": d.why, "candidates": d.candidates}))
    return 0


def cmd_where(a: argparse.Namespace) -> int:
    b = at.bound(need_sid(a.session))
    if not b:
        if not a.path:
            print("unbound")
        return 1
    print(b.folder if a.path else f"{at.where_label(b)}\t{b.folder}")
    return 0


def cmd_ls(a: argparse.Namespace) -> int:
    for p in at.projects():
        if p.legacy:
            print(f"tasks/{p.name}  (legacy){'  [handoff]' if (p.path / 'HANDOFF.md').is_file() else ''}")
            continue
        line = f"{p.name}  status={p.meta.get('status', '?')}"
        if a.paths:
            line += f"  repos={','.join(p.listing('repos')) or '-'}  paths={','.join(p.listing('paths')) or '-'}  terms={','.join(p.listing('terms')) or '-'}"
        print(line)
        rows = sorted(((at.touched(d), d) for d in p.items()), key=lambda x: -x[0])
        for t, d in rows:
            print(f"  {p.name}/{d.name}  {at.item_status(d)}  {at.dt.date.fromtimestamp(t).isoformat()}")
    return 0


def cmd_index(a: argparse.Namespace) -> int:
    if not a.args:
        print(f"{len(at.rebuild_index())} items -> {at.work_root() / at.INDEX_FILE}")
        return 0
    f = at.index(a.args[0])
    if not f:
        die(f"no project {a.args[0]}")
    print(f)
    return 0


def split_target(t: str) -> tuple[at.Project, str]:
    name, _, item = t.partition("/")
    pdir = at.project_dir(name)
    if pdir:
        return at.parse_project(pdir), item
    leg = at.find_legacy(name)
    if leg:
        return at.legacy_project(leg), ""
    die(f"no project {name}")
    raise SystemExit


def cmd_brief(a: argparse.Namespace) -> int:
    if not a.args:
        die("usage: agent-task brief <project>/<item> [--name task]")
    p, item = split_target(a.args[0])
    b = at.Binding(p, item)
    if item and not p.legacy:
        at.ensure_item(p, item)
    name = at.slug(a.name or "task")
    f = b.folder / "briefs" / f"brief-{name}.md"
    if f.exists():
        die(f"{f} exists; pass --name")
    text = f"""# Brief: {name}

Work folder: {b.folder} (notes go to briefs/notes-{name}.md, evidence to out/)
Python scripts here or in the scratchpad start with a `# type: ignore` line (no Pyright noise).

## Objective

## Repo and worktree
Repo: ; worktree in <repo>/.claude/worktrees/<name>; expected branch:

## Test command

## Done criteria

## Hand-back
At most 400 words: outcome, files changed, tests run, what is left, and `Learnings:` (at most 3
lines, each tagged mistake, fact, doc or tooling) for `agent-task retro`.

## Project context (injected by agent-task brief)
{at.slice_text(b)}
"""
    at.atomic_write(f, text)
    if not p.legacy:
        at.index(p.name)
    print(f)
    return 0


def cmd_harvest(a: argparse.Namespace) -> int:
    if not a.args:
        die("usage: agent-task harvest <project>/<item>")
    p, item = split_target(a.args[0])
    print(at.harvest(p, item, closing=False, pr=a.pr))
    return 0


def cmd_close(a: argparse.Namespace) -> int:
    """Close an item: offer its tmp/ scripts for promotion, print the harvest prompts (with HANDOFF lines
    proposed for knowledge/), then status closed. Never blocks: the item stays as a closed ledger entry,
    and claude-gc's tmp sweep later salvages what stays in its tmp/."""
    if not a.args or (a.promote and a.no_promote):
        die("usage: agent-task close <project>/<item> [--pr url] [--promote <tmp file> ...] [--no-promote]")
    p, item = split_target(a.args[0])
    if p.legacy or not item:
        die("agent-task close takes <project>/<item>")
    d = at.Binding(p, item).folder
    candidates, _ = at.item_scripts(p, d)
    chosen: list[Path] = []
    if a.promote:
        for name in a.promote:
            match = [f for f in candidates if name in (str(f), str(f.relative_to(d)), str(f.relative_to(d / "tmp")), f.name)]
            if not match:
                die(f"--promote {name}: not a script in {d / 'tmp'} that scripts/ lacks")
            chosen += [f for f in match if f not in chosen]
    elif candidates and not a.no_promote and sys.stdin.isatty():
        for f in candidates:
            answer = input(f"Promote {f.relative_to(d)} to {p.path / 'scripts'}/? [y/N] ").strip().lower()
            if answer in ("y", "yes"):
                chosen.append(f)
    for f in chosen:
        print(at.promote(p, d, f))
    left = [f for f in candidates if f not in chosen]
    if left and not a.no_promote:
        print("Scripts still in tmp/ that scripts/ lacks (claude-gc salvages them to out/salvage/ after the grace period):")
        for f in left:
            print(f"   - {f.relative_to(d)}: {at.describe(f) or '(no docstring)'}")
        print(f"   Promote one with: agent-task close {p.name}/{item} --promote <file>")
    print(at.harvest(p, item, closing=True, pr=a.pr))
    print(f"Closed {p.name}/{item} (status closed; task.json keeps its branch, worktree, PR and sessions).")
    return 0


def cmd_retro(a: argparse.Namespace) -> int:
    if a.pending:
        for f, n, line in retro.retro_pending():
            print(f"{retro.retro_id(f, n, line)} {line}")
        return 0
    if a.mark:
        if not a.args:
            die("usage: agent-task retro --mark <id> ... (the ids --pending printed: only the lines you reviewed)")
        print(f"marked {retro.retro_mark(a.args)} lines processed")
        return 0
    if a.stdin:
        a.args = [sys.stdin.read()]
    if not a.args or not "".join(a.args).strip():
        die('usage: agent-task retro "<note>" | --stdin')
    source = a.source or "model"
    if source not in ("model", "user", "auto"):
        die("--source is model, user or auto")
    sid = session_id(a.session)
    b = at.bound(sid) if sid else None
    print(retro.record_retro(" ".join(a.args), source=source, tag=a.tag, session=sid, where=at.where_label(b)))
    return 0


def cmd_migrate(a: argparse.Namespace) -> int:
    if a.bindings:
        lines = at.migrate_bindings(apply=a.apply)
        print(f"# binding files in {at.bind_dir()} not in `project:p/i` form ({'rewritten' if a.apply else 'dry run; --apply rewrites'}):")
        print("\n".join(lines) or "(none)")
        return 0
    if not a.plan:
        die("only `migrate --plan` and `migrate --bindings` exist: moving folders is the user's call")
    legacy = [p for p in at.projects() if p.legacy]
    toks: dict[str, set[str]] = {}
    generic = {"ticket", "doc", "docs", "repo", "api", "team", "express", "kickoff", "handoff", "index", "plan", "review"}
    for p in legacy:
        # The folder name and the files' titles only: INDEX.md bodies share template text.
        text = p.meta.get("terms", "")
        for name in ("INDEX.md", "HANDOFF.md"):
            f = p.path / name
            if f.is_file():
                text += " " + " ".join(x for x in f.read_text(errors="replace").split("\n")[:3] if x.startswith("# "))
        toks[p.name] = {w[:5] for w in at.words(text) - generic}
    parent = {n: n for n in toks}

    def find(x: str) -> str:
        while parent[x] != x:
            x = parent[x]
        return x

    names = sorted(toks)
    for i, x in enumerate(names):
        for y in names[i + 1 :]:
            small = min(len(toks[x]), len(toks[y]))
            if small and len(toks[x] & toks[y]) / small >= 0.3:
                parent[find(y)] = find(x)
    groups: dict[str, list[str]] = {}
    for n in names:
        groups.setdefault(find(n), []).append(n)
    print("# Proposed grouping (nothing is moved; confirm, then move by hand or ask for a migration)")
    for members in sorted(groups.values(), key=lambda m: (-len(m), m)):
        common = Counter(w for m in members for w in toks[m]).most_common(2)
        label = "-".join(w for w, _ in common) if len(members) > 1 else at.slug(members[0])
        print(f"- {label}: {', '.join(members)}" + ("  (project of one)" if len(members) == 1 else ""))
    print("Per folder: projects/<p>/items/<TICKET>/ gets HANDOFF.md, briefs/, out/; reusable scripts and data go to projects/<p>/scripts|data; worktrees/ stay out (move them to <repo>/.claude/worktrees/).")
    return 0


def cmd_slice(a: argparse.Namespace) -> int:
    b = at.bound(need_sid(a.session))
    if not b:
        return 1
    print(at.slice_text(b, cap=at.SLICE_CAP - 1))
    return 0


def cmd_session_start(a: argparse.Namespace) -> int:
    """SessionStart (session-context): the slice of a bound session, inheriting the tab's binding
    on /clear; else the path the per-session folder gets on first write (never created here).
    startup and resume point the tab's binding at this session's (an unbound one blanks it)."""
    sid = need_sid(a.session)
    b = at.bound(sid)
    cwd = a.cwd or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    if a.source == "compact":
        cap = min(at.CONTEXT_CAP, max(a.cap, 1500)) if a.cap else at.CONTEXT_CAP
        print(handoff.compact_text(sid, cwd, a.repo, a.branch, cap))
        return 0
    cap = min(at.SLICE_CAP, max(a.cap, 1000)) if a.cap else at.SLICE_CAP
    how = ""
    if a.source in ("startup", "resume"):
        at.set_tab(sid, b)
    if b:
        how = bd.announce(b, "session")
    if not b and a.source == "clear":
        b = at.tab_binding()
        if b:
            at.write_binding(sid, b, inherited=True, rule="tab")
            how = bd.announce(b, "tab") + f" Kept this tab's binding across /clear; a prompt naming another ticket rebinds."
    pl = place_of(a, cwd)
    if not b:
        d = bd.decide("", pl, cheap_only=True)
        if d:
            b = bd.bind(sid, d.target, here=pl, rule=d.rule)
            how = bd.announce(b, d.rule)
    if b:
        at.set_binding_wt(sid, pl.top)
        print(at.slice_text(b, how, cap=cap))
        return 0
    print(handoff.unbound_text(handoff.handoff_folder(sid, cwd, a.repo)[1], a.branch))
    offer = bd.offer_text(bd.Decision(candidates=bd.recent_items(pl.repo)), sid, lead=f"Recent open items for {pl.repo}.")
    if offer:
        print(offer)
    return 0


def cmd_nudge(a: argparse.Namespace) -> int:
    """hooks/context-watch: the text of the handoff nudge at the context threshold."""
    at = a.at if a.at is not None else handoff.handoff_default()
    print(handoff.nudge_text(need_sid(a.session), a.ctx, at, a.cwd or os.getcwd()))
    return 0


def cmd_context_points(_a: argparse.Namespace) -> int:
    """hook-io's context_points: "<handoff default> <compaction point, 0 when unknown>"."""
    print(handoff.handoff_default(), handoff.compact_at() or 0)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="agent-task", add_help=False)
    ap.add_argument("sub", nargs="?")
    ap.add_argument("args", nargs="*")
    ap.add_argument("--session", default="")
    ap.add_argument("--branch", default="")
    ap.add_argument("--repo", default="")
    ap.add_argument("--cwd", default="")
    ap.add_argument("--paths", nargs="*", default=None)
    ap.add_argument("--path", action="store_true")
    ap.add_argument("--name", default="")
    ap.add_argument("--source", default="")
    ap.add_argument("--tag", default="")
    ap.add_argument("--cap", type=int, default=0)
    ap.add_argument("--ctx", type=int, default=0)
    ap.add_argument("--at", type=int, default=None)
    ap.add_argument("--pending", action="store_true")
    ap.add_argument("--mark", action="store_true")
    ap.add_argument("--stdin", action="store_true")
    ap.add_argument("--plan", action="store_true")
    ap.add_argument("--bindings", action="store_true")
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--pr", default="")
    ap.add_argument("--promote", action="append", default=[])
    ap.add_argument("--no-promote", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_intermixed_args()
    if a.sub == "ls" and a.paths is not None:
        a.paths = True
    cmds = {"bind": cmd_bind, "resolve": cmd_resolve, "where": cmd_where, "ls": cmd_ls, "index": cmd_index, "brief": cmd_brief, "harvest": cmd_harvest, "close": cmd_close, "retro": cmd_retro, "migrate": cmd_migrate, "slice": cmd_slice, "session-start": cmd_session_start, "nudge": cmd_nudge, "context-points": cmd_context_points}
    if a.help or a.sub not in cmds:
        print(__doc__)
        return 0 if a.help or not a.sub else 2
    return cmds[a.sub](a)


if __name__ == "__main__":
    sys.exit(main())
